Cell["\<\
All distances between the mirror and inverse rule sets are zero; that is, \
they are equivalent with respect to the eigenvalues of the transition matrix \
in a state space of size 4.\
\>", "Text",
 CellChangeTimes->{{3.993011678723044*^9, 3.993011706447451*^9}, {
  3.993011751615541*^9, 3.993011796491852*^9}, {3.993011831796027*^9, 
  3.9930118535197973`*^9}},ExpressionUUID->"0ae1631e-5063-454a-a928-\
3f622c08c8c5"]
}, Open  ]],


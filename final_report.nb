Cell["\<\
Podemos aplicar distancia coseno y obtener una medida de similitud entre \
diferentes reglas. El plot de abajo muestra la relaci\[OAcute]n entre las 256 \
reglas de ECA. \
\>", "Text",
 CellChangeTimes->{{3.995732165679006*^9, 3.995732179989334*^9}, {
  3.9957322717425737`*^9, 3.995732278607806*^9}, {3.995732374776539*^9, 
  3.995732391177082*^9}},ExpressionUUID->"9bca416d-215a-4182-9e27-\
c935d25e8d2f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ecaGraphs", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"MakeGraph", "[", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"i", ",", "2", ",", "3"}], "]"}], ",", "5"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "255", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distances", "=", 
   RowBox[{"1", "-", 
    RowBox[{"DistanceMatrix", "[", 
     RowBox[{"ecaGraphs", ",", 
      RowBox[{"DistanceFunction", "->", "EigenvaluesGraphDistance"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"distances", ",", 
   RowBox[{"ColorFunction", "->", "\"\<CMYKColors\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.995373733375239*^9, 3.995373782236117*^9}, {

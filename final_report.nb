     RowBox[{"{", 
      RowBox[{"vector", ",", "pos", ",", "rule", ",", "newpos"}], "}"}], ",", 
     
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ca", "[", 

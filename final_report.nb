   RowBox[{"addData", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"getRules", "[", 
       RowBox[{"2", ",", "1"}], "]"}], ",", 
      RowBox[{"getRules", "[", 

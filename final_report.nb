Cell["\<\
Es por esto que se utiliza un nuevo metodo, que en lugar de calcular \
directamente los eigenvalues, realiza un conteo de ciclos en diferentes \
periodos\
\>", "Text",
 CellChangeTimes->{{3.995745177474807*^9, 
  3.9957452104237003`*^9}},ExpressionUUID->"318a0aa3-ff94-455a-b3ec-\
b88c2e58eb53"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Spectral Moments", "Section",
 CellChangeTimes->{{3.99572653128727*^9, 3.995726542343225*^9}, {
   3.995731518738325*^9, 3.995731520986095*^9}, 3.9957451746068563`*^9, 
   3.9957453245170727`*^9},ExpressionUUID->"de98e213-bec7-4a8c-900c-\
3a3443542488"],

Cell[TextData[{
 "En lugar de comparar todo el espectro, comparamos un numero fijo de \
espectros.\nEvolucionamos la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["j", "TI"], TraditionalForm], "errors" -> {}, "input" -> "j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc6f862d-8827-40d2-a816-e12a3f7fd7b3"],
 " pasos en todas las posibles configuraciones y definimos la \
fracci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "m_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dcc627dd-4650-4b52-8d13-1ef811e76bc5"],
 " como la proporcion de configuraciones que regresaron a su configuraci\
\[OAcute]n inicial en ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["j", "TI"], TraditionalForm], "errors" -> {}, "input" -> "j",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "edb3cd1d-922d-4528-9ade-e5860d796f8e"],
 " pasos."
}], "Text",
 CellChangeTimes->{{3.995745332234211*^9, 
  3.9957454233798943`*^9}},ExpressionUUID->"cc5a7ca9-f4da-4538-927d-\
56928a37dfa4"],

Cell[TextData[{
 "Por ejemplo, tomando la regla 30 con 5 espacios, si la evolucionamos un \
paso (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "j= 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5045fc79-484d-410a-b017-439950c5fa2f"],
 ") solo existen 3 nodos que se llaman a su mismo (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], "1"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m_1=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "896bdeba-2c77-409f-a3e6-d941676d8fbd"],
 "), esto mismo pasa cuando evolucionamos 2, 3, 4, etc. Pero cuando \
evolucionamos 8 veces, vemos que 11 configuraciones regresaron a su \
configuraci\[OAcute]n inicial (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], "8"], "\[LongEqual]", "11"}], TraditionalForm],
      "errors" -> {}, "input" -> "m_8 = 11", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c282f167-3fbd-4fc2-a880-98c828a597ac"],
 ")."
}], "Text",
 CellChangeTimes->{{3.995745450955543*^9, 3.9957455192214317`*^9}, {
  3.9957455647499743`*^9, 
  3.995745607228106*^9}},ExpressionUUID->"416af427-0af3-46f8-b193-\
a24dbd7f76cb"],


           RowBox[{
            RowBox[{
             RowBox[{"ca", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", 
             RowBox[{"ca", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "-", "1"}], ",", "0", ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 

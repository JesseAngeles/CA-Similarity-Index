Cell[BoxData[
 RowBox[{
  RowBox[{"DeleteNeighbor", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r", ",", "s", ",", "n", ",", "rv", ",", "tuples", ",", "ruleIdx", ",", 
      "indepQ", ",", "ip", ",", "relPos", ",", "nRed", ",", "redRV"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", 
     RowBox[{"s", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "==", "1"}], ",", 
       RowBox[{
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rv", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"r", ",", "s", ",", 
        RowBox[{"s", "^", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tuples", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", "s", ",", "n"}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "^", "n"}], "-", "1"}], ",", "0", ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ruleIdx", "[", "inp_", "]"}], ":=", 
      RowBox[{
       RowBox[{"s", "^", "n"}], "-", 
       RowBox[{"FromDigits", "[", 
        RowBox[{"inp", ",", "s"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indepQ", "[", "pos_", "]"}], ":=", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"tuples", ",", 
        RowBox[{"Function", "[", 
         RowBox[{"inp", ",", 
          RowBox[{"SameQ", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"rv", "[", 
              RowBox[{"[", 
               RowBox[{"ruleIdx", "[", 
                RowBox[{"ReplacePart", "[", 
                 RowBox[{"inp", ",", 
                  RowBox[{"pos", "->", "v"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"v", ",", "0", ",", 
               RowBox[{"s", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", "indepQ"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "ip", "]"}], "==", "0"}], ",", "Null", ",", 
       RowBox[{
        RowBox[{"relPos", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ip", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"solo", " ", "elimina", " ", "1", " ", "posici\[OAcute]n"}], 
         "*)"}], 
        RowBox[{"nRed", "=", 
         RowBox[{"n", "-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"redRV", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"rv", "[", 
            RowBox[{"[", 
             RowBox[{"ruleIdx", "[", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", "n"}], "]"}], ",", 
                RowBox[{"Thread", "[", 

         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 

Cell[BoxData[
 RowBox[{
  RowBox[{"SpectralMoments", "[", 
   RowBox[{"g_Graph", ",", "kmax_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "index", ",", "succ", ",", "f", ",", "n", ",", "indeg", ",",
       "resto", ",", "queue", ",", "qi", ",", "v", ",", "visited", ",", 
      "cycles"}], "}"}], ",", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"VertexList", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"index", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"verts", ",", 
        RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"succ", "=", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "->", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", 
        RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"f", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"index", "[", 
         RowBox[{"succ", "[", "v", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "verts"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"indeg", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"indeg", "[", 
         RowBox[{"[", 
          RowBox[{"f", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "++"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"resto", "=", "indeg"}], ";", "\[IndentingNewLine]", 
     RowBox[{"queue", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{"resto", ",", "0"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qi", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"qi", "<=", 
        RowBox[{"Length", "[", "queue", "]"}]}], ",", 
       RowBox[{
        RowBox[{"v", "=", 
         RowBox[{"queue", "[", 
          RowBox[{"[", 
           RowBox[{"qi", "++"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"resto", "[", 
             RowBox[{"[", 
              RowBox[{"f", "[", 
               RowBox[{"[", "v", "]"}], "]"}], "]"}], "]"}]}], "==", "0"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"queue", ",", 
            RowBox[{"f", "[", 
             RowBox[{"[", "v", "]"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"visited", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cycles", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"resto", "[", 
            RowBox[{"[", "v", "]"}], "]"}], ">", "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{"visited", "[", 
            RowBox[{"[", "v", "]"}], "]"}]}]}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", "=", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"w", "=", "v"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"visited", "[", 
                RowBox[{"[", "w", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"visited", "[", 
                 RowBox[{"[", "w", "]"}], "]"}], "=", "True"}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"c", ",", "w"}], "]"}], ";", 
               RowBox[{"w", "=", 
                RowBox[{"f", "[", 
                 RowBox[{"[", "w", "]"}], "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"cycles", ",", 
              RowBox[{"Length", "[", "c", "]"}]}], "]"}]}]}], "]"}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"cycles", ",", 
            RowBox[{
             RowBox[{"Divisible", "[", 
              RowBox[{"j", ",", "#"}], "]"}], "&"}]}], "]"}], "]"}], "/", 
         "n"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "kmax"}], "}"}]}], "]"}]}]}], 
   "]"}]}]], "Input",

Cell[TextData[{
 "En el siguiente plot se muestran los vectores de regla de los \
comportamientos unicos. Podemos observar, que las reglas con ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1fde51cd-7ca7-4828-85e4-cf4af8ecd3cd"],
 " estados, son un subconjunto de las reglas con ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "+", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "i + 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb03268a-3133-4cb3-ba60-9c7f335e64a6"],
 " estados donde el nuevo estado tiene una transici\[OAcute]n a 0"
}], "Text",
 CellChangeTimes->{{3.994213420755282*^9, 3.994213441857233*^9}, {
  3.99421348087444*^9, 3.9942134990494204`*^9}, {3.994213563814416*^9, 
  3.994213647818551*^9}},ExpressionUUID->"fbcde7c8-63fb-49fa-83df-\
98305944e335"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"burs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", "i"}], "]"}], ",", "i"}], "]"}], "&"}], "/@", 
      RowBox[{"urs", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", ";;", ",", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "urs", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cell", "=", "10"}], ",", 
     RowBox[{"maxRows", "=", "50"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nrows", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"maxRows", ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "#", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ncols", "=", 
             RowBox[{
              RowBox[{"Dimensions", "[", "#", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"ArrayPlot", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", 
               RowBox[{"UpTo", "[", "maxRows", "]"}]}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ColorRules", "->", 
             RowBox[{"colorRules", "[", "5", "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Mesh", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MeshStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", 
               RowBox[{"AbsoluteThickness", "[", "0.75", "]"}]}], "]"}]}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"PlotRangePadding", "->", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ImagePadding", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cell", "*", 
                  RowBox[{"(", 
                   RowBox[{"maxRows", "-", "nrows"}], ")"}]}], ",", "0"}], 
                "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"cell", "*", "ncols"}], ",", 
               RowBox[{"cell", "*", "maxRows"}]}], "}"}]}]}], "]"}]}], "]"}], 
        "&"}], "/@", "burs"}], "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"Spacings", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.994211411286166*^9, 3.994211411487257*^9}, {

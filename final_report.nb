Cell["\<\
Obtenemos la forma canonica de las reglas de ECA en diferentes \
tama\[NTilde]os, para encontrar las relaciones.\
\>", "Text",
 CellChangeTimes->{{3.995743133216484*^9, 3.995743188702277*^9}, {
  3.995743317784449*^9, 
  3.9957433202566137`*^9}},ExpressionUUID->"8e4b4a86-fce9-4ff6-9a58-\
56379c0b1e95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "cfs", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cfs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"CanonFuncGraph", "[", 
              RowBox[{"MakeGraph", "[", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"#", ",", "2", ",", "3"}], "]"}], ",", "i"}], "]"}], 
              "]"}]}], "}"}], "&"}], "/@", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "255"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Values", "[", 
          RowBox[{"GroupBy", "[", 
           RowBox[{"cfs", ",", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "1"}], "]"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "12", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995743325626771*^9, 3.9957433712575274`*^9}, {
  3.9957434033932533`*^9, 3.9957434562524137`*^9}, {3.995743571509761*^9, 
  3.995743732776075*^9}},
 CellLabel->
  "In[238]:=",ExpressionUUID->"10b89656-c735-4396-b5ba-96bbec154279"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Labeled", "[", 
      RowBox[{"#", ",", "#"}], "]"}], "&"}], "/@", 
    RowBox[{"Length", "/@", "groups"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<space size\>\"", ",", " ", "\"\<behaviours\>\""}], "}"}]}], 

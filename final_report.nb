         RowBox[{"Length", "[", 
          RowBox[{"DeleteDuplicates", "[", "momVecs", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"kmax", ",", "stepsRange"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "spaceSizes"}], "}"}]}], "]"}]}]}]], "Input",

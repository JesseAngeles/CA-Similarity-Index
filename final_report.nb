Cell[TextData[{
 "ya que la reglas  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["21", 
        RowBox[{"4", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "21_{4,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "953fc013-b007-4227-adcd-95dc364a250e"],
 " ni ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["13", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "13_{3,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c8240c5-07ff-4657-8741-bba6ad061816"],
 " no pertenencen a la lista de comportamientos unicos. Pero podemos \
encontrar la similitud con la permutaci\[OAcute]n de estados y navegar en el \
grafo de conexiones, tal como se muestra a conitnuacip\[OAcute]n:"
}], "Text",
 CellChangeTimes->{{3.994214125865473*^9, 
  3.994214181002945*^9}},ExpressionUUID->"a16ded96-836a-4c68-afec-\
65766778c2b0"],


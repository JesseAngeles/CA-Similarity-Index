Cell[BoxData[
 RowBox[{
  RowBox[{"CanonFuncGraph", "[", "g_Graph", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "verts", ",", "index", ",", "f", ",", "n", ",", "indeg", ",", "preds", ",",
       "code", ",", "queue", ",", "visited", ",", "cycles", ",", "succ"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"verts", "=", 
      RowBox[{"VertexList", "[", "g", "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "verts", "]"}]}], ";", 
     RowBox[{"index", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"verts", ",", 
        RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";", 
     RowBox[{"succ", "=", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Rule]", 
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
          "&"}], ")"}], "/@", 
        RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], ";", 
     RowBox[{"f", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"index", "[", 
         RowBox[{"succ", "[", "v", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "verts"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"indeg", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "n"}], "]"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"indeg", "\[LeftDoubleBracket]", 
         RowBox[{"f", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
         "\[RightDoubleBracket]"}], "++"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
     RowBox[{"preds", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "n"}], "]"}]}], ";", 
     RowBox[{"code", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"Null", ",", "n"}], "]"}]}], ";", 
     RowBox[{"queue", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"indeg", ",", "0"}], "]"}], "]"}]}], ";", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"queue", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "=", 
           RowBox[{"First", "[", "queue", "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"queue", "=", 
           RowBox[{"Rest", "[", "queue", "]"}]}], ";", 
          RowBox[{
           RowBox[{
           "code", "\[LeftDoubleBracket]", "v", "\[RightDoubleBracket]"}], "=", 
           RowBox[{"{", 
            RowBox[{"Sort", "[", 
             RowBox[{
             "preds", "\[LeftDoubleBracket]", "v", "\[RightDoubleBracket]"}], 
             "]"}], "}"}]}], ";", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w", "=", 
              RowBox[{
              "f", "\[LeftDoubleBracket]", "v", "\[RightDoubleBracket]"}]}], 
             "}"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{
               "preds", "\[LeftDoubleBracket]", "w", 
                "\[RightDoubleBracket]"}], ",", 
               RowBox[{
               "code", "\[LeftDoubleBracket]", "v", 
                "\[RightDoubleBracket]"}]}], "]"}], ";", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"--", 
                 RowBox[{
                 "indeg", "\[LeftDoubleBracket]", "w", 
                  "\[RightDoubleBracket]"}]}], "\[Equal]", "0"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"queue", ",", "w"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], "]"}], ";", 
     RowBox[{"visited", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", "n"}], "]"}]}], ";", 
     RowBox[{"cycles", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "indeg", "\[LeftDoubleBracket]", "v", "\[RightDoubleBracket]"}], ">",
            "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{
           "visited", "\[LeftDoubleBracket]", "v", 
            "\[RightDoubleBracket]"}]}]}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", "=", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"w", "=", "v"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{
               "visited", "\[LeftDoubleBracket]", "w", 
                "\[RightDoubleBracket]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                "visited", "\[LeftDoubleBracket]", "w", 
                 "\[RightDoubleBracket]"}], "=", "True"}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"c", ",", "w"}], "]"}], ";", 
               RowBox[{"w", "=", 
                RowBox[{
                "f", "\[LeftDoubleBracket]", "w", 
                 "\[RightDoubleBracket]"}]}]}]}], "]"}], ";", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"cycles", ",", "c"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "n"}], "}"}]}], "]"}], ";", 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"seq", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"Sort", "[", 
                  RowBox[{
                  "preds", "\[LeftDoubleBracket]", "#1", 
                   "\[RightDoubleBracket]"}], "]"}], "}"}], "&"}], ")"}], "/@",
               "#1"}]}], "}"}], ",", 
           RowBox[{"First", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"RotateLeft", "[", 
                RowBox[{"seq", ",", "j"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"Length", "[", "seq", "]"}]}], "}"}]}], "]"}], "]"}],
             "]"}]}], "]"}], "&"}], ")"}], "/@", "cycles"}], "]"}]}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,

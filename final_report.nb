Cell[TextData[{
 "La siguiente hipotesis era que existe un mapeo entre las reglas que nos \
permite movernos entre espacios de CAs. Es decir, nosotros podemos movernos \
de la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], ",", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "0_{n,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3a5542b-f957-4f76-9e9f-07e7bf757975"],
 " a la ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], "+", "1", ",", "1"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "0_{n+1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f81a1a07-f305-4664-9265-f912a3ad9c34"],
 " unicamente a\[NTilde]adiendo un nuevo estado que apunte al estado 0. \
Consideremos los siguientes ejemplos, donde se muestra con el patr\[OAcute]n \
es exactamente el mismo sin importar cuantos estados a\[NTilde]adamos"
}], "Text",
 CellChangeTimes->{{3.9905821711022787`*^9, 3.990582318140648*^9}, {
  3.99058362245746*^9, 3.9905836302579536`*^9}, {3.994213712209573*^9, 
  3.994213735420364*^9}, {3.994213785414983*^9, 3.9942137987570667`*^9}, {
  3.994213870948168*^9, 
  3.994213884063669*^9}},ExpressionUUID->"d2cd7178-dbb4-4e75-8172-\
846ec44f6134"],

Cell[CellGroupData[{

Cell[TextData[{
 "Reglas ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
   "}"}]], "InlineCode",ExpressionUUID->
  "fa92fb60-a754-4f2c-af49-d5a61410be75"],
 ":"
}], "Item",
 CellChangeTimes->{{3.9905891376804743`*^9, 
  3.99058918159158*^9}},ExpressionUUID->"89d17187-7ecb-44ba-b690-\
dec3e3dab465"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"urv", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ca\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
         RowBox[{"\"\<vector\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
           "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
           "}"}]}]}], "|>"}], "}"}], ",", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<ca\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"i", "+", "1"}], ",", "0"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<vector\>\"", "->", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"i", "+", "1"}]}], "]"}], ",", 
               RowBox[{"Length", "[", "urs", "]"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "|>"}], "&"}], "/@", 
         RowBox[{"urs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", ";;", ",", "1"}], "]"}], "]"}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "urs", "]"}], "-", "1"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "]"}], "//", "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Range", "[", 

Cell[BoxData[
 RowBox[{
  RowBox[{"MirrorRules", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", "rule", ",", "assoc", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ca", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", 
           RowBox[{"ca", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "-", "1"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rule", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"ca", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"ca", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"Length", "[", "pos", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assoc", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"pos", ",", "rule"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"FromDigits", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Reverse", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
                "assoc"}], ",", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ca", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
          "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"#", ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", "res"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,

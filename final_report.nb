Cell[BoxData[{
 RowBox[{
  RowBox[{"urv", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ca\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
         RowBox[{"\"\<vector\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
           "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
           "}"}]}]}], "|>"}], "}"}], ",", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<ca\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"i", "+", "1"}], ",", "0"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<vector\>\"", "->", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"i", "+", "1"}]}], "]"}], ",", 
               RowBox[{"Length", "[", "urs", "]"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "|>"}], "&"}], "/@", 
         RowBox[{"urs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", ";;", ",", "1"}], "]"}], "]"}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "urs", "]"}], "-", "1"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "]"}], "//", "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", "0", ",", 
            RowBox[{"-", "1"}]}], "]"}], ",", "3"}], "]"}], "&"}], "/@", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"urv", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<vector\>\"", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "0", ",", "0", ",", "0", ",", "1", ",", "1", ",", 
              "1"}], "}"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "\"\<ca\>\""}], "]"}], "]"}]}]}], ",", 
     RowBox[{"cell", "=", "15"}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maxRows", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "cas"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nrows", "=", 
              RowBox[{
               RowBox[{"Dimensions", "[", "#", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"ncols", "=", 
              RowBox[{
               RowBox[{"Dimensions", "[", "#", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"ArrayPlot", "[", 
            RowBox[{"#", ",", 
             RowBox[{"ColorRules", "->", 
              RowBox[{"colorRules", "[", "6", "]"}]}], ",", 
             RowBox[{"Mesh", "->", "True"}], ",", 
             RowBox[{"PlotRangePadding", "->", "0"}], ",", 
             RowBox[{"ImagePadding", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"cell", "*", 
                   RowBox[{"(", 
                    RowBox[{"maxRows", "-", "nrows"}], ")"}]}], ",", "0"}], 
                 "}"}]}], "}"}]}], ",", 
             RowBox[{"ImageSize", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cell", "*", "ncols"}], ",", 
                RowBox[{"cell", "*", "maxRows"}]}], "}"}]}]}], "]"}]}], "]"}],
          "&"}], "/@", "cas"}], "}"}], "]"}]}], "]"}]}], "]"}]}], "Input",

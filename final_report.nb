            RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rule", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"ca", "[", 

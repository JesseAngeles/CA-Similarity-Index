Cell[TextData[{
 "Las evoluciones de las reglas ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["10", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "10_{2,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb33c6d9-417d-407f-adc8-2954894ea289"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["2", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "2_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cdd48e7d-472f-413c-bf80-bf18ed705634"],
 " son exactamente iguales. Para la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["3", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "3_{2,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "70d748bc-f4f7-4bf3-9764-374c1aec3167"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["1", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "1_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cb0d468-9bb6-4dd1-87af-27f565022355"],
 " hay que considerar que es el inverso de la celula a la izquierda, por lo \
que si trasladamos los bloques, a la izquierda, encontramos el mismo \
comportamiento."
}], "Text",
 CellChangeTimes->{
  3.99421551960039*^9},ExpressionUUID->"a519ef1a-1668-456f-bba5-eb5b2d2ae050"],


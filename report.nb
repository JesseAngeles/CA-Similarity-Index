  3.990583453415358*^9}},ExpressionUUID->"72d29349-ac89-4f57-9466-\
8a6bfd72b68e"],

Cell[TextData[{
 "Estos son los comportamientos unicos para 3 estados. Nuevamente encontramos \
el patr\[OAcute]n de la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{"1", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "0_{1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb65e471-5a29-47d6-8d23-8db792ecb134"],
 ", pero ademas, tenemos nuevos comportamientos"
}], "Text",

     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"FASE", " ", "3"}], ":", " ", 
       RowBox[{"primitivas", " ", "3", "D"}]}], " ", "*)"}], "\n", "   ", 
     RowBox[{"rings3D", " ", "=", " ", 
      RowBox[{"{", 

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrizSimilitudTopologica", "[", "listaGrafos_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"vectoresEspectrales", ",", "matrizDistancias"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "1.", " ", "Calcular", " ", "los", " ", "autovalores", " ", 
      "num\[EAcute]ricos", " ", "y", " ", "ordenados", " ", "para", " ", 
      "cada", " ", "grafo"}], "*)"}], 
    RowBox[{
     RowBox[{"vectoresEspectrales", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"KirchhoffMatrix", "[", "g", "]"}], "]"}], "]"}], "]"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"g", ",", "listaGrafos"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Calcular", " ", "la", " ", "matriz", " ", "de", " ", 
       "distancias", " ", "euclidianas", " ", "entre", " ", "todos", " ", 
       "los", " ", "espectros"}], "*)"}], 

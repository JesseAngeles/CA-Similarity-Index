                " ", 
               RowBox[{"Sphere", "[", 
                RowBox[{"p", ",", " ", "nSize"}], "]"}]}], "}"}]}], "]"}]}], 
          "]"}], " ", "/@", " ", "allNodes"}], ",", " ", "1"}], "]"}]}], ";", 
     "\n", "   ", 
     RowBox[{"ringLabels3D", " ", "=", " ", 

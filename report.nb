            RowBox[{
            "mappedRuleList", ",", "uniqueCheck", ",", "newRV", ",", 
             "newTuples"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "El", " ", "reemplazo", " ", "se", " ", "hace", " ", "sobre", " ",
               "la", " ", "lista"}], ",", 
             RowBox[{
             "manteniendo", " ", "los", " ", "duplicados", " ", "vivos"}]}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"mappedRuleList", "=", 
             RowBox[{"ruleList", "/.", " ", 

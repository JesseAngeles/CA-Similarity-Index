Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vectors", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 

Cell["\<\
La primer hipotesis es que existia una una forma de generar toda esa \
secuencia mediante un algoritmo o una formula, y depues existia una funci\
\[OAcute]n que extraia unicamente las reglas que pertenecian a ese espacio. \
Esto no se pudo demostrar ya que la secuencia generada es aleatorio o almenos \
no se pudo encontrar una patr\[OAcute]n universal, sino unicamente patrones \
aislados. Resulta interesante como dentro de la misma definici\[OAcute]n de \
los automatas celulares podemos encontrar estas formas complejas.  \
\>", "Text",
 CellChangeTimes->{{3.9905820291106377`*^9, 
  3.990582161450363*^9}},ExpressionUUID->"e8c34acc-d2e3-4b21-a313-\
26b880b06530"],

Cell[TextData[{
 "La siguiente hipotesis era que existe un mapeo entre las reglas que nos \
permite movernos entre espacios de CAs. Es decir, nosotros podemos movernos \
de la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], ",", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "0_{n,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98077afb-ec81-41fe-87da-868d9a4ba6db"],
 " a la ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], "+", "1", ",", "1"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "0_{n+1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8925da42-75e7-4389-8dd5-e5cdd3944ada"],
 " unicamente a\[NTilde]adiendo un nuevo estado que apunte al estado 0. Pero \
surge la pregunta, \[DownQuestion]Tienen todos el mismo comportamiento? Vamos \
a mostrar las evoluciones para unos ejemplos."
}], "Text",
 CellChangeTimes->{{3.9905821711022787`*^9, 3.990582318140648*^9}, {
  3.99058362245746*^9, 
  3.9905836302579536`*^9}},ExpressionUUID->"7027d85e-01bc-4b6d-930f-\
27448abf6cb7"],

Cell[CellGroupData[{

Cell[TextData[{
 "Reglas ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
   "}"}]], "InlineCode",ExpressionUUID->
  "4cbdfe61-2887-42f6-a240-7150c4c4f322"],
 ":"
}], "Item",
 CellChangeTimes->{{3.9905891376804743`*^9, 
  3.99058918159158*^9}},ExpressionUUID->"6facb038-807a-48e6-92f9-\
95ccf6eeea7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"urv", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<ca\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
         RowBox[{"\"\<vector\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
           "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
           "}"}]}]}], "|>"}], "}"}], ",", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"<|", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"\"\<ca\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"i", "+", "1"}], ",", "0"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<vector\>\"", "->", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"i", "+", "1"}]}], "]"}], ",", 
               RowBox[{"Length", "[", "urs", "]"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "|>"}], "&"}], "/@", 
         RowBox[{"urs", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", ";;", ",", "1"}], "]"}], "]"}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "urs", "]"}], "-", "1"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], "]"}], "//", "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cas", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", "0", ",", 
            RowBox[{"-", "1"}]}], "]"}], ",", "3"}], "]"}], "&"}], "/@", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"urv", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<vector\>\"", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{
             "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
              "0"}], "}"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"2", ";;"}], ",", "\"\<ca\>\""}], "]"}], "]"}]}]}], ",", 
     RowBox[{"cell", "=", "15"}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"maxRows", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "cas"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Grid", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nrows", "=", 
              RowBox[{
               RowBox[{"Dimensions", "[", "#", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"ncols", "=", 
              RowBox[{
               RowBox[{"Dimensions", "[", "#", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"ArrayPlot", "[", 
            RowBox[{"#", ",", 
             RowBox[{"ColorRules", "->", "colorRules"}], ",", 
             RowBox[{"Mesh", "->", "True"}], ",", 
             RowBox[{"PlotRangePadding", "->", "0"}], ",", 
             RowBox[{"ImagePadding", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"cell", "*", 
                   RowBox[{"(", 
                    RowBox[{"maxRows", "-", "nrows"}], ")"}]}], ",", "0"}], 
                 "}"}]}], "}"}]}], ",", 
             RowBox[{"ImageSize", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cell", "*", "ncols"}], ",", 
                RowBox[{"cell", "*", "maxRows"}]}], "}"}]}]}], "]"}]}], "]"}],
          "&"}], "/@", "cas"}], "}"}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.990583648798929*^9, 3.990583689767584*^9}, 
   3.990583733431179*^9, {3.99058377906555*^9, 3.990583820117486*^9}, {

             RowBox[{"nSize", "*", "2.5"}], ",", " ", "0"}], "}"}]}]}], "\n", 
         "    ", "]"}], " ", "&"}], " ", "/@", " ", "rings"}]}], ";", "\n", 
     "\n", "   ", 
     RowBox[{"Graphics3D", "[", "\n", "    ", 

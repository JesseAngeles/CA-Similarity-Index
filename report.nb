Cell[TextData[{
 "Observamos que el comportamiento es practicamente el mismo, pues el ultimo \
estado unicamente realizando una llamada al primero. Por lo que inferimos 2 \
cosas de aqui. Si la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        RowBox[{
          StyleBox["n", "TI"], ",", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "x_{n,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d31804d-34b4-4589-ad91-2489344c7549"],
 " es reversible, la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["y", "TI"], 
        RowBox[{
          StyleBox["n", "TI"], "+", "1", ",", "1"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "y_{n+1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab3c3b43-1f60-405a-848a-8c445ae443e1"],
 " no lo es, donde ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f7da992a-ef70-4565-b7b3-953b8442e985"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["y", "TI"], TraditionalForm], "errors" -> {}, "input" -> "y", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61744f4b-d0c0-4cdc-b91e-f0da9e895dbd"],
 " tienen el mismo vector de regla. \nAhora, si nosotros podemos aplicar la \
funci\[OAcute]n de a\[NTilde]adir un nuevo con transici\[OAcute]n el elemento \
vacio, tambien debe de ser posible de realizar el proceso inverso, es decir, \
a una regla cuyo ultimo estado tenga una transici\[OAcute]n al 0 puede ser \
eliminida siempre y cuando ning\[UAcute]n otro estado tenga una transici\
\[OAcute]n al ultimo estado. Esto se cumple para los ejemplos ya mostrados, \
por lo que estamos haciendo es movernos entre los subconjuntos del espacio de \
reglas. Pero existen casos excepcionales que no parecen cumplir con esto, por \
ejemplo, la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["31", 
        RowBox[{"5", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "31_{5,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "439a130e-fa37-4868-9e7f-05f62385e99e"],
 ", que si le quitamos las ultimas transiciones obtenemos las siguientes \
reglas:"
}], "Text",
 CellChangeTimes->{{3.990589400197362*^9, 3.99058940362365*^9}, {
  3.990589433696395*^9, 3.990589848397318*^9}, {3.990589931187255*^9, 
  3.990589962689596*^9}},ExpressionUUID->"1145b742-7d3e-400c-aebb-\
589e82f03b9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cas", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"31", ",", "5", ",", "0"}], "}"}], ",", 
            RowBox[{"Range", "[", 
             RowBox[{"4", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "5"}], "]"}], ",", 
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"21", ",", "4", ",", "0"}], "}"}], ",", 
            RowBox[{"Range", "[", 
             RowBox[{"3", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "5"}], "]"}], ",", 
          RowBox[{"CellularAutomaton", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"13", ",", "3", ",", "0"}], "}"}], ",", 
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "5"}], "]"}]}], "}"}]}], ",", 
       
       RowBox[{"labels", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"31", ",", "5", ",", "1"}], "]"}], ",", 
          RowBox[{"Subscript", "[", 
           RowBox[{"21", ",", "4", ",", "1"}], "]"}], ",", 
          RowBox[{"Subscript", "[", 
           RowBox[{"13", ",", "3", ",", "1"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"cell", "=", "30"}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"maxRows", "=", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "#", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "cas"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"nrows", "=", 
               RowBox[{
                RowBox[{"Dimensions", "[", "#1", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"ncols", "=", 
               RowBox[{
                RowBox[{"Dimensions", "[", "#1", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"ArrayPlot", "[", 
             RowBox[{"#1", ",", 
              RowBox[{"ColorRules", "->", "colorRules"}], ",", 
              RowBox[{"Mesh", "->", "True"}], ",", 
              RowBox[{"PlotRangePadding", "->", "0"}], ",", 
              RowBox[{"PlotLabel", "->", "#2"}], ",", 
              RowBox[{"ImagePadding", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"cell", "*", 
                    RowBox[{"(", 
                    RowBox[{"maxRows", "-", "nrows"}], ")"}]}], ",", "0"}], 
                  "}"}]}], "}"}]}], ",", 
              RowBox[{"ImageSize", "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cell", "*", "ncols"}], ",", 
                 RowBox[{"cell", "*", "maxRows"}]}], "}"}]}]}], "]"}]}], 
           "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"cas", ",", "labels"}], "}"}]}], "]"}]}], "]"}]}], "]"}], 
   "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.990590241246725*^9, 3.990590278938163*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"84c15eaf-c914-4046-93a9-71f5e09832a0"],


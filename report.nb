             RowBox[{"nodePos", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "tL"}]}], "}"}]}], ";", "\n", "   ", 
     RowBox[{"nodeSpheres3D", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Function", "[", 

Cell[TextData[{
 "Las evoluciones de las reglas ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["10", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "10_{2,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "986ef9c4-eb7d-4480-9ae0-cd9da5a0c03b"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["2", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "2_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "357ae5a7-2b69-4a80-8fe2-da7873cb7595"],
 " son exactamente iguales. Para la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["3", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "3_{2,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b35c49b4-3892-4821-94f9-e61d141d367a"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["1", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "1_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41833411-ad28-4af6-be69-416ab84461b2"],
 " hay que considerar que es el inverso de la celula a la izquierda, por lo \
que si trasladamos los bloques, a la izquierda, encontramos el mismo \
comportamiento."
}], "Text",
 CellChangeTimes->{{3.991020623229303*^9, 
  3.991020746608309*^9}},ExpressionUUID->"7ec3ace6-9006-4f9b-841a-\
0e1f68f98b22"],


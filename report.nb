                    RowBox[{"0.4", ",", " ", "0.6", ",", " ", "1."}], "]"}], ",",
                    " ", 
                   RowBox[{"EdgeForm", "[", "None", "]"}], ",", "\n", 
                   "        ", 
                   RowBox[{"Polygon", "[", 
                    RowBox[{"{", 

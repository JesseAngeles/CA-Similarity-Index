Cell[BoxData[
 RowBox[{"Graph", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{"Values", "[", 
     RowBox[{"reduce", "[", 
      RowBox[{"addData", "[", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["0", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["8", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["32", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["40", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["128", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["136", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["160", 
          RowBox[{"2", ",", "3"}]], ",", 
         SubscriptBox["168", 
          RowBox[{"2", ",", "3"}]]}], "}"}], "]"}], "]"}], "]"}], "]"}], ",", 
   
   RowBox[{"VertexLabels", "->", "\"\<Name\>\""}]}], "]"}]], "Input",

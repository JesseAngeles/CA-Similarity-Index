      RowBox[{"{", 
       RowBox[{"5", ",", "5", ",", "5"}], "}"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"Transpose", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"CaArrayPlot", "[", 
        RowBox[{"#", ",", "init", ",", "50", ",", 
         RowBox[{"ImageSize", "->", "200"}]}], "]"}], ",", 
       RowBox[{"CaRulePlot", "[", "#", "]"}]}], "}"}], "&"}], "/@", "rules"}],
    "]"}], "]"}]}], "Input",

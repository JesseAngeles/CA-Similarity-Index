Cell[CellGroupData[{

Cell["Otra parte", "Chapter",
 CellChangeTimes->{{3.991873492304016*^9, 
  3.991873494932691*^9}},ExpressionUUID->"4514427e-70f9-4dab-90cd-\
ed361ca546cf"],

Cell["\<\
Ya vimos que existen aun asi muchas reglas que hace falta analizar su \
comportmaiento, y eso es un poco parte de la clasificaci\[OAcute]n. El \
problema es que las clasificaciones de las reglas no son funciones, no es que \
yo pueda definir una funci\[OAcute]n que me determinr a que clase pertenece \
porque existn muchas formas de intentar hacer esta claificaci\[OAcute]n. \
\[LineSeparator]\[LineSeparator]Bien, tenemos muchas reglas que podemos \
estudiar, pero dado que con 1 vecino son insignificantes, entonces tenemos 2 \
opciones, analziar las de 2 vecinos y tres estados o las de 2 estados y 3 \
vecinos, porque con 2 estados y 2 vecinos solo tenemos 4 comportamientos que \
son necesarios ser clasificados. Vamos a inicar con als 256 reglas de ECA. \
Pero solo nos interesan las \
\>", "Text",
 CellChangeTimes->{{3.991873201233371*^9, 3.991873371029057*^9}, {
  3.991873682412877*^9, 
  3.991873689802421*^9}},ExpressionUUID->"3178f688-40ef-445a-a8b7-\
a2409e1c1016"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"#", ",", "2", ",", "3"}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"2", "^", "3"}]}], "-", "1"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"reduce", "[", 
    RowBox[{"addData", "[", "rules", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rules", "=", 
  RowBox[{"Complement", "[", 
   RowBox[{
    RowBox[{"VertexList", "@", 
     RowBox[{"data", "[", "\"\<inverse\>\"", "]"}]}], ",", 
    RowBox[{"VertexList", "@", 
     RowBox[{"data", "[", "\"\<state\>\"", "]"}]}], ",", 
    RowBox[{"VertexList", "@", 
     RowBox[{"data", "[", "\"\<neighbor\>\"", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "rules", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"Values", "[", "data", "]"}], "]"}], ",", 
     RowBox[{"VertexLabels", "->", "\"\<Name\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Graph", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{"EdgeList", "/@", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"WeaklyConnectedGraphComponents", "[", "g", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"VertexList", "[", "#", "]"}], "]"}], ">", "1"}], "&"}]}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
    RowBox[{"GraphLayout", "->", "\"\<LayeredDigraphEmbedding\>\""}]}], "]"}],
   ";"}]}], "Input",
 CellChangeTimes->{
  3.991873382103746*^9, {3.991873513308096*^9, 3.9918736719819107`*^9}, {

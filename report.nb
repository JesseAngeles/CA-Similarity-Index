                    "}"}], "]"}]}], "}"}]}]}], "]"}]}]}], "\n", "   ", 
            "]"}]}], "]"}], " ", "/@", " ", 
         RowBox[{"Keys", "[", "meshesByHeight", "]"}]}], ",", " ", "1"}], 

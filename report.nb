        RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", 
        RowBox[{"Arrowheads", "[", "0.02", "]"}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"Arrow", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nodePos", "[", 

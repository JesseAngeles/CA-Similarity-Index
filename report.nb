        "\[IndentingNewLine]", 
        RowBox[{"Subscript", "[", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{"redRV", ",", "s"}], "]"}], ",", "s", ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",

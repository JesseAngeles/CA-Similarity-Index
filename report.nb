Cell[CellGroupData[{

Cell[TextData[{
 "las reglas \[OpenCurlyDoubleQuote]s\[CloseCurlyDoubleQuote] que equivalen \
al tama\[NTilde]o de la vecindad tiene el comportamiento de crear un \
crecimiento en el lado izquierdo, el tama\[NTilde]o de la vecindad define la \
inclinaci\[OAcute]n. Esto aplica para la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["2", 
        RowBox[{"2", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "2_{2,3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2257ce67-1627-4480-adf5-3ed882b77b01"],
 "."
}], "Item",
 CellChangeTimes->{{3.9918749470830307`*^9, 
  3.991875037338086*^9}},ExpressionUUID->"4c69eebd-0adf-4cc6-adad-\
c1a0d1488116"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "100"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"#1", ",", "#2", ",", "#3"}], "]"}], "&"}], "@@@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 

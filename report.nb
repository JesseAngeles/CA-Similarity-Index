Cell[TextData[{
 "Si asumimos que el comportamiento de la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "0_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d67b967-6ee1-46c1-9973-23b6c48407d2"],
 " es el mismo que el de la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{"1", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "0_{1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "545741b7-0e67-47ba-8550-08890aaf93b2"],
 ", entonces reducimos aun mas el numero de comportamientos diferentes, sin \
embargo, la regla ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "0_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03c0807a-e979-4fe6-9286-798b714783f9"],
 " no es reversible, por lo que no exactamente lo mismo, pero si tiene el \
mismo tipo de atractor. \nLas reglas ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["1", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "1_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d657c207-b90e-42bb-a7b0-712ee1f750a1"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["2", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "2_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2371b647-2134-4837-a34f-5675baa97714"],
 " por otro lado si son reversibles y son las reglas inversas de si mismas. "
}], "Text",
 CellChangeTimes->{{3.990330366531951*^9, 3.9903306005409718`*^9}, {
  3.9903307289580793`*^9, 3.9903307329482183`*^9}, {3.990330862045142*^9, 
  3.990330864842434*^9}, {3.990330925215396*^9, 3.990330956467915*^9}, {
  3.9905787341448927`*^9, 3.990578744644052*^9}, {3.990578783846159*^9, 

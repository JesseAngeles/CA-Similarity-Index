Cell[BoxData[
 RowBox[{
  RowBox[{"InverseRules", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"s", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"n", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", "1"}], ")"}], "/", "2"}]}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{
        RowBox[{"ca", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "^", 
        RowBox[{"ca", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ",", "outputs", ",", "tuples", ",",
       "perms", ",", "res"}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"outputs", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"r", ",", "s", ",", "L"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"outputs", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"salida", " ", "de", " ", "la", " ", "vecindad", " ", "k"}], "-",
         "1"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tuples", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", "s", ",", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"L", "-", "1"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"tuples", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vecindad", " ", "k"}], "-", 
        RowBox[{"1", " ", "como", " ", "n"}], "-", "tupla"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"perms", "=", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"s", "-", "1"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"solo", " ", 
       RowBox[{"s", "!"}], " ", "permutaciones", " ", "de", " ", "ESTADOS"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Module", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pi", "=", 
               RowBox[{"AssociationThread", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"s", "-", "1"}]}], "]"}], "->", "perm"}], "]"}]}], 
              ",", 
              RowBox[{"newOut", "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", "L"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Do", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"newOut", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"FromDigits", "[", 
                    RowBox[{
                    RowBox[{"pi", "/@", 
                    RowBox[{"tuples", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", "s"}], "]"}], "+", 
                   "1"}], "]"}], "]"}], "=", 
                RowBox[{"pi", "[", 
                 RowBox[{"outputs", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "L"}], "}"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"FromDigits", "[", 
              RowBox[{
               RowBox[{"Reverse", "[", "newOut", "]"}], ",", "s"}], "]"}]}]}],
            "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"perm", ",", "perms"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"#", ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", "res"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.991101227568142*^9, 3.9911012457650137`*^9}},

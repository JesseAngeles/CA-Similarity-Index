Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"JoinStates", "[", "ca_Subscript", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "s", ",", "n", ",", "rv", ",", "tuples", ",", "ruleList", ",",
        "possibleReductions"}], "}"}], ",", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"s", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", 
      RowBox[{"n", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"s", "<=", "2"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rv", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"r", ",", "s", ",", 
         RowBox[{"s", "^", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tuples", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "n"}], "-", "1"}], ",", "0", ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", "s", ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ruleList", "=", 
       RowBox[{"Thread", "[", 
        RowBox[{"tuples", "->", "rv"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"possibleReductions", "=", 
       RowBox[{"Table", "[", 

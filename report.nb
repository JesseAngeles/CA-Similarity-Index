        RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", " ", 
        RowBox[{"Opacity", "[", "0.25", "]"}], ",", " ", 
        RowBox[{"Specularity", "[", 
         RowBox[{"White", ",", " ", "10"}], "]"}], ",", "\n", "     ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Tube", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"r", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
                  RowBox[{"rad", "*", 
                   RowBox[{"Cos", "[", "t", "]"}]}]}], ",", " ", 
                 RowBox[{"r", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", "\n", 
                 "          ", 
                 RowBox[{
                  RowBox[{"r", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], " ", "+", " ", 
                  RowBox[{"rad", "*", 
                   RowBox[{"Sin", "[", "t", "]"}]}]}]}], "}"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", "0", ",", " ", 
                 RowBox[{"2", " ", "Pi"}], ",", " ", 
                 RowBox[{"Pi", "/", "30"}]}], "}"}]}], "]"}], ",", " ", 
             "rThick"}], "]"}]}], "]"}], " ", "/@", " ", "rings"}]}], "}"}]}],
      ";", "\n", "   ", 
     RowBox[{"tEdges3D", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 

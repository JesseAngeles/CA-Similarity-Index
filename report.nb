Cell[TextData[{
 "A continuaci\[OAcute]n, se muestran las reglas agrupadas por numeros de \
estados. Podemos observar que que todas todas las reglas de ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fa11820-6e3d-40b8-9a03-d3cb1009246b"],
 " estados son un subconjunto de las reglas con ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "+", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "n+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6158a1cf-9738-47e7-b7e8-90050ebe1edc"],
 " estados, con la diferencia de que al nuevo estado se le asigna una \
transici\[OAcute]n a 0 (el primer estado). "
}], "Text",
 CellChangeTimes->{{3.990331621818845*^9, 3.990331676016108*^9}, {
  3.9903319297911043`*^9, 3.9903320065256357`*^9}, {3.990581715710298*^9, 
  3.9905817956174717`*^9}, {3.990581988324394*^9, 3.990582027428979*^9}, {
  3.990583574456678*^9, 
  3.990583575839891*^9}},ExpressionUUID->"f66785b6-764f-4857-876c-\
1a2e6bce7c7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"burs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", "i"}], "]"}], ",", "i"}], "]"}], "&"}], "/@", 
      RowBox[{"urs", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", ";;", ",", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "urs", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cell", "=", "10"}], ",", 
     RowBox[{"maxRows", "=", "50"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nrows", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"maxRows", ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "#", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ncols", "=", 
             RowBox[{
              RowBox[{"Dimensions", "[", "#", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"ArrayPlot", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{";;", 
               RowBox[{"UpTo", "[", "maxRows", "]"}]}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ColorRules", "->", "colorRules"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Mesh", "->", "True"}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotRangePadding", "->", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ImagePadding", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"cell", "*", 
                  RowBox[{"(", 
                   RowBox[{"maxRows", "-", "nrows"}], ")"}]}], ",", "0"}], 
                "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"cell", "*", "ncols"}], ",", 
               RowBox[{"cell", "*", "maxRows"}]}], "}"}]}]}], "]"}]}], "]"}], 
        "&"}], "/@", "burs"}], "\[IndentingNewLine]", "}"}], ",", 
     RowBox[{"Spacings", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "0"}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9903312811978083`*^9, 3.9903316017612886`*^9}, {

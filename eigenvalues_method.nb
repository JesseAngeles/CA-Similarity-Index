         "20", ",", "40", ",", "60", ",", "70", ",", "80", ",", "84", ",", 
          "88"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"81", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<81 (4 inheritance)\>\"", ",", "10", ",", "Gray"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"88", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<88 (state permutation, mirror)\>\"", ",", "10", ",",
               "Gray"}], "]"}]}], "}"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"81", ",", "88"}], "}"}]}], "}"}]}], ",", 

Cell["Funciones auxiliares", "Subsection",ExpressionUUID->"7676b01d-3388-4f2e-a80f-8a7d9fab916a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Grafos", " ", "de", " ", "transicion", " ", "de", " ", "varias", " ", 
     "reglas", " ", "con", " ", "i", " ", 
     RowBox[{"celulas", ".", " ", "rot"}]}], " ", "=", " ", 
    RowBox[{"True", " ", "usa", " ", "MakeGraphRot"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PlotRulesGraph", "[", 
      RowBox[{"rules_List", ",", "i_Integer", ",", 
       RowBox[{"rot_", " ", ":", " ", "False"}]}], "]"}], ":=", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Partition", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Labeled", "[", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"Graph", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"rot", ",", "MakeGraphRot", ",", "MakeGraph"}], 
                 "]"}], "[", 
                RowBox[{"r", ",", "i"}], "]"}], ",", 
               RowBox[{"VertexLabels", "->", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"i", "<=", "4"}], ",", "Automatic", ",", "None"}], 
                 "]"}]}], ",", 
               RowBox[{"VertexSize", "->", "Small"}], ",", 
               RowBox[{"ImageSize", "->", "220"}]}], "]"}], ",", 
             "\[IndentingNewLine]", "      ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<Regla \>\"", ",", 
                RowBox[{"r", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", "Top"}],
             "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rules"}], "}"}]}], "]"}], ",", 
         RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", 
       RowBox[{"Frame", "->", "All"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Una", " ", "regla", " ", "representativa", " ", "por", " ", "grupo", " ", 
     RowBox[{"inverse", "/", 
      RowBox[{"mirror", ":", " ", 
       RowBox[{"en", " ", "ECA", " ", "comparten", " ", "histograma", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"verificado", " ", "n"}], " ", "=", " ", 
          RowBox[{
           RowBox[{"1", ".."}], "25"}]}], ")"}]}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"repDe", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"#", "->", 
           RowBox[{"First", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@", 
        " ", "gruposInvMirECA"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ExpandirReps", "[", "h_Association", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"repDe", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"r", ",", "2", ",", "3"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Particion", " ", "por", " ", "histograma", " ", "para", " ", "n", " ", 
      "celulas"}], ",", " ", 
     RowBox[{
     "y", " ", "la", " ", "misma", " ", "sin", " ", "las", " ", "reglas", " ", 
      RowBox[{"lineales", "/", "afines"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ParticionECA", "[", "n_", "]"}], ":=", 
     RowBox[{"Sort", "[", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"GruposHist", "[", 
        RowBox[{"ecaHist", "[", "n", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linealesECA", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"#", ",", "2", ",", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
      
      RowBox[{"{", 
       RowBox[{
       "0", ",", "60", ",", "90", ",", "102", ",", "150", ",", "170", ",", 
        "204", ",", "240", ",", "255", ",", "195", ",", "165", ",", "153", ",",
         "105", ",", "85", ",", "51", ",", "15"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ParticionSinLineales", "[", "n_", "]"}], ":=", 
     RowBox[{"Sort", "[", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Sort", " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Complement", "[", 
             RowBox[{"#", ",", "linealesECA"}], "]"}], " ", "&"}], " ", "/@", 
           " ", 
           RowBox[{"ParticionECA", "[", "n", "]"}]}], ")"}]}], ",", 
        RowBox[{"{", "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Familias", " ", "de", " ", "tamanos", " ", "con", " ", "exactamente", " ",
      "la", " ", "misma", " ", "particion"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FamiliasECA", "[", "ns_List", "]"}], ":=", 
     RowBox[{"Values", "[", 
      RowBox[{"GroupBy", "[", 
       RowBox[{"ns", ",", "ParticionECA"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FamiliasSinLineales", "[", "ns_List", "]"}], ":=", 
     RowBox[{"Values", "[", 
      RowBox[{"GroupBy", "[", 
       RowBox[{"ns", ",", "ParticionSinLineales"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"30a67374-30a9-4863-b979-\
fa9d2d805b7f"],


         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Classes\>\"", "]"}], "[", "K", "]"}]}], 
        "}"}], "&"}], "/@", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", "amData", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"K", ",", "amKs"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yScale", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "^", "3"}], "&"}], ",", "CubeRoot"}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ptsAM", ",", 
   RowBox[{"PlotMarkers", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 

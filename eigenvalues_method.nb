Cell[BoxData[{
 RowBox[{
  RowBox[{"ptsEig", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
       RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", "eigData", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yScale", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "^", "3"}], "&"}], ",", "CubeRoot"}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ptsEig", ",", 

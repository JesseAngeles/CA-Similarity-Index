Cell[CellGroupData[{

Cell["Resultados", "Subsection",ExpressionUUID->"0e13924d-094b-4c89-a665-cc56d2a8dea9"],

Cell["\<\
Clases por n: 3, 5, 8, 14, 26, 30, 39, 49, 49, 60, 54, 58 para n = 1..12. \
Desde n = 13 los tama\[NTilde]os impares dan siempre 57 (salvo 15, con 56), n \
\[Congruent] 2 (mod 4) da 62 o 63 y 4 | n da 57, 60 o 61. Siempre son menos \
que sin cocientar (67\[Dash]74), y la forma can\[OAcute]nica del cociente \
siempre separa al menos lo mismo que su espectro.\
\>", "Text",ExpressionUUID->"683c3620-f3b8-4d53-b099-03b25cf204d9"],

Cell["\<\
Particiones id\[EAcute]nticas: {13, 17, 19, 23, 25, 29}, {14, 22, 26}, {20, \
28} y {21, 27}; los dem\[AAcute]s tama\[NTilde]os quedan aparte. Combinando \
los 29 tama\[NTilde]os se obtienen 68 clases. En todos los tama\[NTilde]os \
tienen el mismo espectro {0, 8}, {1, 19}, {2, 24, 36, 46, 72}, {4, 12, 34}, \
{15, 51}, {18, 126}, {23, 33}, {40, 78}, {42, 76}, {128, 136}, {130, 152}, \
{132, 140, 162, 168}, {138, 200} y {170, 204}: adem\[AAcute]s de las reglas \
con los mismos ciclos del grafo completo, el cociente junta las que difieren \
en componer con el desplazamiento, como {15, 51} y {170, 204}.\
\>", "Text",ExpressionUUID->"b09ebc5e-e37a-463c-b692-5e8f76675ba3"],

Cell["\<\
Combinando el espectro del grafo completo y el del cociente en el mismo tama\
\[NTilde]o se obtienen como m\[AAcute]ximo 77 clases (n = 18), y combinando \
todo, 77: a diferencia de la forma can\[OAcute]nica, el cociente no agrega \
informaci\[OAcute]n a los eigenvalores, porque ninguno de los dos ve los \
transitorios.\
\>", "Text",ExpressionUUID->"811dd2fe-d5b5-4559-b4ec-16ee89e635fa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Momentos espectrales en GPU: 88 reglas, n = 1, \[Ellipsis], 29", \
"Section",ExpressionUUID->"630ddc70-764d-4e73-9e8b-b6ed1acedad8"],

Cell["\<\
Clasificaci\[OAcute]n de las 88 reglas representantes por sus momentos \
espectrales m_k = |{x : F^k(x) = x}|/N, k = 1, \[Ellipsis], K, para n = 1, \
\[Ellipsis], 29 c\[EAcute]lulas. Misma metodolog\[IAcute]a que las secciones \
anteriores: una regla por clase de inverso + espejo, un archivo de datos, el \
resultado iconizado y la gr\[AAcute]fica.\
\>", "Text",ExpressionUUID->"3d02a627-efd2-4a22-81bd-ee393ba05edc"],

Cell["\<\
m_k depende solo del histograma de ciclos: una configuraci\[OAcute]n cumple \
F^k(x) = x si y solo si est\[AAcute] en un ciclo de longitud L con L | k, as\
\[IAcute] que m_k = (\[CapitalSigma]_{L | k} L c_L)/N. Los momentos se \
calculan en forma exacta (racionales) a partir de los histogramas de la secci\
\[OAcute]n de eigenvalores en GPU (eigData); si eigData no est\[AAcute] \
cargado, CyclesFor los calcula con CycleHistogram. Se guardan los vectores \
con K = 60 y las clases se cuentan comparando los primeros K momentos, con K \
= 10, 20, 30 y 60.\
\>", "Text",ExpressionUUID->"cfa1d5ea-7112-4aa8-82a3-985e26312e95"],

Cell["\<\
Validaci\[OAcute]n: para n = 1..8 los primeros 20 momentos de las 88 reglas \
coinciden con el conteo directo de las configuraciones con F^k(x) = x, \
iterando la regla en CPU.\
\>", "Text",ExpressionUUID->"4782b4c8-1e33-4d6b-8bba-45dc26068f60"],

Cell[CellGroupData[{

Cell["Funciones", "Subsection",ExpressionUUID->"79dbb363-ca7a-41c2-a603-adb97d00bca8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Momentos", " ", "espectrales", " ", "exactos", " ", "a", " ", "partir", 
      " ", "del", " ", "histograma", " ", "de", " ", 
      RowBox[{"ciclos", ":", " ", "m_k"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "n\[UAcute]mero", " ", "de", " ", "configuraciones", " ", "con", " ", 
          RowBox[{"F", "^", "k"}], 
          RowBox[{"(", "x", ")"}]}], " ", "=", " ", "x"}], ")"}], "/", "N"}], 
      " ", "=", " ", 
      RowBox[{
       RowBox[{
       "suma", " ", "de", " ", "L", " ", "c_L", " ", "sobre", " ", "los", " ",
         "ciclos", " ", "con", " ", "L"}], " ", "|", " ", "k"}]}]}], ",", " ", 
    RowBox[{"dividida", " ", "entre", " ", "N"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SpectralMomentsExact", "[", 
      RowBox[{"cycles_List", ",", "nodes_Integer", ",", "K_Integer"}], "]"}], 
     ":=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"cycles", ",", 
            RowBox[{
             RowBox[{"Divisible", "[", 
              RowBox[{"k", ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}]}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "K"}], "}"}]}], "]"}], "/", "nodes"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Histograma", " ", "de", " ", "ciclos", " ", "de", " ", "una", " ", 
       RowBox[{"regla", ":", " ", 
        RowBox[{
        "se", " ", "reutiliza", " ", "el", " ", "de", " ", "eigData", " ", 
         RowBox[{"(", 
          RowBox[{"misma", " ", "GPU"}], ")"}], " ", "si", " ", 
         "existe"}]}]}], ";", " ", 
      RowBox[{"si", " ", "no"}]}], ",", " ", 
     RowBox[{"se", " ", "calcula", " ", "con", " ", "CycleHistogram"}]}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CyclesFor", "[", 
      RowBox[{"r_Integer", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "eigData", "]"}], "&&", 
        RowBox[{"KeyExistsQ", "[", 
         RowBox[{"eigData", ",", "n"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"eigData", "[", "n", "]"}], "[", "\"\<Rules\>\"", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "==", "r"}], "&"}]}], 
          "]"}], "]"}], "[", "\"\<Cycles\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"CycleHistogram", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"r", ",", "2", ",", "3"}], "]"}], ",", "n"}], "]"}], 
        "[", "\"\<Cycles\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"smKs", "=", 
     RowBox[{"{", 
      RowBox[{"10", ",", "20", ",", "30", ",", "60"}], "}"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"7c048945-4f7b-40cc-b05f-\
2c371384b133"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Experimento", "Subsection",ExpressionUUID->"771fd157-12c2-43af-8c43-21fcf9a0b506"],

Cell["\<\
Cada tama\[NTilde]o se guarda en spectral_moments_gpu_data.wl. Requiere \
EigenSpectrum/ecaReps/nMax y eigData de la secci\[OAcute]n de eigenvalores en \
GPU (o la secci\[OAcute]n Funciones para recalcular los histogramas).\
\>", "Text",ExpressionUUID->"8b56ffbe-1d63-421b-82b4-c0076e04beee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataFileSM", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<spectral_moments_gpu_data.wl\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smResults", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileSM", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileSM", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"smResults", ",", "n"}], "]"}]}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rows", ",", "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Rule\>\"", "->", "r"}], ",", 
                 RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
                 RowBox[{"\"\<Moments\>\"", "->", 
                  RowBox[{"SpectralMomentsExact", "[", 
                   RowBox[{
                    RowBox[{"CyclesFor", "[", 
                    RowBox[{"r", ",", "n"}], "]"}], ",", 
                    RowBox[{"2", "^", "n"}], ",", 
                    RowBox[{"Max", "[", "smKs", "]"}]}], "]"}]}]}], "|>"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}], 
           "]"}]}], ";", 
         RowBox[{
          RowBox[{"smResults", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"CountDistinct", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{"#", ",", "K"}], "]"}], "&"}], "/@", 
                   RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Moments\>\""}], "]"}], "]"}]}], 
                  "]"}]}], "]"}], ",", "smKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"Values", "[", 
                  RowBox[{"GroupBy", "[", 
                   RowBox[{"rows", ",", 
                    RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Moments\>\"", "]"}], ",", "K"}], 
                    "]"}], "&"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], 
                    "&"}]}], "]"}], "]"}]}], "]"}], ",", "smKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         RowBox[{"Put", "[", 
          RowBox[{"smResults", ",", "dataFileSM"}], "]"}]}]}], "]"}]}], "]"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", 
       RowBox[{"#", "[", "\"\<n\>\"", "]"}]}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<K = \>\"", "<>", 
             RowBox[{"ToString", "[", "#1", "]"}]}], ")"}], "->", "#2"}], 
          "&"}], ",", 
         RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "]"}]}]}], "|>"}], 
    "&"}], "/@", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "smResults", "]"}], "]"}]}], "]"}]}], "Input",Expr\
essionUUID->"3d120ddc-8c8c-4b1b-af4f-80b3ab71c131"],


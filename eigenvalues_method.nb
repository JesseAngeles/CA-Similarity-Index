Cell[CellGroupData[{

Cell["Eigenvalores en GPU: 88 reglas, n = 1, \[Ellipsis], 29", "Section",ExpressionUUID->"b3a4a7cf-a1d9-4215-9a6c-aee038216a79"],

Cell["\<\
Clasificaci\[OAcute]n de las 88 reglas representantes (una por clase de \
inverso + espejo) por el espectro de la matriz de adyacencia de su grafo de \
transici\[OAcute]n, para n = 1, \[Ellipsis], 29 c\[EAcute]lulas. Es la misma \
metodolog\[IAcute]a que canonical_form_gpu.nb: una regla por clase, un \
archivo de datos por tama\[NTilde]o, el resultado iconizado y la \
gr\[AAcute]fica.\
\>", "Text",ExpressionUUID->"28c797d9-29d8-4d68-9e01-8b3b7c775019"],

Cell["\<\
El grafo de transici\[OAcute]n es funcional, as\[IAcute] que su espectro sale \
solo de los ciclos: un ciclo de longitud L aporta las L ra\[IAcute]ces L-\
\[EAcute]simas de la unidad y cada nodo de los \[AAcute]rboles aporta un \
eigenvalor 0. Por eso no se diagonaliza la matriz (2^n \[Times] 2^n): \
EigenSpectrum guarda el espectro exacto en forma compacta, la multiplicidad \
del 0 y, para cada d, la multiplicidad de las ra\[IAcute]ces primitivas d-\
\[EAcute]simas (el n\[UAcute]mero de ciclos cuya longitud es m\[UAcute]ltiplo \
de d). El histograma de ciclos se calcula con SuccessorArrayGPU y \
cycleHistogramC de la secci\[OAcute]n Funciones. Dos reglas tienen el mismo \
espectro si y solo si tienen el mismo histograma de ciclos.\
\>", "Text",ExpressionUUID->"b5b94973-0557-4bc3-b7f7-9293d4aa9bc2"],

Cell["\<\
Validaci\[OAcute]n: para n = 1..6 la partici\[OAcute]n coincide con la que se \
obtiene agrupando por el polinomio caracter\[IAcute]stico exacto de la matriz \
de adyacencia, y para n = 1..28 coincide con la de ecaHist (256 reglas, \
calculada antes).\
\>", "Text",ExpressionUUID->"bd3bffb5-41b4-4067-87a6-52007ccc6022"],

Cell[CellGroupData[{

Cell["Funciones", "Subsection",ExpressionUUID->"8072cd7c-295a-4743-a52b-748101ed466d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Espectro", " ", "exacto", " ", "de", " ", "la", " ", "matriz", " ", "de",
      " ", "adyacencia", " ", "a", " ", "partir", " ", "del", " ", 
     "histograma", " ", "de", " ", 
     RowBox[{"ciclos", ":", " ", 
      RowBox[{
       RowBox[{
       "un", " ", "ciclo", " ", "de", " ", "longitud", " ", "L", " ", 
        "aporta", " ", "las", " ", "L", " ", "ra\[IAcute]ces", " ", "L"}], "-", 
       RowBox[{"\[EAcute]simas", " ", "de", " ", "la", " ", "unidad"}]}]}]}], 
    ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "as\[IAcute]", " ", "que", " ", "las", " ", "ra\[IAcute]ces", " ", 
        "primitivas", " ", "d"}], "-", 
       RowBox[{
       "\[EAcute]simas", " ", "tienen", " ", "multiplicidad", " ", "igual", " ",
         "al", " ", "n\[UAcute]mero", " ", "de", " ", "ciclos", " ", "con", " ",
         "d"}]}], " ", "|", " ", "L"}], ";", " ", 
     RowBox[{
     "los", " ", "\[AAcute]rboles", " ", "solo", " ", "aportan", " ", "el", " ",
       "eigenvalor", " ", "0"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"EigenSpectrum", "[", "h_Association", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"c", "=", 
          RowBox[{"h", "[", "\"\<Cycles\>\"", "]"}]}], ",", "ds"}], "}"}], ",", 
       RowBox[{
        RowBox[{"ds", "=", 
         RowBox[{"Union", "@@", 
          RowBox[{"(", 
           RowBox[{"Divisors", "/@", 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}]}]}], ";", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Zero\>\"", "->", 
           RowBox[{
            RowBox[{"h", "[", "\"\<Nodes\>\"", "]"}], "-", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", 
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}]}], ",", 
          RowBox[{"\"\<Roots\>\"", "->", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"d", ",", 
               RowBox[{"Total", "[", 
                RowBox[{
                 RowBox[{"Select", "[", 
                  RowBox[{"c", ",", 
                   RowBox[{
                    RowBox[{"Divisible", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "d"}], "]"}], 
                    "&"}]}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"d", ",", "ds"}], "}"}]}], "]"}]}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Una", " ", 
     RowBox[{"regla", ":", " ", 
      RowBox[{
       RowBox[{
       "histograma", " ", "de", " ", "ciclos", " ", "en", " ", "GPU"}], " ", "+",
        " ", 
       RowBox[{
       "CPU", " ", "compilado", " ", "y", " ", "su", " ", "espectro"}]}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"EigenvaluesGPU", "[", 
      RowBox[{"r_Integer", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", "=", 
         RowBox[{"CycleHistogram", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"r", ",", "2", ",", "3"}], "]"}], ",", "n"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Rule\>\"", "->", "r"}], ",", 
         RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
         RowBox[{"\"\<Cycles\>\"", "->", 
          RowBox[{"h", "[", "\"\<Cycles\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Spectrum\>\"", "->", 
          RowBox[{"EigenSpectrum", "[", "h", "]"}]}]}], "|>"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "M\[IAcute]nimo", " ", "de", " ", "cada", " ", "clase", " ", "bajo", " ", 
     "espejo", " ", "e", " ", "inverso", " ", 
     RowBox[{"(", 
      RowBox[{"88", " ", "reglas"}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mirrorRule", "[", "r_", "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"BitGet", "[", 
         RowBox[{"r", ",", 
          RowBox[{
           RowBox[{"4", 
            RowBox[{"BitGet", "[", 
             RowBox[{"v", ",", "0"}], "]"}]}], "+", 
           RowBox[{"2", 
            RowBox[{"BitGet", "[", 
             RowBox[{"v", ",", "1"}], "]"}]}], "+", 
           RowBox[{"BitGet", "[", 
            RowBox[{"v", ",", "2"}], "]"}]}]}], "]"}], 
        RowBox[{"2", "^", "v"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"complementRule", "[", "r_", "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"BitGet", "[", 
           RowBox[{"r", ",", 
            RowBox[{"7", "-", "v"}]}], "]"}]}], ")"}], 
        RowBox[{"2", "^", "v"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ecaReps", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"r", ",", 
          RowBox[{"mirrorRule", "[", "r", "]"}], ",", 
          RowBox[{"complementRule", "[", "r", "]"}], ",", 
          RowBox[{"mirrorRule", "[", 
           RowBox[{"complementRule", "[", "r", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Length", "[", "ecaReps", "]"}]}]}]], "Input",ExpressionUUID->\
"8cd176e7-7a0c-408e-9517-851821bd8518"],

Cell[BoxData["88"], "Output",ExpressionUUID->"41b26ede-6151-4f6b-843c-98c7b8d832a5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Experimento", "Subsection",ExpressionUUID->"59db4bee-0137-4ec2-b454-f80f345cd5c4"],

Cell["\<\
Cada tama\[NTilde]o se guarda en eigenvalues_gpu_data.wl; si el archivo \
existe, solo se calculan los tama\[NTilde]os que faltan. Requiere evaluar \
antes la secci\[OAcute]n Funciones (sesi\[OAcute]n CUDA, SuccessorArrayGPU y \
cycleHistogramC).\
\>", "Text",ExpressionUUID->"22aac910-25c5-429c-ad92-14af474c7b3c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nMax", "=", "29"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dataFileEig", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<eigenvalues_gpu_data.wl\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eigResults", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileEig", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileEig", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"eigResults", ",", "n"}], "]"}]}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rows", ",", "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"EigenvaluesGPU", "[", 
                RowBox[{"r", ",", "n"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}], 
           "]"}]}], ";", 
         RowBox[{
          RowBox[{"eigResults", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"CountDistinct", "[", 
              RowBox[{"rows", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<Spectrum\>\""}], "]"}], "]"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"Values", "[", 
              RowBox[{"GroupBy", "[", 
               RowBox[{"rows", ",", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Spectrum\>\"", "]"}], "&"}], ",", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], 
                 "&"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         RowBox[{"Put", "[", 
          RowBox[{"eigResults", ",", "dataFileEig"}], "]"}]}]}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<n\>\"", ",", "\"\<Classes\>\"", ",", "\"\<Seconds\>\""}], 
       "}"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "eigResults", "]"}], "]"}]}], "]"}]}], "Input",Exp\
ressionUUID->"79313d1c-bf74-45de-bd8c-45297479fb48"],


Cell[BoxData[{
 RowBox[{
  RowBox[{"ptsSM", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"ptsAM10", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Classes\>\"", "]"}], "[", "10", "]"}]}], "}"}],
      "&"}], "/@", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", "amData", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ptsAMRot10", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Classes\>\"", "]"}], "[", "10", "]"}]}], "}"}],
      "&"}], "/@", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", "amRotData", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yScale", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "^", "3"}], "&"}], ",", "CubeRoot"}], "}"}]}], ";"}], "\n", 

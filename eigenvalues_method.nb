Cell["Espacio de 2 estados y 2 vecinos", "Subsection",ExpressionUUID->"ca74129c-dfed-4405-8b05-7c44e6dd720b"],

Cell[TextData[{
 "Con 2 vecinos la vecindad de la celda i es (i - 1, i), que no es simetrica. \
El kernel ",
 Cell[BoxData["succKernel"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "6ce40156-c92c-4342-b270-3f673f2182a4"],
 " solo acepta vecindades -r..r, asi que ",
 Cell[BoxData["succKernelLH"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "8300c88f-c121-4162-873f-7f061ec8c14f"],
 " recibe el rango lo..hi (m impar: -r..r; m = 2: -1..0). "
}], "Text",ExpressionUUID->"7e2a7c58-f9ca-4585-9751-4b0b58970e83"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Un", " ", "hilo", " ", "por", " ", "configuracion"}], ";", " ", 
    RowBox[{"vecindad", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"celdas", " ", "i"}], "+", "lo"}], " ", ".."}], " ", "i"}], "+",
       "hi"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"succKernelLH", "=", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"cudaSession", ",", 
       RowBox[{"ExternalOperation", "[", 
        RowBox[{"\"\<Function\>\"", ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Typed", "[", 
              RowBox[{"out", ",", 
               RowBox[{"\"\<CArray\>\"", "::[", "\"\<Integer32\>\"", "]"}]}], 
              "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"tab", ",", 
               RowBox[{"\"\<CArray\>\"", "::[", "\"\<Integer32\>\"", "]"}]}], 
              "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"pw", ",", 
               RowBox[{"\"\<CArray\>\"", "::[", "\"\<Integer64\>\"", "]"}]}], 
              "]"}], ",", "\[IndentingNewLine]", "      ", 
             RowBox[{"Typed", "[", 
              RowBox[{"k", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"lo", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"hi", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"n", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
             RowBox[{"Typed", "[", 
              RowBox[{"total", ",", "\"\<MachineInteger\>\""}], "]"}]}], 
            "}"}], ",", "\[IndentingNewLine]", "     ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"id", ",", "new", ",", "v", ",", "cell", ",", "dig"}], 
              "}"}], ",", "\[IndentingNewLine]", "      ", 
             RowBox[{
              RowBox[{"id", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                  "LibraryFunction", "[", "\"\<BlockDimensions.x\>\"", "]"}], 
                  "[", "]"}], "*", 
                 RowBox[{
                  RowBox[{"LibraryFunction", "[", "\"\<BlockID.x\>\"", "]"}], 
                  "[", "]"}]}], "+", 
                RowBox[{
                 RowBox[{"LibraryFunction", "[", "\"\<ThreadID.x\>\"", "]"}], 
                 "[", "]"}]}]}], ";", "\[IndentingNewLine]", "      ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"id", "<", "total"}], ",", "\[IndentingNewLine]", 
                "       ", 
                RowBox[{
                 RowBox[{"new", "=", "0"}], ";", "\[IndentingNewLine]", 
                 "       ", 
                 RowBox[{"Do", "[", "\[IndentingNewLine]", "        ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"v", "=", "0"}], ";", "\[IndentingNewLine]", 
                    "        ", 
                    RowBox[{"Do", "[", "\[IndentingNewLine]", "         ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"cell", "=", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"i", "+", "d"}], ",", "n"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "         ", 
                    RowBox[{"dig", "=", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"Quotient", "[", 
                    RowBox[{"id", ",", 
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"pw", ",", "cell"}], "]"}]}], "]"}], ",", "k"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "         ", 
                    RowBox[{"v", "=", 
                    RowBox[{
                    RowBox[{"v", "*", "k"}], "+", "dig"}]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"d", ",", "lo", ",", "hi"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", "        ", 
                    RowBox[{"new", "=", 
                    RowBox[{
                    RowBox[{"new", "*", "k"}], "+", 
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"tab", ",", "v"}], "]"}]}]}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", "       ", 
                 RowBox[{"ToRawPointer", "[", 
                  RowBox[{"out", ",", "id", ",", 
                   RowBox[{"Cast", "[", 
                    RowBox[{
                    "new", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], "]"}]}]}], "]"}], ";"}]}], "\[IndentingNewLine]",
             "      ", "]"}]}], "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<CUDAArchitecture\>\"", "->", "\"\<sm_120\>\""}]}], 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SuccessorArrayGPULH", "[", 
      RowBox[{"ca_Subscript", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"m", "=", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", "total", ",", "tab", ",", 
         "pw", ",", "out"}], "}"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"total", "=", 
         RowBox[{"k", "^", "n"}]}], ";", "\[IndentingNewLine]", "   ", 
        RowBox[{"tab", "=", 
         RowBox[{"GPUArray", "[", 
          RowBox[{"NumericArray", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"ca", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "k", ",", 
               RowBox[{"k", "^", "m"}]}], "]"}], "]"}], 
            ",", "\"\<Integer32\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"pw", "=", 
         RowBox[{"GPUArray", "[", 
          RowBox[{"NumericArray", "[", 
           RowBox[{
            RowBox[{"k", "^", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"n", "-", "1"}], ",", "0", ",", 
               RowBox[{"-", "1"}]}], "]"}]}], ",", "\"\<Integer64\>\""}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", "   ", 
        RowBox[{"out", "=", 
         RowBox[{"GPUArray", "[", 
          RowBox[{"ZerosInt32", "[", "total", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"succKernelLH", "[", 
         RowBox[{"out", ",", "tab", ",", "pw", ",", "k", ",", 
          RowBox[{"-", 
           RowBox[{"Ceiling", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"m", "-", "1"}], ")"}], "/", "2"}], "]"}]}], ",", 
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "-", "1"}], ")"}], "/", "2"}], "]"}], ",", "n", ",",
           "total"}], "]"}], ";", "\[IndentingNewLine]", "   ", 
        RowBox[{"NumericArray", "[", "out", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CycleHistogramLH", "[", 
      RowBox[{"ca_Subscript", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Nodes\>\"", "->", 
        RowBox[{
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "^", "n"}]}], ",", 
       RowBox[{"\"\<Cycles\>\"", "->", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"cycleHistogramC", "[", 
           RowBox[{"SuccessorArrayGPULH", "[", 
            RowBox[{"ca", ",", "n"}], "]"}], "]"}], ",", "2"}], "]"}]}]}], 
      "|>"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CycleHistogramRotLH", "[", 
      RowBox[{"ca_Subscript", ",", "n_Integer"}], "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", "=", 
         RowBox[{"cycleHistogramRotC", "[", 
          RowBox[{
           RowBox[{"SuccessorArrayGPULH", "[", 
            RowBox[{"ca", ",", "n"}], "]"}], ",", 
           RowBox[{"RotationClassGPU", "[", 
            RowBox[{"ca", ",", "n"}], "]"}]}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Nodes\>\"", "->", 
          RowBox[{"r", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Cycles\>\"", "->", 
          RowBox[{"r", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"2e356eba-1411-4566-a76b-\
79fe335348e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules22", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"r", ",", "2", ",", "2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "15"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gAll22", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{"_", ",", "2", ",", "2"}], "]"}]}], "]"}], " ", "&"}], " ", 
      "/@", " ", 
      RowBox[{"GroupRelations", "[", 
       RowBox[{"relations", ",", "All", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"ecaRules", ",", "rules22"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Grupos22", "[", "h_List", "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"#", ",", "2", ",", "2"}], "]"}], " ", "&"}], ",", 
     RowBox[{"Values", "[", 
      RowBox[{"GroupBy", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "15"}], "]"}], "->", "h"}], "]"}], ",", 
        RowBox[{"Last", "->", "First"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Conteo22", "[", "gB_List", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", 
       RowBox[{
        RowBox[{"Length", "@*", "Flatten"}], " ", "/@", " ", 
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"CompararClasificaciones", "[", 
           RowBox[{"gAll22", ",", "gB"}], "]"}], ",", 
          RowBox[{"#Tipo", " ", "&"}], ",", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<Reglas\>\""}], "]"}], "]"}], " ", 
           "&"}]}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Lookup", "[", 
      RowBox[{"c", ",", "categorias", ",", "0"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conteo22raw", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Conteo22", "[", 
      RowBox[{"Grupos22", "[", 
       RowBox[{"raw22", "[", "n", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "31"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conteo22rot", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Conteo22", "[", 
      RowBox[{"Grupos22", "[", 
       RowBox[{"rot22", "[", "n", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "29"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PlotCategorias22", "[", 
    RowBox[{"datos_", ",", "titulo_", ",", "nmax_"}], "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", "datos", "]"}], ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "nmax"}], "}"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLegends", "->", "etiquetas"}], ",", 
     RowBox[{"PlotLabel", "->", "titulo"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Tama\[NTilde]o del espacio\>\"", ",", "\"\<Reglas\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "16"}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"210569cc-8241-402a-953d-c10b85d54a7c"],


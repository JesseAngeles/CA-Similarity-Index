Cell[CellGroupData[{

Cell["Resultados", "Subsection",ExpressionUUID->"e763b5a5-8520-4d44-b2f8-c613e59c6122"],

Cell["\<\
El n\[UAcute]mero de clases depende de la ventana K: un ciclo de longitud L > \
K nunca aparece en el vector. Con K = 10 (el valor usado en el paper) los \
tama\[NTilde]os con ciclos largos pierden mucha informaci\[OAcute]n: n = 11, \
13, 17, 19, 23 y 29 dan entre 31 y 34 clases, y n = 22 y 26 dan 40. Con n \
compuesto los ciclos cortos dominan y K = 10 ya da entre 64 y 72 clases. El m\
\[AAcute]ximo con K = 10 es 72 (n = 12 y 24).\
\>", "Text",ExpressionUUID->"bdd83ea6-b9c4-4c57-afb2-a99a5c8285e0"],

Cell["\<\
Al crecer K el n\[UAcute]mero de clases se acerca al de los eigenvalores: con \
K = 60 coincide en 17 de los 29 tama\[NTilde]os, y nunca lo supera, porque \
los momentos son una funci\[OAcute]n del espectro. Con n \[LessEqual] 4 todos \
los ciclos caben en la ventana y el resultado no depende de K.\
\>", "Text",ExpressionUUID->"f7ad2574-f939-46a7-9ad5-4b41ddce4e3c"],

Cell["\<\
Combinando los 29 tama\[NTilde]os se obtienen 77 clases con cualquier K = 10, \
20, 30 o 60, igual que con los eigenvalores: siempre tienen el mismo vector \
{0, 8}, {1, 19}, {2, 24, 46}, {4, 12}, {18, 126}, {36, 72}, {128, 136}, {130, \
152}, {132, 140} y {162, 168}. Los momentos heredan la ceguera a los \
transitorios del espectro.\
\>", "Text",ExpressionUUID->"9acdfad6-8aa9-4270-9aec-b4146370bb70"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Momentos espectrales del cociente por rotaciones: 88 reglas, n = 1, \
\[Ellipsis], 29\
\>", "Section",ExpressionUUID->"970e3256-09f9-45fb-926a-ecca40078812"],

Cell["\<\
Mismos momentos espectrales, pero sobre el grafo cociente por rotaciones: m_k \
es la fracci\[OAcute]n de clases de rotaci\[OAcute]n [x] con G^k([x]) = [x], \
donde G es la funci\[OAcute]n inducida en el cociente. Cada clase cuenta como \
un nodo y el vector se normaliza por el n\[UAcute]mero de clases (unos \
2^n/n). Es la definici\[OAcute]n que da los 63 vectores distintos con n = 14 \
y K = 10 que se reportan en el paper (63 tambi\[EAcute]n entre las 88 reglas \
representantes).\
\>", "Text",ExpressionUUID->"87d41593-bb5e-430c-b317-1e98c1781775"],

Cell["\<\
Los momentos se calculan en forma exacta a partir de los histogramas de \
ciclos del cociente de la secci\[OAcute]n anterior (eigRotData); si no est\
\[AAcute] cargado, CyclesRotFor los calcula con AllocateQuotient y \
EigenvaluesRotGPU. Igual que sin cocientar, se guardan los vectores con K = \
60 y se cuentan las clases con K = 10, 20, 30 y 60.\
\>", "Text",ExpressionUUID->"f84198c8-72b3-4a7e-944b-8cfb7aca3c87"],

Cell["\<\
Validaci\[OAcute]n: para n = 1..8 los primeros 20 momentos de las 88 reglas \
coinciden con el conteo directo de las clases con G^k([x]) = [x], \
construyendo el cociente e iter\[AAcute]ndolo en CPU.\
\>", "Text",ExpressionUUID->"ee05cace-9202-4266-9855-e3137394d08d"],

Cell[CellGroupData[{

Cell["Funciones", "Subsection",ExpressionUUID->"984168bf-42a2-4fc8-a8bc-59e0e228d96a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Histograma", " ", "de", " ", "ciclos", " ", "del", " ", 
      RowBox[{"cociente", ":", " ", 
       RowBox[{
       "se", " ", "reutiliza", " ", "el", " ", "de", " ", "eigRotData", " ", 
        RowBox[{"(", 
         RowBox[{"misma", " ", "GPU"}], ")"}], " ", "si", " ", "existe"}]}]}],
      ";", " ", 
     RowBox[{"si", " ", "no"}]}], ",", " ", 
    RowBox[{
    "se", " ", "calcula", " ", "con", " ", "AllocateQuotient", " ", "y", " ", 
     
     RowBox[{"EigenvaluesRotGPU", ".", " ", "Cada"}], " ", "clase", " ", "de",
      " ", "rotaci\[OAcute]n", " ", "cuenta", " ", "como", " ", "un", " ", 
     "nodo", " ", "y", " ", "se", " ", "normaliza", " ", "por", " ", "el", " ",
      "n\[UAcute]mero", " ", "de", " ", "clases"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"CyclesRotFor", "[", 
     RowBox[{"r_Integer", ",", "n_Integer"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"AssociationQ", "[", "eigRotData", "]"}], "&&", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"eigRotData", ",", "n"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"eigRotData", "[", "n", "]"}], "[", "\"\<Rules\>\"", "]"}],
           ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<Rule\>\"", "]"}], "==", "r"}], "&"}]}], 
         "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"\"\<Cycles\>\"", ",", "\"\<Nodes\>\""}], "}"}], "]"}], 
       "]"}], ",", 
      RowBox[{
       RowBox[{"EigenvaluesRotGPU", "[", 
        RowBox[{"r", ",", 
         RowBox[{"AllocateQuotient", "[", "n", "]"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"\"\<Cycles\>\"", ",", "\"\<Nodes\>\""}], "}"}], "]"}], 
       "]"}]}], "]"}]}], ";"}]}]], "Input",ExpressionUUID->"330ec043-cbe9-\
4e00-9205-99dac41e762a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Experimento", "Subsection",ExpressionUUID->"e4dc1e59-2613-482b-a8ed-05d4a9baf8f5"],

Cell["\<\
Cada tama\[NTilde]o se guarda en spectral_moments_rot_gpu_data.wl. Requiere \
SpectralMomentsExact y smKs de la secci\[OAcute]n anterior, y eigRotData de \
la secci\[OAcute]n de eigenvalores del cociente (o sus funciones para \
recalcular los histogramas).\
\>", "Text",ExpressionUUID->"9e80fbd9-efd6-49b4-ab5c-1e2040dc640e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataFileSMRot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<spectral_moments_rot_gpu_data.wl\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"smRotResults", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileSMRot", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileSMRot", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"smRotResults", ",", "n"}], "]"}]}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rows", ",", "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"c", "=", 
                   RowBox[{"CyclesRotFor", "[", 
                    RowBox[{"r", ",", "n"}], "]"}]}], "}"}], ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Rule\>\"", "->", "r"}], ",", 
                   RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
                   RowBox[{"\"\<Nodes\>\"", "->", 
                    RowBox[{"c", "[", "\"\<Nodes\>\"", "]"}]}], ",", 
                   RowBox[{"\"\<Moments\>\"", "->", 
                    RowBox[{"SpectralMomentsExact", "[", 
                    RowBox[{
                    RowBox[{"c", "[", "\"\<Cycles\>\"", "]"}], ",", 
                    RowBox[{"c", "[", "\"\<Nodes\>\"", "]"}], ",", 
                    RowBox[{"Max", "[", "smKs", "]"}]}], "]"}]}]}], "|>"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}], 
           "]"}]}], ";", 
         RowBox[{
          RowBox[{"smRotResults", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Nodes\>\"", "->", 
             RowBox[{"rows", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "\"\<Nodes\>\""}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"CountDistinct", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{"#", ",", "K"}], "]"}], "&"}], "/@", 
                   RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Moments\>\""}], "]"}], "]"}]}], 
                  "]"}]}], "]"}], ",", "smKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"Values", "[", 
                  RowBox[{"GroupBy", "[", 
                   RowBox[{"rows", ",", 
                    RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Moments\>\"", "]"}], ",", "K"}], 
                    "]"}], "&"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], 
                    "&"}]}], "]"}], "]"}]}], "]"}], ",", "smKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         RowBox[{"Put", "[", 
          RowBox[{"smRotResults", ",", "dataFileSMRot"}], "]"}]}]}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", 
       RowBox[{"#", "[", "\"\<n\>\"", "]"}]}], ",", 
      RowBox[{"\"\<Nodes\>\"", "->", 
       RowBox[{"#", "[", "\"\<Nodes\>\"", "]"}]}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<K = \>\"", "<>", 
             RowBox[{"ToString", "[", "#1", "]"}]}], ")"}], "->", "#2"}], 
          "&"}], ",", 
         RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "]"}]}]}], "|>"}], 
    "&"}], "/@", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "smRotResults", "]"}], "]"}]}], "]"}]}], "Input",E\
xpressionUUID->"5d39b8b9-4ea5-405e-8574-1d9a7f966e52"],


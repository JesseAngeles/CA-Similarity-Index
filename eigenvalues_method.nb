Cell["\<\
VAMOS A USA gAll. Las agrupaciones obtenidas por las reducciones de estados \
son validas, las vamos a considerar dentro de la misma clasificaci\[OAcute]n. \
Ahora el momento es comparar gEcahist y gEcahistrot\
\>", "Text",
 CellChangeTimes->{{3.9994691905046062`*^9, 
  3.9994692378555307`*^9}},ExpressionUUID->"bec0a2ad-25d2-443a-9eac-\
b1e7537cb32d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UniqueElements", "[", 
   RowBox[{"{", 
    RowBox[{"gAll", ",", "gEcahist"}], "}"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.999469239649304*^9, 3.999469257264583*^9}, {
  3.999469791418332*^9, 3.999469792377618*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"d8083fd8-a2db-4c54-81f8-f963cbd1a040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Para", " ", "cada", " ", "grupo", " ", "de", " ", "\"\<grandes\>\""}], ":", 
     RowBox[{
     "que", " ", "grupos", " ", "de", " ", "\"\<chicos\>\"", " ", "caen", " ",
       "completos", " ", "dentro"}]}], ",", 
    RowBox[{"si", " ", "lo", " ", "cubren", " ", "exactamente"}], ",", 
    RowBox[{
    "y", " ", "cuales", " ", "lo", " ", "cruzan", " ", "parcialmente"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Descomponer", "[", 
      RowBox[{"grandes_List", ",", "chicos_List"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dentro", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"chicos", ",", 
             RowBox[{
              RowBox[{"SubsetQ", "[", 
               RowBox[{"g", ",", "#"}], "]"}], "&"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Grupo\>\"", "->", "g"}], ",", 
           RowBox[{"\"\<Partes\>\"", "->", "dentro"}], ",", 
           RowBox[{"\"\<NPartes\>\"", "->", 
            RowBox[{"Length", "[", "dentro", "]"}]}], ",", 
           RowBox[{"\"\<Exacto\>\"", "->", 
            RowBox[{
             RowBox[{"Sort", "[", 
              RowBox[{"Flatten", "[", "dentro", "]"}], "]"}], "===", 
             RowBox[{"Sort", "[", "g", "]"}]}]}], ",", 
           RowBox[{"\"\<Cruzados\>\"", "->", 
            RowBox[{"Select", "[", 
             RowBox[{"chicos", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"IntersectingQ", "[", 
                 RowBox[{"g", ",", "#"}], "]"}], "&&", 
                RowBox[{"!", 
                 RowBox[{"SubsetQ", "[", 
                  RowBox[{"g", ",", "#"}], "]"}]}], "&&", 
                RowBox[{"!", 
                 RowBox[{"SubsetQ", "[", 
                  RowBox[{"#", ",", "g"}], "]"}]}]}], "&"}]}], "]"}]}]}], 
          "|>"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"g", ",", "grandes"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dA", "=", 
     RowBox[{"Descomponer", "[", 
      RowBox[{"gAll", ",", "gEcahist"}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
    "gAll", " ", "partido", " ", "en", " ", "grupos", " ", "de", " ", 
     "gEcahist"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dE", "=", 
     RowBox[{"Descomponer", "[", 
      RowBox[{"gEcahist", ",", "gAll"}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
    "gEcahist", " ", "partido", " ", "en", " ", "grupos", " ", "de", " ", 
     "gAll"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"dA", ",", 
      RowBox[{
       RowBox[{"#Exacto", "&&", 
        RowBox[{"#NPartes", ">", "1"}]}], "&"}]}], "]"}], "   ", ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "grupos", " ", "de", " ", "gAll", " ", "hechos", " ", "de", " ", "varios",
      " ", "de", " ", "gEcahist"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"dE", ",", 
      RowBox[{
       RowBox[{"#Exacto", "&&", 
        RowBox[{"#NPartes", ">", "1"}]}], "&"}]}], "]"}], "   ", ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "grupos", " ", "de", " ", "gEcahist", " ", "hechos", " ", "de", " ", 
     "varios", " ", "de", " ", "gAll"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"dA", ",", 
      RowBox[{
       RowBox[{"#Cruzados", "=!=", 
        RowBox[{"{", "}"}]}], "&"}]}], "]"}], "          ", ";"}], 
   RowBox[{"(*", 
    RowBox[{"traslapes", " ", 
     RowBox[{"parciales", ":", 
      RowBox[{"ninguno", " ", "contiene", " ", "al", " ", "otro"}]}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.999469872449997*^9, 3.999469880917058*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"0c6f03c9-c381-481e-9e83-3b3d5a8f814e"],


Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dir", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ld", "[", "f_", "]"}], ":=", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dir", ",", "f"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"seriesRot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "}"}], "&"}], "/@", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"ld", "[", "\"\<canonical_form_rot_gpu_data.wl\>\"", "]"}], 
        "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "}"}], "&"}], "/@", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"ld", "[", "\"\<eigenvalues_rot_gpu_data.wl\>\"", "]"}], 
        "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Classes\>\"", "]"}], "[", "10", "]"}]}], 
        "}"}], "&"}], "/@", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"ld", "[", "\"\<spectral_moments_rot_gpu_data.wl\>\"", "]"}], 
        "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Classes\>\"", "]"}], "[", "10", "]"}]}], 
        "}"}], "&"}], "/@", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"ld", "[", "\"\<attractor_mass_rot_gpu_data.wl\>\"", "]"}], 
        "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yScale", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "^", "3"}], "&"}], ",", "CubeRoot"}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"seriesRot", ",", 
   RowBox[{"PlotMarkers", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", "7"}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", "yScale"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Space size n\>\"", 
      ",", "\"\<Distinct classes (88 rules)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "20", ",", "40", ",", "60", ",", "70", ",", "80", ",", "84", ",", 
          "88"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"81", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<81 (4 inheritance)\>\"", ",", "10", ",", "Gray"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"88", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<88 (state permutation, mirror)\>\"", ",", "10", ",",
               "Gray"}], "]"}]}], "}"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"81", ",", "88"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLinesStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Gray", ",", "Dashed"}], "]"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Canonical form\>\"", ",", "\"\<Eigenvalues\>\"", 
          ",", "\"\<Spectral moments (K = 10)\>\"", 
          ",", "\"\<Attractor mass (K = 10)\>\""}], "}"}], ",", 
        RowBox[{"LegendLayout", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Row\>\"", ",", "2"}], "}"}]}]}], "]"}], ",", "Below"}],
      "]"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "90"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "600"}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<All methods on the rotation quotient graph (ECA)\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"f8e38b34-a705-498a-b953-e01e43e41879"],


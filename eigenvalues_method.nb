    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\"\<K = \>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
         "amKs"}], ",", 
        RowBox[{"LegendLayout", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Row\>\"", ",", "2"}], "}"}]}]}], "]"}], ",", "Below"}],
      "]"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 

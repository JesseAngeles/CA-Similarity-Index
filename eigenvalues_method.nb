Cell[CellGroupData[{

Cell["Experimento", "Subsection",ExpressionUUID->"b59aba1e-f3ff-4b9f-bd16-0f679d33de28"],

Cell["\<\
Cada tama\[NTilde]o se guarda en eigenvalues_rot_gpu_data.wl; si el archivo \
existe, solo se calculan los tama\[NTilde]os que faltan. Requiere la secci\
\[OAcute]n Funciones (sesi\[OAcute]n CUDA, ZerosInt32, cycleHistogramC), \
EigenSpectrum, ecaReps y nMax de la secci\[OAcute]n anterior.\
\>", "Text",ExpressionUUID->"413278cf-a1c3-4517-9a54-c26035ccfecf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataFileEigRot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<eigenvalues_rot_gpu_data.wl\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eigRotResults", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileEigRot", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileEigRot", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"eigRotResults", ",", "n"}], "]"}]}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"buf", "=", 
           RowBox[{"AllocateQuotient", "[", "n", "]"}]}], ",", "rows", ",", 
          "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"EigenvaluesRotGPU", "[", 
                RowBox[{"r", ",", "buf"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}], 
           "]"}]}], ";", 
         RowBox[{
          RowBox[{"eigRotResults", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Nodes\>\"", "->", 
             RowBox[{"buf", "[", "\"\<N\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"CountDistinct", "[", 
              RowBox[{"rows", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<Spectrum\>\""}], "]"}], "]"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"Values", "[", 
              RowBox[{"GroupBy", "[", 
               RowBox[{"rows", ",", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Spectrum\>\"", "]"}], "&"}], ",", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], 
                 "&"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         RowBox[{"Put", "[", 
          RowBox[{"eigRotResults", ",", "dataFileEigRot"}], "]"}]}]}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<n\>\"", ",", "\"\<Nodes\>\"", ",", "\"\<Classes\>\"", 
        ",", "\"\<Seconds\>\""}], "}"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "eigRotResults", "]"}], "]"}]}], "]"}]}], "Input",\
ExpressionUUID->"a421710d-93db-45fd-aa63-829e14de034d"],


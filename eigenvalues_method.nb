Cell[BoxData[{
 RowBox[{
  RowBox[{"ptsSMRot", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 

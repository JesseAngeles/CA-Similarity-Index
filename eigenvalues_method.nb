Cell[CellGroupData[{

Cell["Experimento", "Subsection",ExpressionUUID->"445938c3-4c8d-41ed-b347-4abf60f64ebb"],

Cell["\<\
Cada tama\[NTilde]o se guarda en attractor_mass_gpu_data.wl. Requiere la \
secci\[OAcute]n Funciones (sesi\[OAcute]n CUDA, SuccessorArrayGPU) y \
ecaReps/nMax de la secci\[OAcute]n de eigenvalores en GPU. Tiempo total: unos \
40 min (n = 29 tarda 21 min; el recorrido es en CPU).\
\>", "Text",ExpressionUUID->"c5222a28-9fc8-41ce-837e-27f9f6411fbe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataFileAM", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<attractor_mass_gpu_data.wl\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"amResults", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileAM", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileAM", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"amResults", ",", "n"}], "]"}]}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rows", ",", "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"AttractorMassGPU", "[", 
                RowBox[{"r", ",", "n"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}], 
           "]"}]}], ";", 
         RowBox[{
          RowBox[{"amResults", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"CountDistinct", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{"#", ",", "K"}], "]"}], "&"}], "/@", 
                   RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Moments\>\""}], "]"}], "]"}]}], 
                  "]"}]}], "]"}], ",", "amKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"K", ",", 
                 RowBox[{"Values", "[", 
                  RowBox[{"GroupBy", "[", 
                   RowBox[{"rows", ",", 
                    RowBox[{
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Moments\>\"", "]"}], ",", "K"}], 
                    "]"}], "&"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], 
                    "&"}]}], "]"}], "]"}]}], "]"}], ",", "amKs"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         RowBox[{"Put", "[", 
          RowBox[{"amResults", ",", "dataFileAM"}], "]"}]}]}], "]"}]}], "]"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", 
       RowBox[{"#", "[", "\"\<n\>\"", "]"}]}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<K = \>\"", "<>", 
             RowBox[{"ToString", "[", "#1", "]"}]}], ")"}], "->", "#2"}], 
          "&"}], ",", 
         RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "]"}]}]}], "|>"}], 
    "&"}], "/@", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "amResults", "]"}], "]"}]}], "]"}]}], "Input",Expr\
essionUUID->"bfe013a0-6027-47a8-bd6e-2ab3a53faa5a"],


     RowBox[{"\"\<Space size n\>\"", 
      ",", "\"\<Distinct spectral-moment vectors (88 rules)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "20", ",", "30", ",", "40", ",", "50", ",", "60", ",", "70", ",", 
          "74", ",", "88"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"81", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<81 (4 inheritance)\>\"", ",", "10", ",", "Gray"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"88", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<88 (state permutation, mirror)\>\"", ",", "10", ",",
               "Gray"}], "]"}]}], "}"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 

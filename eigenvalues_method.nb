     RowBox[{"\"\<Space size n\>\"", 
      ",", "\"\<Distinct attractor-mass vectors (88 rules)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 

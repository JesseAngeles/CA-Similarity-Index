     RowBox[{"Gray", ",", "Dashed"}], "]"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\"\<K = \>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
         "smKs"}], ",", 
        RowBox[{"LegendLayout", "->", "\"\<Row\>\""}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.5", ",", "0.645"}], "}"}], ",", 
        RowBox[{"{", 

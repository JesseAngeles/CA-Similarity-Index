Cell[CellGroupData[{

Cell["Comparaci\[OAcute]n de gAll contra los histogramas de ciclos", \
"Subsection",ExpressionUUID->"cf58f254-cf49-4634-9161-3cbee2f74c97"],

Cell[TextData[{
 Cell[BoxData["CompararClasificaciones"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "4b5833d6-4a29-4e85-9478-5b501a910a6e"],
 " une en un bloque todos los grupos de ambas clasificaciones que comparten \
reglas, y clasifica cada bloque seg\[UAcute]n cu\[AAcute]ntos grupos tiene de \
cada lado. As\[IAcute] cada regla cae en exactamente una de cuatro categor\
\[IAcute]as y la suma siempre da 256. "
}], "Text",ExpressionUUID->"01a48592-9498-431d-9b09-9700f8c42c26"],

Cell["Coinciden: un grupo de A y un grupo de B, id\[EAcute]nticos.", "Item",ExpressionUUID->"bb9dc1b2-5bcf-448d-87c4-34579d9dda05"],

Cell["\<\
A junta, B separa: un grupo de A partido en varios grupos de B.\
\>", "Item",ExpressionUUID->"f03937bc-dcd9-4dfc-82ec-53d1fcb79d77"],

Cell["\<\
A separa, B junta: varios grupos de A unidos en un grupo de B.\
\>", "Item",ExpressionUUID->"1d16476c-e45a-4816-ac75-a49ddd745bfc"],

Cell[CellGroupData[{

Cell["\<\
Cruzados: varios grupos de cada lado que se traslapan sin que ninguno \
contenga al otro.\
\>", "Item",ExpressionUUID->"937c7f00-2c2b-4c4f-af81-0953c69d1608"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Une", " ", "grupos", " ", "de", " ", "ambas", " ", "clasificaciones", " ",
       "que", " ", "comparten", " ", "reglas"}], ";", " ", 
     RowBox[{
      RowBox[{
      "cada", " ", "bloque", " ", "se", " ", "clasifica", "\n", "   ", 
       "segun", " ", "cuantos", " ", "grupos", " ", "de", " ", "cada", " ", 
       "lado", " ", 
       RowBox[{"contiene", ".", " ", "A"}]}], " ", "=", " ", 
      RowBox[{"primera", " ", "lista"}]}]}], ",", " ", 
    RowBox[{"B", " ", "=", " ", "segunda"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CompararClasificaciones", "[", 
      RowBox[{"gA_List", ",", "gB_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nodos", ",", "aristas", ",", "comps"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"nodos", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<A\>\"", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "gA", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Thread", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<B\>\"", ",", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "gB", "]"}], "]"}]}], "}"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"aristas", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"IntersectingQ", "[", 
               RowBox[{
                RowBox[{"gA", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"gB", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<A\>\"", ",", "i"}], "}"}], " ", "<->", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<B\>\"", ",", "j"}], "}"}]}], ",", "Nothing"}], 
             "]"}], ",", "\[IndentingNewLine]", "     ", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "gA", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"Length", "[", "gB", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", "  ", 
        RowBox[{"comps", "=", 
         RowBox[{"ConnectedComponents", "[", 
          RowBox[{"Graph", "[", 
           RowBox[{"nodos", ",", "aristas"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"c", ",", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"a", "=", 
                 RowBox[{"gA", "[", 
                  RowBox[{"[", 
                   RowBox[{"Cases", "[", 
                    RowBox[{"c", ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"\<A\>\"", ",", "i_"}], "}"}], ":>", "i"}]}], 
                    "]"}], "]"}], "]"}]}], ",", 
                RowBox[{"b", "=", 
                 RowBox[{"gB", "[", 
                  RowBox[{"[", 
                   RowBox[{"Cases", "[", 
                    RowBox[{"c", ",", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"\<B\>\"", ",", "j_"}], "}"}], ":>", "j"}]}], 
                    "]"}], "]"}], "]"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", "      ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Tipo\>\"", "->", 
                 RowBox[{"Which", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "a", "]"}], "==", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"Length", "[", "b", "]"}], "==", "1"}]}], 
                   ",", "\"\<Coinciden\>\"", ",", "\[IndentingNewLine]", 
                   "         ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "b", "]"}], ">", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"Length", "[", "a", "]"}], "==", "1"}]}], 
                   ",", "\"\<A junta, B separa\>\"", ",", 
                   "\[IndentingNewLine]", "         ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "a", "]"}], ">", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"Length", "[", "b", "]"}], "==", "1"}]}], 
                   ",", "\"\<A separa, B junta\>\"", ",", 
                   "\[IndentingNewLine]", "         ", "True", 
                   ",", "\"\<Cruzados\>\""}], "]"}]}], ",", 
                "\[IndentingNewLine]", "       ", 
                RowBox[{"\"\<Reglas\>\"", "->", 
                 RowBox[{"Sort", "[", 
                  RowBox[{"Flatten", "[", "a", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<GruposA\>\"", "->", "a"}], ",", 
                RowBox[{"\"\<GruposB\>\"", "->", "b"}]}], "|>"}]}], "]"}]}], 
           "]"}], ",", "comps"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bloques", "=", 
     RowBox[{"CompararClasificaciones", "[", 
      RowBox[{"gAll", ",", "gEcahist"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"cuenta", "=", 
    RowBox[{
     RowBox[{"Length", "@*", "Flatten"}], " ", "/@", " ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"bloques", ",", 
       RowBox[{"#Tipo", " ", "&"}], ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<Reglas\>\""}], "]"}], "]"}], " ", "&"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Total", "[", "cuenta", "]"}]}]}]], "Input",ExpressionUUID->\
"31432ef9-efd0-4889-bc6d-fccac001278b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Cruzados\"\>", "\[Rule]", "28"}], ",", 
   RowBox[{"\<\"A separa, B junta\"\>", "\[Rule]", "56"}], ",", 
   RowBox[{"\<\"A junta, B separa\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"Coinciden\"\>", "\[Rule]", "160"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"f36358e6-18da-4d98-acb4-\
880c4dda5414"],

Cell[BoxData["256"], "Output",ExpressionUUID->"a4b575c8-97f8-49ef-b841-3886ecfaf9fe"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Conteo de las cuatro categor\[IAcute]as para cada tama\[NTilde]o del \
espacio, sin cocientar (",
 Cell[BoxData["ecaHist"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "5d1c55d2-d957-492f-9dc8-46b471ef7215"],
 ") y cocientado por rotaciones (",
 Cell[BoxData["ecaHistRot"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "e6417380-9ed1-4402-8c68-167fa1df6066"],
 "), siempre contra ",
 Cell[BoxData["gAll"], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",ExpressionUUID->
  "91f5a045-aa22-4916-b5a5-ff4515fe6ccb"],
 ". "
}], "Text",ExpressionUUID->"11fab646-d06f-405f-a651-f3c6d381f3ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Agrupa", " ", "las", " ", "256", " ", "ECA", " ", "por", " ", 
     "histograma", " ", "identico"}], ",", " ", 
    RowBox[{"en", " ", "la", " ", "notacion", " ", 
     RowBox[{"Subscript", "[", 
      RowBox[{"r", ",", " ", "2", ",", " ", "3"}], "]"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GruposHist", "[", "h_List", "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"#", ",", "2", ",", "3"}], "]"}], " ", "&"}], ",", 
       RowBox[{"Values", "[", 
        RowBox[{"GroupBy", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "255"}], "]"}], "->", "h"}], "]"}], ",", 
          RowBox[{"Last", "->", "First"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"categorias", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Coinciden\>\"", ",", "\"\<A junta, B separa\>\"", 
       ",", "\"\<A separa, B junta\>\"", ",", "\"\<Cruzados\>\""}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"etiquetas", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Coinciden\>\"", 
       ",", "\"\<gAll junta, histograma separa\>\"", 
       ",", "\"\<gAll separa, histograma junta\>\"", 
       ",", "\"\<Cruzados\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Numero", " ", "de", " ", "reglas", " ", "en", " ", "cada", " ", 
     "categoria", " ", "al", " ", "comparar", " ", "gAll", " ", "contra", " ",
      "una", " ", "clasificacion"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ConteoCategorias", "[", "gB_List", "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", "=", 
         RowBox[{
          RowBox[{"Length", "@*", "Flatten"}], " ", "/@", " ", 
          RowBox[{"GroupBy", "[", 
           RowBox[{
            RowBox[{"CompararClasificaciones", "[", 
             RowBox[{"gAll", ",", "gB"}], "]"}], ",", 
            RowBox[{"#Tipo", " ", "&"}], ",", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "\"\<Reglas\>\""}], "]"}], "]"}], " ", 
             "&"}]}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"Lookup", "[", 
        RowBox[{"c", ",", "categorias", ",", "0"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"conteoRaw", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ConteoCategorias", "[", 
        RowBox[{"GruposHist", "[", 
         RowBox[{"ecaHist", "[", "n", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "25"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"conteoRot", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ConteoCategorias", "[", 
        RowBox[{"GruposHist", "[", 
         RowBox[{"ecaHistRot", "[", "n", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "25"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PlotCategorias", "[", 
      RowBox[{"datos_", ",", "titulo_"}], "]"}], ":=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "datos", "]"}], ",", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "25"}], "}"}]}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"PlotLegends", "->", "etiquetas"}], ",", 
       RowBox[{"PlotLabel", "->", "titulo"}], ",", "\[IndentingNewLine]", 
       "   ", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Tama\[NTilde]o del espacio\>\"", 
          ",", "\"\<Reglas\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "256"}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}]}]}]], "Input",Expr\
essionUUID->"352b4901-77e5-4801-8d6f-e63869db7160"],


Cell[BoxData[
 RowBox[{
  RowBox[{"CanonFuncGraph", "[", "f_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "f", "]"}]}], ",", "indeg", ",", "preds", ",", 
      "code", ",", "queue", ",", "visited", ",", "cycles"}], "}"}], ",", 
    RowBox[{
     RowBox[{"indeg", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"indeg", "[", 
         RowBox[{"[", 
          RowBox[{"f", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "++"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"preds", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"code", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"Null", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "codificaci\[OAcute]n", " ", "can\[OAcute]nica", " ", "de", " ", "los",
         " ", "\[AAcute]rboles"}], ",", 
       RowBox[{"pelando", " ", "hojas"}]}], "*)"}], 
     RowBox[{"queue", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{"indeg", ",", "0"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"queue", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "=", 
           RowBox[{"First", "[", "queue", "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"queue", "=", 
           RowBox[{"Rest", "[", "queue", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"code", "[", 
            RowBox[{"[", "v", "]"}], "]"}], "=", 
           RowBox[{"{", 
            RowBox[{"Sort", "[", 
             RowBox[{"preds", "[", 
              RowBox[{"[", "v", "]"}], "]"}], "]"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w", "=", 
              RowBox[{"f", "[", 
               RowBox[{"[", "v", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{"preds", "[", 
                RowBox[{"[", "w", "]"}], "]"}], ",", 
               RowBox[{"code", "[", 
                RowBox[{"[", "v", "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"--", 
                 RowBox[{"indeg", "[", 
                  RowBox[{"[", "w", "]"}], "]"}]}], "==", "0"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"queue", ",", "w"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"los", " ", "nodos", " ", "con", " ", "indeg"}], ">", 
       RowBox[{
       "0", " ", "restante", " ", "est\[AAcute]n", " ", "en", " ", 
        "ciclos"}]}], "*)"}], 
     RowBox[{"visited", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", "n"}], "]"}]}], ";", 
     RowBox[{"cycles", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"indeg", "[", 
            RowBox[{"[", "v", "]"}], "]"}], ">", "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{"visited", "[", 
            RowBox[{"[", "v", "]"}], "]"}]}]}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", "=", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"w", "=", "v"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"visited", "[", 
                RowBox[{"[", "w", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"visited", "[", 
                 RowBox[{"[", "w", "]"}], "]"}], "=", "True"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"c", ",", "w"}], "]"}], ";", 
               RowBox[{"w", "=", 
                RowBox[{"f", "[", 
                 RowBox[{"[", "w", "]"}], "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"cycles", ",", "c"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"llave", ":", 
        RowBox[{"por", " ", "ciclo"}]}], ",", 
       RowBox[{
       "rotaci\[OAcute]n", " ", "lexicogr\[AAcute]ficamente", " ", 
        "m\[IAcute]nima", " ", "de", " ", "los", " ", "c\[OAcute]digos"}]}], 
      "*)"}], 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"seq", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Sort", "[", 
                 RowBox[{"preds", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], "}"}], "&"}], "/@", 
              "#"}], ")"}]}], "}"}], ",", 
          RowBox[{"First", "@", 
           RowBox[{"Sort", "@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"seq", ",", "j"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Length", "[", "seq", "]"}]}], "}"}]}], "]"}]}]}]}], 
         "]"}], "&"}], "/@", "cycles"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.992869754351234*^9, 3.992869754351281*^9}, {

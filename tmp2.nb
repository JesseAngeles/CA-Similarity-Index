Cell["\<\
Vemos que las reglas de herencia incluso demuestra que 2 reglas si son \
iguales, porque, si hacemos el fusions con gr23s13 vemos que el ultimo \
elemento, que combina uno de 2 y uno de 4 en realidad muestra que 2 reglas si \
estan heredando. Ahora lo que nos interesa saber es, que medaida de similitud \
podemos usar para comparar los grafos. ya vimos que esta medida nos dice si \
pertenecen al mismo \
\>", "Text",
 CellChangeTimes->{{3.992871201182983*^9, 3.9928713361958*^9}, 
   3.992872118877863*^9},ExpressionUUID->"e9a8f485-196c-4e0f-8946-\
6d930eada523"],

Cell[BoxData[
 RowBox[{
  RowBox[{"clases23", "=", "gr23s13"}], ";"}]], "Input",
 CellChangeTimes->{{3.992872678203458*^9, 3.992872679649066*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"f64dfc13-0c5c-476a-bf42-bb5ec4fb4d9e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"clases", "=", "gr23s4"}], ";"}], "                     ", 
  RowBox[{"(*", 
   RowBox[{"tu", " ", "lista", " ", "de", " ", "clases"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reps", "=", 
    RowBox[{"First", "/@", "clases"}]}], ";"}], "         ", 
  RowBox[{"(*", 
   RowBox[{"un", " ", "representante", " ", "por", " ", "clase"}], "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"perfiles", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PerfilPT", "[", 
      RowBox[{"TransMap", "[", 
       RowBox[{"r", ",", "n"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "3", ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "reps"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dtotal", "=", 
    RowBox[{"Mean", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"DistanciaPT", "[", 
           RowBox[{"#1", ",", "#2", ",", 
            RowBox[{"j", "+", "2"}]}], "]"}], "&"}], ",", 
         RowBox[{"perfiles", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"perfiles", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Similitud", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "5"}], " ", "Dtotal"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992872748182375*^9, 3.992872748182548*^9}, {

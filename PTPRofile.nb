          RowBox[{"ciclos", " ", "de", " ", "longitud", " ", "1"}], ")"}], " ",
          "y", " ", "un", "\n", "   ", "ciclo", " ", "de", " ", "longitud", " ",
          "8.", " ", "Los", " ", "16"}], " ", "-", " ", 

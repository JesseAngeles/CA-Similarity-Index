Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"comprobaci\[OAcute]n", " ", "2"}], ":", " ", 
    RowBox[{"el", " ", "espectro", " ", "completo", " ", "real", " ", 
     RowBox[{"(", 
      RowBox[{
      "Eigenvalues", " ", "de", " ", "la", "\n", "   ", "matriz", " ", "de", " ",
        "verdad"}], ")"}], " ", "debe", " ", "coincidir", " ", "con", 
     " ", "\"\<ra\[IAcute]ces de la unidad por\n   cada ciclo, m\[AAcute]s un \
0 por cada nodo transitorio\>\""}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"prediccion", "=", 
     RowBox[{"Join", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"2", " ", "Pi", " ", "I", " ", 
               RowBox[{"m", "/", "#"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "0", ",", 
               RowBox[{"#", "-", "1"}]}], "}"}]}], "]"}], ")"}], " ", "&"}], 
         " ", "/@", " ", 
         RowBox[{"CycleLengths", "[", "f30", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"Length", "[", "f30", "]"}], "-", 
          RowBox[{"Total", "[", 
           RowBox[{"CycleLengths", "[", "f30", "]"}], "]"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"real", "=", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"N", "[", 
       RowBox[{"Normal", "[", "A30", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"redondea", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Re", "[", "z", "]"}], ",", "0.0001"}], "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"Im", "[", "z", "]"}], ",", "0.0001"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"redondea", " ", "/@", " ", "real"}], "]"}], "===", 
    RowBox[{"Sort", "[", 
     RowBox[{"redondea", " ", "/@", " ", "prediccion"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"->", " ", "True"}], " ", "*)"}]}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"df8a3bf3-2d5d-4add-b100-1852aa874985"],


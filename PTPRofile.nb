Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"comprobaci\[OAcute]n", " ", "1"}], ":", " ", 
    RowBox[{
    "los", " ", "momentos", " ", "calculados", " ", "\"\<a mano\>\"", " ", 
     "desde", " ", "los", " ", "ciclos", "\n", "   ", "deben", " ", 
     "coincidir", " ", "EXACTAMENTE", " ", "con", " ", "tr", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "^", "j"}], ")"}], "/", "n"}], " ", "calculado", " ", 
     "con", " ", "\[AAcute]lgebra", "\n", "   ", "lineal", " ", "de", " ", 
     "verdad"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"A30", "=", 
     RowBox[{"AdjMatrix", "[", "f30", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentosPorTraza", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"A30", ",", "j"}], "]"}], "]"}], "]"}], "/", 
        RowBox[{"Length", "[", "f30", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"momentosPorCiclos", "=", 
     RowBox[{"SpectralMoments", "[", 
      RowBox[{"f30", ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"momentosPorTraza", "==", "momentosPorCiclos"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"->", " ", "True"}], " ", "*)"}]}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"a462e350-bdde-40f2-841b-730a929eef82"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.993825850457027*^9, 3.993826164075227*^9},

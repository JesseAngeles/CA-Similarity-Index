Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "=", "\n", "   ", 
     RowBox[{"TransMapW", ":", " ", 
      RowBox[{
      "generaliza", " ", "TransMapK", " ", "a", " ", "cualquier", " ", 
       "tama\[NTilde]o", " ", "de", " ", "vecindad", " ", "w"}]}]}], ",", 
    "\n", "   ", 
    RowBox[{
     RowBox[{"incluyendo", " ", "w", " ", "PAR", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vecindad", " ", "no", " ", 
          RowBox[{"sim\[EAcute]trica", " ", "--"}], " ", "necesario", " ", 
          "en", " ", "la", " ", "secci\[OAcute]n", "\n", "   ", "10"}], ",", 
         " ", 
         RowBox[{
         "donde", " ", "aparecen", " ", "reglas", " ", "de", " ", "vecindad", 
          " ", "2", " ", "producidas", " ", "por", " ", "reducci\[OAcute]n", "\n",
           "   ", "algebraica"}]}], ")"}], ".", " ", "Para"}], " ", "w", " ", 
      "impar", " ", "el", " ", "resultado", " ", "es", " ", 
      "id\[EAcute]ntico", " ", "al", " ", "caso", "\n", "   ", 
      "sim\[EAcute]trico", " ", "de", " ", "siempre"}], ";", " ", 
     RowBox[{"para", " ", "w", " ", "par"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "la", " ", "ventana", " ", "queda", " ", "recargada", " ", "1", "\n", 
      "   ", "celda", " ", "hacia", " ", "la", " ", "derecha", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "una", " ", "elecci\[OAcute]n", " ", "arbitraria", " ", "pero", " ", 
         "consistente"}], ")"}], ".", "\n", "   ", "R_"}], 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"TransMapW", "[", 
        RowBox[{"rule", ",", " ", "2", ",", " ", "3", ",", " ", "ncells"}], 
        "]"}], "  ", 
       RowBox[{"(", 
        RowBox[{"igual", " ", "que", " ", "TransMapK"}], ")"}], "\n", "   ", 
       "R_", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1"}], "}"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"TransMapW", "[", 
          RowBox[{"rule", ",", " ", "3", ",", " ", "1", ",", " ", "ncells"}], 
          "]"}], "  ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"vecindad", " ", "1"}], " ", "=", " ", 
            RowBox[{"sin", " ", "vecinos"}]}], ",", "\n", "             ", 
           RowBox[{
           "la", " ", "nueva", " ", "celda", " ", "solo", " ", "depende", " ",
             "de", " ", "s\[IAcute]", " ", "misma"}]}], ")"}]}], "\n", "   ", 
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
        "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
        "==="}], "="}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TransMapW", "[", 
      RowBox[{
      "ruleNumber_Integer", ",", "k_Integer", ",", "w_Integer", ",", 
       "ncells_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "lo", ",", "offsets", ",", "tbl", ",", "configs", ",", "idx", ",", 
         "succDigits"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"lo", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"w", "-", "1"}], ")"}], "/", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"offsets", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "lo"}], ",", 
           RowBox[{"w", "-", "1", "-", "lo"}]}], "]"}]}], ";", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"longitud", " ", "w"}], ",", " ", 
          RowBox[{"izquierda", " ", "a", " ", "derecha"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"tbl", "=", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"ruleNumber", ",", "k", ",", 
           RowBox[{"k", "^", "w"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"configs", "=", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{"k", "-", "1"}]}], "]"}], ",", "ncells"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"idx", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "^", 
             RowBox[{"(", 
              RowBox[{"w", "-", "i"}], ")"}]}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"RotateLeft", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"offsets", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
               " ", "configs"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "w"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"succDigits", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tbl", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"k", "^", "w"}], "-", "#"}], "]"}], "]"}], " ", "&"}], 
           ",", "idx", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FromDigits", "[", 
             RowBox[{"#", ",", "k"}], "]"}], " ", "&"}], ",", "succDigits"}], 
          "]"}], "+", "1"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"comprobaci\[OAcute]n", ":", " ", 
      RowBox[{"con", " ", "w"}]}], "=", 
     RowBox[{"3", " ", 
      RowBox[{"(", "impar", ")"}], " ", "debe", " ", "coincidir", " ", "con", 
      " ", "TransMapK"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TransMapW", "[", 
     RowBox[{"30", ",", "2", ",", "3", ",", "2"}], "]"}], "==", 
    RowBox[{"TransMapK", "[", 
     RowBox[{"30", ",", "2", ",", "2"}], "]"}]}]}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"79d80067-f4fb-4537-87b8-43f568a186ac"],


 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"cosineSim", " ", 
    RowBox[{"segura", ":", " ", 
     RowBox[{
     "si", " ", "alguno", " ", "de", " ", "los", " ", "dos", " ", "vectores", 
      " ", "de", " ", "momentos", " ", "sale", "\n", "   ", "todo", " ", 

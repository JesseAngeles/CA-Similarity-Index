Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "=", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Funciones", " ", "de", " ", 
       RowBox[{"report", ".", "nb"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"secci\[OAcute]n", " ", "\"\<Relation generator\>\""}], 
         ")"}], ".", " ", "Se"}], " ", "copian", "\n", "   ", "aqu\[IAcute]", 
       " ", "tal", " ", "cual", " ", "para", " ", "que", " ", "este", " ", 
       "notebook", " ", "siga", " ", "siendo", " ", 
       RowBox[{"autocontenido", "."}]}], "\n", "   ", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "==="}], "="}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getRules", "[", 
      RowBox[{"s_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"#", ",", "s", ",", "n"}], "]"}], " ", "&"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"s", "^", 
           RowBox[{"(", 
            RowBox[{"s", "^", "n"}], ")"}]}], "-", "1"}]}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"InverseRules", "[", "ca_Subscript", "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"s", "=", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"n", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ca", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "1"}], ")"}], "/", "2"}]}],
          ",", 
         RowBox[{"L", "=", 
          RowBox[{
           RowBox[{"ca", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", 
           RowBox[{"ca", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], ",", "outputs", ",", "tuples",
          ",", "perms", ",", "res"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"outputs", "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"r", ",", "s", ",", "L"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"tuples", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerDigits", "[", 
            RowBox[{"#", ",", "s", ",", 
             RowBox[{
              RowBox[{"2", " ", "n"}], "+", "1"}]}], "]"}], " ", "&"}], " ", "/@",
           " ", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"L", "-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"perms", "=", 

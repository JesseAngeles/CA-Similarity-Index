Cell["paso. ", "Text",ExpressionUUID->"fcd2b29e-d8ac-4ed7-bf35-4de798c08d43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "=", "\n", "   ", 
     RowBox[{"TransMapK", ":", " ", 
      RowBox[{"generaliza", " ", "tu", " ", 
       RowBox[{"TransMap", "[", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"n", ",", "2", ",", "3"}], "]"}], ",", " ", "space"}], 
        "]"}], " ", "a", "\n", "   ", "cualquier", " ", "n\[UAcute]mero", " ",
        "de", " ", "estados", " ", "k", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"no", " ", "solo", " ", "binario"}], ")"}], ".", "\n", "   ", 
        RowBox[{"-", " ", "ruleNumber"}]}]}], ":", " ", 
      RowBox[{
      "el", " ", "\"\<n\[UAcute]mero de regla\>\"", " ", "al", " ", "estilo", 
       " ", "Wolfram"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"en", " ", "base", " ", "k"}], "\n", "   ", "-", " ", 
      RowBox[{"k", ":", " ", 
       RowBox[{
        RowBox[{"n\[UAcute]mero", " ", "de", " ", "estados", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "=", " ", "binario"}], ",", " ", 
           RowBox[{"3", " ", "=", " ", "ternario"}], ",", " ", "..."}], 
          ")"}]}], "\n", "   ", "-", " ", "ncells"}], ":", " ", 
       RowBox[{
       "cu\[AAcute]ntas", " ", "celdas", " ", "tiene", " ", "el", " ", 
        "anillo", "\n", "   ", "Devuelve", " ", 
        RowBox[{"f_List", ":", " ", 
         RowBox[{"f", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[IAcute]ndice", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "indexado"}], ")"}], " ", "de", " ", "la", " ", 
        "configuraci\[OAcute]n", "\n", "   ", "sucesora", " ", "de", " ", 
        "la", " ", "configuraci\[OAcute]n", " ", 
        RowBox[{"i", ".", " ", "Misma"}], " ", "convenci\[OAcute]n", " ", 
        "que", " ", "PerfilPT", " ", "y", "\n", "   ", "CanonFuncGraph", " ", 
        "en", " ", 
        RowBox[{"tmp2", ".", "nb", "."}]}], "\n", "   ", "===", "===", "===", 
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
        "===", "===", "===", "===", "===", "===", "==="}], "="}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TransMapK", "[", 
      RowBox[{"ruleNumber_Integer", ",", "k_Integer", ",", "ncells_Integer"}],
       "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tbl", ",", "configs", ",", "idx", ",", "succDigits"}], "}"}],
        ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"tabla", " ", "de", " ", "la", " ", 
          RowBox[{"regla", ":", " ", 
           RowBox[{
            RowBox[{"k", "^", "3"}], " ", "entradas", " ", 
            RowBox[{"(", 
             RowBox[{"vecindad", " ", "de", " ", "3", " ", "celdas"}], 
             ")"}]}]}]}], ",", " ", 
         RowBox[{"la", "\n", "     ", "entrada", " ", 
          RowBox[{"tbl", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "corresponde", " ", "a", " ", 
          "la", " ", "vecindad", " ", "de", " ", "mayor", " ", "valor"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"tbl", "=", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"ruleNumber", ",", "k", ",", 
           RowBox[{"k", "^", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "todas", " ", "las", " ", "configuraciones", " ", "posibles"}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "como", " ", "listas", " ", "de", " ", "d\[IAcute]gitos", " ", 
              "0"}], ".."}], "k"}], "-", "1"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"configs", "=", 
         RowBox[{"Tuples", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{"k", "-", "1"}]}], "]"}], ",", "ncells"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"para", " ", "cada", " ", 
           RowBox[{"celda", ":", " ", 
            RowBox[{
             RowBox[{"combina", " ", "vecino"}], "-", "izquierdo"}]}]}], ",", 
          " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"centro", " ", "y", "\n", "     ", "vecino"}], "-", 
              RowBox[{"derecho", " ", 
               RowBox[{"(", 
                RowBox[{"con", " ", "envoltura", " ", "circular"}], ")"}], " ",
                "en", " ", "un", " ", "\[UAcute]nico", " ", "\[IAcute]ndice", 
               "\n", "     ", "0"}]}], ".."}], 
            RowBox[{"k", "^", "3"}]}], "-", "1"}], ",", " ", 
          RowBox[{
          "igual", " ", "que", " ", "hac\[IAcute]a", " ", "tu", " ", 
           "TransMap", " ", "original", " ", "pero", " ", "en", " ", "base", " ",
            "k"}]}], " ", "*)"}], "\[IndentingNewLine]", "  ", 
        RowBox[{"idx", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"RotateRight", " ", "/@", " ", "configs"}], ")"}]}], "+", 
          
          RowBox[{"k", " ", "configs"}], "+", 
          RowBox[{"(", 
           RowBox[{"RotateLeft", " ", "/@", " ", "configs"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "busca", " ", "en", " ", "la", " ", "tabla", " ", "el", " ", "nuevo",
           " ", "d\[IAcute]gito", " ", "de", " ", "cada", " ", "celda"}], " ",
          "*)"}], "\[IndentingNewLine]", "  ", 
        RowBox[{"succDigits", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tbl", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"k", "^", "3"}], "-", "#"}], "]"}], "]"}], " ", "&"}], 
           ",", "idx", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"convierte", " ", "cada", " ", "configuraci\[OAcute]n"}], 

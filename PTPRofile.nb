Cell[TextData[{
 "tama\[NTilde]o del espacio: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["n", "TI"]]], 
         RowBox[{
           StyleBox["t", "TI"], 
           StyleBox["r", "TI"]}], 
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["A", "TI"], 
            StyleBox["j", "TI"]], ")"}], ",    ", 
         StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["K", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m_j = \\frac{1}{k^n}\\operatorname{tr}(A^j), \\qquad j = 1,\\dots,K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "097b3040-147a-440b-bb37-facffb4d8a08"],
 "con ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "edf14dfb-2ccf-45ac-844e-482a158849d6"],
 " ",
 StyleBox["fijo",
  FontWeight->Bold],
 " (el mismo para cualquier ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4d66e53-cbfa-496a-a8c3-1ccef81eb3b3"],
 " y cualquier ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "168d6284-7e16-4589-97d4-23d29449fed4"],
 ": por ejemplo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", "12"}], TraditionalForm], 
     "errors" -> {}, "input" -> "K=12", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce9bee3f-64f5-4085-8ad5-f82a83318d48"],
 "). La ",
 StyleBox["traza",
  FontWeight->Bold],
 " de una matriz es la suma de su diagonal; para ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "A^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "183bd0f1-efff-45ce-8c8e-d245a47c69f2"],
 "resulta que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["t", "TI"], 
           StyleBox["r", "TI"]}], "(", 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["j", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\operatorname{tr}(A^j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2bc38f9b-dabb-4d0e-b399-7d264c95c72a"],
 " cuenta exactamente cu\[AAcute]ntas"
}], "Text",ExpressionUUID->"740c60d3-b57e-4ae9-a79e-43a43ff24ccc"],

Cell[TextData[{
 "configuraciones ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5eb65af6-f6a4-45c0-8cbf-aaf58eaae878"],
 " cumplen ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["f", "TI"], 
          StyleBox["j", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "f^j(x) = x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67570996-faf8-4838-8d4a-450a8885d649"],
 " (vuelven a s\[IAcute] mismas tras ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["j", "TI"], TraditionalForm], "errors" -> {}, "input" -> "j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9567140d-9449-42c8-b7a1-a588f92eae75"],
 "pasos) \[LongDash] es decir, cu\[AAcute]ntos puntos est\[AAcute]n sobre un \
ciclo cuya longitud divide a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["j", "TI"], TraditionalForm], "errors" -> {}, "input" -> "j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b82126bd-33b4-45d4-8bb9-37581b33703b"],
 ". As\[IAcute] que $m_j$ es simplemente: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["n", "TI"]]], 
         UnderscriptBox["\[Sum]", 
          RowBox[{"ciclos ", 
            StyleBox["c", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["c", "TI"]], "\[CenterDot]", 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["L", "TI"], 
              StyleBox["c", "TI"]], " divide a ", 
             StyleBox["j", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "m_j = \\frac{1}{k^n}\\sum_{\\text{ciclos } c} L_c \\cdot [L_c \\text{ \
divide a } j]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4c85d78-47ba-43e4-84ac-7923419faadd"],
 "Nada de esto requiere \[AAcute]lgebra lineal: solo la lista de longitudes \
de ciclo"
}], "Text",ExpressionUUID->"ab39564d-2fa4-4f1b-b63a-840007bb3727"],

Cell[TextData[{
 "que ya calculas hoy. Y como ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["j", "TI"], TraditionalForm], "errors" -> {}, "input" -> "j", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b981bd44-c7a1-4d0e-b1b4-1ca5da8a6c33"],
 " solo llega hasta ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "760d261a-155f-4e19-b65c-1d052e77c2be"],
 " (fijo), el vector"
}], "Text",ExpressionUUID->"98d7c6f2-feff-40c6-a46b-5cb85ab531c9"],

Cell[TextData[{
 "resultante ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "1"], ",", "\[Ellipsis]", ",", 
           SubscriptBox[
            StyleBox["m", "TI"], 
            StyleBox["K", "TI"]]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(m_1,\\dots,m_K)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "551dbe02-ec57-4aa6-958e-3d0a70cdad78"],
 " **siempre tiene la misma longitud sin importar"
}], "Text",ExpressionUUID->"6a511fad-efa1-4616-9a97-09cffb41a91f"],

Cell["\<\
cu\[AAcute]ntos estados tenga la regla** \[LongDash] eso es justo lo que \

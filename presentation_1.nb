Cell[CellGroupData[{

Cell["Up to seven states", "Subsection",
 CellChangeTimes->{{3.699269751716757*^9, 3.699269753436467*^9}, 
   3.699269850923047*^9, 3.706294357396751*^9, {3.991531364362561*^9, 
   3.9915313660181437`*^9}, {3.991531497808271*^9, 3.9915315012380247`*^9}, {
   3.99153246394466*^9, 3.991532465092881*^9}, {3.991532740660738*^9, 
   3.991532744159006*^9}},ExpressionUUID->"1a755dd0-c0ed-4cf0-8439-\
b2e8f98c0324"],

Cell[TextData[{
 StyleBox["Behaviors per states. We can observe that all rules with ",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1380acc-4634-4379-a5d1-7fcc36bba304"],
 StyleBox[" states are a subset of the rules with ",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "+", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "n+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c6fc1ba-f067-46ef-a801-9f456bb6aaf7"],
 StyleBox[" states, with the difference that the new state is assigned a \
transition to 0",
  FontWeight->"Plain"]
}], "Text",
 CellChangeTimes->{
  3.6992697457019463`*^9, 3.6992698838436613`*^9, {3.70454744273073*^9, 

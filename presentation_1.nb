Cell[TextData[{
 "But rules ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["21", 
        RowBox[{"4", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "21_{4,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54f424f2-d5dd-4282-b57e-dc4d110c3ccb"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["13", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "13_{3,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80dcabf5-3157-4309-84a4-0eaabdcd583b"],
 " do not belong to the list of unique behaviors; however, we can apply the \
inverse function to find the representative of that behavior and discover \
where that pattern comes from."
}], "Text",

  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["31", 
        RowBox[{"5", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "31_{5,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4da907a2-6182-48c0-8425-a20d62aca660"],
 ", which if we remove the last transitions we obtain the following rules:"
}], "Text",

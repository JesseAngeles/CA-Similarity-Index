Cell[CellGroupData[{

Cell["State transitions", "Subsection",
 CellChangeTimes->{{3.699269751716757*^9, 3.699269753436467*^9}, 
   3.699269850923047*^9, 3.706294357396751*^9, {3.991531364362561*^9, 
   3.9915313660181437`*^9}, {3.991531497808271*^9, 3.9915315012380247`*^9}, {
   3.99153246394466*^9, 3.991532465092881*^9}, {3.991532740660738*^9, 
   3.991532744159006*^9}, {3.9915357959142942`*^9, 
   3.991535832769003*^9}},ExpressionUUID->"c8190989-2fb5-44b5-bc42-\
696605169eb4"],

Cell[TextData[{
 "There exists a mapping between rules that allows us to move between CA \
spaces. That is, we can move from rule ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], ",", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "0_{n,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "154ab67b-6528-4772-a212-61ac4c44f3eb"],
 " a la ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["0", 
        RowBox[{
          StyleBox["n", "TI"], "+", "1", ",", "1"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "0_{n+1,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cdfafdda-d026-4505-8641-35441537bef0"],
 " simply by adding a new state that points to state 0"
}], "Text",
 CellChangeTimes->{{3.9905821711022787`*^9, 3.990582318140648*^9}, {
  3.99058362245746*^9, 3.9905836302579536`*^9}, {3.991534487152961*^9, 
  3.991534505077414*^9}},ExpressionUUID->"047eaf01-4698-4822-a20e-\
513e822d9848"],


Cell["\<\
Podemos obtener una distancia calculando los valores propios de la matriz de \
transici\[OAcute]n de cada grafo y utilizar la distancia coseno para medir la \
diferencia entre dichas regalas:\
\>", "Text",
 CellChangeTimes->{{3.993007647023725*^9, 3.9930077214835033`*^9}, {
  3.993010981492392*^9, 
  3.993010982365555*^9}},ExpressionUUID->"40bf974f-1793-492d-b81a-\
c9627187ffff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"vecs", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"TransMap", "[", 
        RowBox[{"r", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "a", "]"}], ",", 
           RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"m", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", 
             RowBox[{"a", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}], 
         ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "\[IndentingNewLine]",
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Eigenvalues", "[", "m", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"r", ",", "r23"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distances", "=", 
   RowBox[{"DistanceMatrix", "[", 
    RowBox[{"vecs", ",", 
     RowBox[{"DistanceFunction", "->", "CosineDistance"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixPlot", "[", 

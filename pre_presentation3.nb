Notebook[{
Cell["\<\
Este notebook es para mostrar los avances. \[LineSeparator]Primero es decir \
que todo lo que hicimos fue construir lo de los grafos con diferentes \
espacios. 

usamos la funcion evos para obtener el mapeo las reglas proporcionadas con un \
tama\[NTilde]o de espacio determinado:\
\>", "Text",
 CellChangeTimes->{{3.992996482240649*^9, 3.992996558810171*^9}, {
  3.992996669969284*^9, 
  3.992996704422195*^9}},ExpressionUUID->"84bf8c89-989a-4917-ae52-\
68fb98621457"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evos", "[", 
   RowBox[{"rules_", ",", "space_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"conect", ",", "inits"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"inits", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"#", ",", "2", ",", "space"}], "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"2", "^", "space"}], "-", "1"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"conect", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"FromDigits", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CaArray", "[", 
                RowBox[{
                 RowBox[{"rules", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}],
                "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "2"}], "]"}], "->", 
            RowBox[{"FromDigits", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CaArray", "[", 
                RowBox[{
                 RowBox[{"rules", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}],
                "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "2"}], "]"}]}], "&"}], ",",
           "\[IndentingNewLine]", "inits"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rules", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", 
        RowBox[{"Graph", "[", "conect", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "rules", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.992760558625884*^9, 3.9927606977268953`*^9}, {
  3.99276075407198*^9, 3.9927607620311747`*^9}, {3.992760824992434*^9, 

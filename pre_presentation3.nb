Cell["\<\
Para saber si dos grafos son isomorficos, podemos obtener la forma canonica, \
si dos formas canonicas son iguales, entonces lso grafos son isomorficos.\
\[LineSeparator]\[LineSeparator]Pero primero, utilizamos la siguiente funci\
\[OAcute]n que optimiza la generaci\[OAcute]n de estos grafos, guardandolos \
como una sola lista y no como una matriz:\
\>", "Text",
 CellChangeTimes->{{3.992998031939357*^9, 3.992998034454434*^9}, {
  3.992998083288336*^9, 3.9929981236725082`*^9}, {3.992998791149275*^9, 
  3.9929988198794413`*^9}},ExpressionUUID->"0bfcde49-37ea-454d-92fa-\
38aaaa8c9f09"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TransMap", "[", 
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"n_", ",", "2", ",", "3"}], "]"}], ",", "space_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tbl", ",", "configs", ",", "idx"}], "}"}], ",", 
    RowBox[{
     RowBox[{"tbl", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"n", ",", "2", ",", "8"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"tabla", ":", 
        RowBox[{"vecindad", " ", "7"}]}], ",", "6", ",", "...", ",", "0"}], 
      "*)"}], 
     RowBox[{"configs", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"2", "^", "space"}], "-", "1"}]}], "]"}], ",", "2", ",", 
        "space"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"idx", "=", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"RotateRight", "/@", "configs"}], ")"}]}], "+", 
       RowBox[{"2", " ", "configs"}], "+", 
       RowBox[{"(", 
        RowBox[{"RotateLeft", "/@", "configs"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"sucesor", " ", "de", " ", "la", " ", "config", " ", "i", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"como", " ", "entero"}], ",", 
         RowBox[{"1", "-", "indexado"}]}], ")"}]}], "*)"}], 
     RowBox[{
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FromDigits", "[", 
          RowBox[{"#", ",", "2"}], "]"}], "&"}], ",", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tbl", "[", 
            RowBox[{"[", 
             RowBox[{"8", "-", "#"}], "]"}], "]"}], "&"}], ",", "idx", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "+", "1"}]}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9928697489568167`*^9, 3.9928697489568977`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"a17ee2d5-a24e-4ab1-a650-94755158ff05"],

Cell["\<\
Despues, usamos la siguiente funci\[OAcute]n para obtener la forma canonica \
de cada grafo:\
\>", "Text",
 CellChangeTimes->{{3.99299883000898*^9, 
  3.992998853721065*^9}},ExpressionUUID->"863ab48f-2d3f-4fd3-9a5f-\
1ba24f79fa94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CanonFuncGraph", "[", "f_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "f", "]"}]}], ",", "indeg", ",", "preds", ",", 
      "code", ",", "queue", ",", "visited", ",", "cycles"}], "}"}], ",", 
    RowBox[{
     RowBox[{"indeg", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"indeg", "[", 
         RowBox[{"[", 
          RowBox[{"f", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "++"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"preds", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"code", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"Null", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "codificaci\[OAcute]n", " ", "can\[OAcute]nica", " ", "de", " ", "los",
         " ", "\[AAcute]rboles"}], ",", 
       RowBox[{"pelando", " ", "hojas"}]}], "*)"}], 
     RowBox[{"queue", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{"indeg", ",", "0"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"queue", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"v", "=", 
           RowBox[{"First", "[", "queue", "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"queue", "=", 
           RowBox[{"Rest", "[", "queue", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"code", "[", 
            RowBox[{"[", "v", "]"}], "]"}], "=", 
           RowBox[{"{", 
            RowBox[{"Sort", "[", 
             RowBox[{"preds", "[", 
              RowBox[{"[", "v", "]"}], "]"}], "]"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w", "=", 
              RowBox[{"f", "[", 
               RowBox[{"[", "v", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{"preds", "[", 
                RowBox[{"[", "w", "]"}], "]"}], ",", 
               RowBox[{"code", "[", 
                RowBox[{"[", "v", "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"--", 
                 RowBox[{"indeg", "[", 
                  RowBox[{"[", "w", "]"}], "]"}]}], "==", "0"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"queue", ",", "w"}], "]"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"los", " ", "nodos", " ", "con", " ", "indeg"}], ">", 
       RowBox[{
       "0", " ", "restante", " ", "est\[AAcute]n", " ", "en", " ", 
        "ciclos"}]}], "*)"}], 
     RowBox[{"visited", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", "n"}], "]"}]}], ";", 
     RowBox[{"cycles", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"indeg", "[", 
            RowBox[{"[", "v", "]"}], "]"}], ">", "0"}], "&&", 
          RowBox[{"!", 
           RowBox[{"visited", "[", 
            RowBox[{"[", "v", "]"}], "]"}]}]}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c", "=", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"w", "=", "v"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"visited", "[", 
                RowBox[{"[", "w", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"visited", "[", 
                 RowBox[{"[", "w", "]"}], "]"}], "=", "True"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"c", ",", "w"}], "]"}], ";", 
               RowBox[{"w", "=", 
                RowBox[{"f", "[", 
                 RowBox[{"[", "w", "]"}], "]"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"cycles", ",", "c"}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"llave", ":", 
        RowBox[{"por", " ", "ciclo"}]}], ",", 
       RowBox[{
       "rotaci\[OAcute]n", " ", "lexicogr\[AAcute]ficamente", " ", 
        "m\[IAcute]nima", " ", "de", " ", "los", " ", "c\[OAcute]digos"}]}], 
      "*)"}], 
     RowBox[{"Sort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"seq", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Sort", "[", 
                 RowBox[{"preds", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], "}"}], "&"}], "/@", 
              "#"}], ")"}]}], "}"}], ",", 
          RowBox[{"First", "@", 
           RowBox[{"Sort", "@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"seq", ",", "j"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"Length", "[", "seq", "]"}]}], "}"}]}], "]"}]}]}]}], 
         "]"}], "&"}], "/@", "cycles"}], "]"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[159]:=",ExpressionUUID->"2b3fa2aa-8d88-4168-b4f4-ab3e52c66c73"],


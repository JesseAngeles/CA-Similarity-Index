       RowBox[{"{", 
        RowBox[{"r23", ",", "r23f"}], "}"}], "]"}], ",", 
      RowBox[{
       RowBox[{"CanonFuncGraph", "@*", "Last"}], "->", "First"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gr23s4", "[", 

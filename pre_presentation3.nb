Cell["\<\
O podemos verlo unicamente en los comportamientos unicos obtenidos con gr23s4:\
\>", "Text",
 CellChangeTimes->{{3.993007799015847*^9, 
  3.993007815765525*^9}},ExpressionUUID->"c2b67814-539c-42e9-bd4e-\
bdff8e02ba71"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vecs", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"TransMap", "[", 
         RowBox[{"r", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "a", "]"}], ",", 
            RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"a", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "=", "1"}], 
          ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "a", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Eigenvalues", "[", "m", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"gr23s4", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"distances", "=", 
   RowBox[{"1", "-", 
    RowBox[{"DistanceMatrix", "[", 
     RowBox[{"vecs", ",", 
      RowBox[{"DistanceFunction", "->", "CosineDistance"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"distances", ",", 
   RowBox[{"ColorFunction", "->", "\"\<CMYKColors\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.993007737867318*^9, 3.993007777616589*^9}},
 CellLabel->
  "In[632]:=",ExpressionUUID->"c2d6183a-c6fb-4eb2-90e5-98a35c35b7eb"],


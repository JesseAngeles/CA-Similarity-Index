Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Rasterize", "[", 
      RowBox[{
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"RulePlot", "[", 
               RowBox[{
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"2", ",", "1"}], "}"}], ",", "1"}], "}"}], "]"}], 
                ",", 
                RowBox[{"ColorRules", "->", "globalColorRules"}]}], "]"}], ",", 
              RowBox[{"ArrayPlot", "[", 
               RowBox[{
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"i", ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "1"}], "}"}], ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "4"}], 
                 "]"}], ",", 
                RowBox[{"Mesh", "->", "True"}], ",", 
                RowBox[{"ColorRules", "->", "globalColorRules"}]}], "]"}]}], 
             "}"}], "}"}], ",", 
           RowBox[{"Spacings", "->", 
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"\"\<Cellular Automaton: Rule \>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\< (r=1, k=2)\>\""}], 
         ",", "Top"}], "]"}], ",", 
       RowBox[{"RasterSize", "->", "500"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "15", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 

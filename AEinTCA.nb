                    RowBox[{"3", ",", "1"}], "}"}], ",", "1"}], "}"}], "]"}], 
                   ",", 
                   RowBox[{"ColorRules", "->", "globalColorRules"}]}], "]"}], 
                 ",", 
                 RowBox[{"ArrayPlot", "[", 
                  RowBox[{
                   RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"r", ",", 
                    RowBox[{"{", 
                    RowBox[{"3", ",", "1"}], "}"}], ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "1", "}"}], ",", "0"}], "}"}], ",", "10"}], 
                    "]"}], ",", 
                   RowBox[{"ColorRules", "->", "globalColorRules"}], ",", 
                   RowBox[{"Mesh", "->", "True"}]}], "]"}]}], "}"}], "}"}], ",", 
              RowBox[{"Spacings", "->", 
               RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 

       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
       RowBox[{"best", "[", 
        RowBox[{"[", "\"\<length\>\"", "]"}], "]"}]}], "]"}], ",", "k"}], 
    "]"}], ",", "\[IndentingNewLine]", 

Cell[BoxData[
 RowBox[{
  RowBox[{"TestCALifetime", "[", "ca_List", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"#", "==", "0"}], ",", 
      RowBox[{"-", "Infinity"}], ",", 
      RowBox[{
       RowBox[{"Length", "[", "ca", "]"}], "-", "#"}]}], "]"}], "&"}], "[", 
   RowBox[{"LengthWhile", "[", 
    RowBox[{
     RowBox[{"Reverse", "[", "ca", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", "#", "]"}], "==", "0"}], "&"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"21cc11f8-4713-f143-a655-6e07056adb2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"defineRules", "[", 
    RowBox[{
    "k_", ",", "r_", ",", "times_", ",", "init_", ",", "from_", ",", "to_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"length", "=", 
        RowBox[{
         RowBox[{"k", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "r"}], "+", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"k", "-", "1"}], ")"}]}], "+", "1"}], ")"}]}], "-", 
         "1"}]}], ",", "\[IndentingNewLine]", "numRules", ",", 
       "\[IndentingNewLine]", "result"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Only", " ", "use", " ", "multiples", " ", 
       RowBox[{"of", " ", "'"}], 
       RowBox[{"k", "'"}], " ", "to", " ", "avoid", " ", "spontaneous", " ", 
       "live"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "If", " ", "the", " ", "second", " ", "gene", " ", "equals", " ", 
        "the", " ", "init"}], ",", " ", 
       RowBox[{"it", " ", "grows", " ", "to", " ", "infinite"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"numRules", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"from", ",", "to", ",", "k"}], "]"}], ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"#", ",", 
               RowBox[{"k", "^", "2"}]}], "]"}], "-", 
             RowBox[{"init", " ", "k"}]}], "!=", "0"}], "&"}], ")"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "If", " ", "the", " ", "second", " ", "line", " ", "is", " ", 
         "empty"}], ",", " ", 
        RowBox[{"it", " ", "deaths"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"numRules", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"result", "=", 
               RowBox[{"CellularAutomaton", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"rule", ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", "2"}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", 
                   RowBox[{"result", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "!=", "1"}], "||", 
                 RowBox[{
                  RowBox[{"result", "[", 
                   RowBox[{"[", 
                    RowBox[{"2", ",", "1"}], "]"}], "]"}], "!=", "0"}]}], ",",
                 "\[IndentingNewLine]", 
                RowBox[{"Sow", "[", 
                 RowBox[{"rule", ",", "\"\<rule\>\""}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"rule", ",", "numRules"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", "\"\<rule\>\"", "}"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "//", "Flatten"}]}], ";", 
      "\[IndentingNewLine]", "numRules"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"times", "=", "700"}], ";"}]}], "Input",

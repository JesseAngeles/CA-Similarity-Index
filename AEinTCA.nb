 RowBox[{
  RowBox[{"k", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"graph", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{"BreadthFirstGroup", "[", 
     RowBox[{"k", ",", "r", ",", "init", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}]}], "Input",

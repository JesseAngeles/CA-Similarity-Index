Cell[CellGroupData[{

Cell["Spontaneous Death", "Subsubsection",
 CellChangeTimes->{{3.898195524720254*^9, 3.898195535561037*^9}, {
   3.915809133258247*^9, 3.91580913399594*^9}, {3.926609367013923*^9, 
   3.926609368821577*^9}, {3.9266094384454327`*^9, 3.926609440005599*^9}, {
   3.9272804090252943`*^9, 3.92728043009965*^9}, {3.960820246756097*^9, 
   3.960820249079907*^9}, {3.96082035406348*^9, 3.960820354660068*^9}, 
   3.9608236691371517`*^9},
 CellID->112706675,ExpressionUUID->"111b29be-8fee-0743-a1ea-908a9e6f5a62"],

Cell["\<\
The third filter involves applying the CellularAutomaton function for a \
single time step to remove rules that cause the pattern to vanish \
immediately, i.e., those that lead to spontaneous death.\
\>", "Text",
 CellChangeTimes->{{3.960819393268581*^9, 3.960819450009645*^9}, {
  3.9608203290948877`*^9, 
  3.960820338073021*^9}},ExpressionUUID->"978bdab0-4137-2948-969b-\
bea87a2181e3"],


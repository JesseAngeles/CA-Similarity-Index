Cell[BoxData[
 RowBox[{
  RowBox[{"Draw3D", "[", "groupRules_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vertex", ",", "edges", ",", "graph", ",", "embed", ",", "graph3d", ",", 
      " ", "coordinates", ",", " ", "stylizedVertices", ",", " ", "max"}], 
     "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Generate", " ", "the", " ", "vertices"}], ",", 
      RowBox[{"edges", " ", "and", " ", "the", " ", "graph"}]}], "*)"}], 
    RowBox[{
     RowBox[{"vertex", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"x", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"groupRules", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<rule\>\""}], "]"}], "]"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"edges", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CalculateDifference", "[", 
             RowBox[{
              RowBox[{"vertex", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"vertex", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "==", "1"}], ",", 
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{
             RowBox[{"vertex", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"vertex", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", "Nothing"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "vertex", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", 
           RowBox[{"Length", "[", "vertex", "]"}]}], "}"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"graph", "=", 
      RowBox[{"Graph", "[", 
       RowBox[{"edges", ",", 
        RowBox[{"VertexWeight", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<rule\>\"", "]"}], "->", 
             RowBox[{"#", "[", "\"\<length\>\"", "]"}]}], "&"}], "/@", 

Cell[CellGroupData[{

Cell["Finite lifeforms", "Subsubsection",
 CellChangeTimes->{{3.898195524720254*^9, 3.898195535561037*^9}, {
  3.915809133258247*^9, 3.91580913399594*^9}, {3.926609367013923*^9, 

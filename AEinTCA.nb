Cell["\<\
The animations below display all the finite lifeforms corresponding to the \
first 6 configurations mentioned above. Generally, the smaller the finite \
lifeform, the greater the number of rules capable of producing that pattern.\
\>", "Text",
 CellChangeTimes->{{3.960844326896072*^9, 3.9608443572507143`*^9}, {
  3.960844387378172*^9, 3.960844561839332*^9}, {3.960844615564488*^9, 
  3.9608446203272333`*^9}, {3.961015913923209*^9, 3.961015927848735*^9}, {
  3.961016024369306*^9, 
  3.9610160410916233`*^9}},ExpressionUUID->"586edae7-6fc2-544d-80e5-\
dd5d66e1170a"],

Cell[TextData[{
 "In some configurations, the displayed rule includes elements in the rule \
vector marked with an \[OpenCurlyQuote]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$x$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe78dd9b-e480-8d4c-84af-026b72a1a519"],
 "\[CloseCurlyQuote]. This symbol indicates that the value at that position \
can be arbitrary, any value will lead to the same resulting pattern."
}], "Text",
 CellChangeTimes->{{3.960844326896072*^9, 3.9608443572507143`*^9}, {
  3.960844387378172*^9, 3.960844561839332*^9}, {3.960844615564488*^9, 
  3.960844638415653*^9}},ExpressionUUID->"b14f4e96-df03-0f4a-a374-\
12f0213f4b87"],


Cell[CellGroupData[{

Cell["Poisson Random Walk Search", "Subsection",
 CellChangeTimes->{{3.898195524720254*^9, 3.898195535561037*^9}, {
  3.915809133258247*^9, 3.91580913399594*^9}, {3.926609367013923*^9, 
  3.926609368821577*^9}, {3.9266094384454327`*^9, 3.926609440005599*^9}, {
  3.960820215224524*^9, 3.9608202192606573`*^9}, {3.9608535856469593`*^9, 
  3.9608535892814713`*^9}, {3.961059223155283*^9, 3.961059234998621*^9}, {
  3.9610592994342527`*^9, 3.9610592998163223`*^9}},
 CellID->784848252,ExpressionUUID->"b3e80481-f70c-0b44-b008-2f32f73ad1c4"],

Cell["\<\
The Poisson distribution provides a dynamic and tunable mechanism for \
balancing exploration and exploitation in the rule space, helping the \
algorithm discover increasingly complex or stable patterns without getting \
trapped in early suboptimal choices. The PoissonRandomWalkSearch function \
works as follows:\
\>", "Text",
 CellChangeTimes->{{3.961058408297998*^9, 3.9610584696151114`*^9}, {
  3.96105929306392*^9, 
  3.9610592968439293`*^9}},ExpressionUUID->"696b7432-5a4d-844b-b01e-\
ec784c35ffae"],

Cell[TextData[{
 StyleBox["Initialization:",
  FontWeight->"Bold"],
 " It begins with rule 0 and calculates its lifetime. This serves as the \
starting point of the search."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.961058487066876*^9}, {
  3.961059003212906*^9, 
  3.961059004553226*^9}},ExpressionUUID->"1e65612e-0a54-f146-b629-\
1911c79e7bd8"],

Cell[TextData[{
 StyleBox["Neighbor Generation: ",
  FontWeight->"Bold"],
 "For each iteration, it generates all possible single-digit mutations of the \
current rule in base k. These mutated rules form the set of neighbors."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.961058488061946*^9}, 
   3.96105900877658*^9},ExpressionUUID->"d0f3fb5f-594b-8145-812d-\
827b732b676f"],

Cell[TextData[{
 StyleBox["Fitness Evaluation: ",
  FontWeight->"Bold"],
 "It evaluates the lifetime of each neighbor using the TestCALifetime \
function and filters out any invalid or degenerate results."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.9610584896506166`*^9}, 
   3.961059018644812*^9},ExpressionUUID->"579bbd5d-bc6d-fd46-a0d3-\
b7ad09cf8867"],

Cell[TextData[{
 StyleBox["Poisson-Based Selection: ",
  FontWeight->"Bold"],
 "It applies a Poisson distribution (with increasing \[Lambda]) to assign \
weights to neighbors based on their lifetimes. These weights are used to \
compute selection probabilities, favoring higher-lifetime rules more as \
\[Lambda] grows."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.9610584911474447`*^9}, 
   3.961059022824493*^9},ExpressionUUID->"449ae432-5f0e-7040-b641-\
fe2d7aa2e054"],

Cell[TextData[{
 StyleBox["Update and Record: ",
  FontWeight->"Bold"],
 "The best rule found so far is updated whenever a new rule with a longer \
lifetime is discovered. That rule is stored using Sow, and ",
 StyleBox["\[Lambda] is reduced",
  FontWeight->"Bold"],
 " temporarily to re-focus the search locally."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.961058492174077*^9}, 
   3.961059025921633*^9},ExpressionUUID->"9b345404-57b0-924c-82ba-\
050aee4f8eb9"],

Cell[TextData[{
 StyleBox["Termination: ",
  FontWeight->"Bold"],
 "The loop continues until \[Lambda] exceeds 5. The function then returns the \
sequence of best configurations found throughout the run."
}], "ItemNumbered",
 CellChangeTimes->{{3.961058408297998*^9, 3.961058494364636*^9}, 
   3.9610590287473087`*^9},ExpressionUUID->"5863142e-267b-9d45-a7a5-\
6b2691712dad"],

Cell["\<\
This method is an efficient and adaptive way to navigate the vast rule space \
of cellular automata using a biologically inspired probabilistic model.\
\>", "Text",
 CellChangeTimes->{{3.961058408297998*^9, 
  3.9610584659333076`*^9}},ExpressionUUID->"1b42d9e5-ecb0-cf4c-a6b2-\
45f8b4d0e657"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PoissonRandomWalkSearch", "[", 
   RowBox[{
   "k_", ",", "r_", ",", "init_", ",", "ruleLength_", ",", "times_", ",", 
    "increment_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"currentRule", "=", "0"}], ",", "currentRuleDigits", ",", 
      "currentLife", ",", 
      RowBox[{"bestRule", "=", "0"}], ",", 
      RowBox[{"bestLife", "=", "0"}], ",", 
      RowBox[{"lambda", "=", "0.01"}], ",", "sequence"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"currentRuleDigits", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"currentRule", ",", "k", ",", "ruleLength"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"currentLife", "=", 
      RowBox[{"TestCALifetime", "[", 
       RowBox[{"CellularAutomaton", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"currentRule", ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", "times"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Start", " ", "the", " ", "Poisson"}], "-", 
       RowBox[{"driven", " ", "random", " ", "walk", " ", "loop"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"sequence", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"lambda", "<", "3"}], ",", 
           RowBox[{
            RowBox[{"lambda", "+=", "increment"}], ";", "\[IndentingNewLine]", 
            RowBox[{"PrintTemporary", "[", 
             
             RowBox[{"\"\<Increment: \>\"", ",", "lambda", 
              ",", "\"\< to 3 (\>\"", ",", "k", ",", "\"\<,\>\"", ",", "r", 
              ",", "\"\<)\>\""}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Convert", " ", "rule", " ", "to", " ", "digit", " ", "list"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"currentRuleDigits", "=", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"currentRule", ",", "k", ",", "ruleLength"}], "]"}]}], ";",
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Generate", " ", "all", " ", "single"}], "-", 
              RowBox[{
              "mutation", " ", "neighbors", " ", "of", " ", "the", " ", 
               "current", " ", "rule"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"neighbourDigits", "=", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Reap", "[", 
                  RowBox[{"Do", "[", 
                   RowBox[{
                    RowBox[{"Do", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Sow", "[", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{"currentRuleDigits", ",", 
                    RowBox[{"i", "->", "val"}]}], "]"}], "]"}], 
                    "\[IndentingNewLine]", ",", 
                    RowBox[{"{", 
                    RowBox[{"val", ",", "0", ",", 
                    RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"ruleLength", "-", "1"}]}], "}"}]}], "]"}], "]"}],
                  "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "//", 
              "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Convert", " ", "digits", " ", "back", " ", "to", " ", "rule", " ",
               "numbers"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"neighbourRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"FromDigits", "[", 
                RowBox[{"#", ",", "k"}], "]"}], "&"}], "/@", 
              "neighbourDigits"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Get", " ", "lifetimes", " ", "for", " ", "each", " ", 
              "neighbor"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"lifetimes", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"TestCALifetime", "[", 
                RowBox[{"CellularAutomaton", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                  "times"}], "]"}], "]"}], "&"}], "/@", "neighbourRules"}]}], 
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Pair", " ", "rules", " ", "with", " ", "lifetimes", " ", "and", 
              " ", "sort", " ", "by", " ", "lifetime", " ", 
              RowBox[{"(", "descending", ")"}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"validNeighbours", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Reverse", "@", 
                RowBox[{"SortBy", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{"neighbourRules", ",", "lifetimes"}], "}"}], 
                   "]"}], ",", "Last"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"Not", "[", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"-", "Infinity"}], "}"}], ",", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "&"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Extract", " ", "lifetimes", " ", "for", " ", "weighting"}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"weights", "=", 
             RowBox[{"validNeighbours", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Apply", " ", "Poisson", " ", "weighting", " ", "based", " ", 
              "on", " ", "lambda"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"poissonWeights", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"PDF", "[", 
                RowBox[{
                 RowBox[{"PoissonDistribution", "[", "lambda", "]"}], ",", 
                 "#"}], "]"}], "&"}], "/@", "weights"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"priority", "=", 
             RowBox[{"1", "/", "poissonWeights"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"probabilities", "=", 
             RowBox[{"priority", "/", 
              RowBox[{"Total", "[", "priority", "]"}]}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Pair", " ", "rule"}], ",", "lifetime", ",", 
              RowBox[{"and", " ", "selection", " ", "probability"}]}], "*)"}],
             "\[IndentingNewLine]", 
            RowBox[{"rulePool", "=", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"validNeighbours", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "weights", ",",
                 "probabilities"}], "}"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Select", " ", "a", " ", "new", " ", "rule", " ", "using", " ", 
              "the", " ", "calculated", " ", "probabilities"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"newRule", ",", "newLife", ",", "prob"}], "}"}], "=", 
             RowBox[{"RandomChoice", "[", 
              RowBox[{
               RowBox[{"rulePool", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "3"}], "]"}], "]"}], "->", "rulePool"}], 
              "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Update", " ", "the", " ", "best", " ", "rule", " ", "found", " ",
               "so", " ", "far", " ", "if", " ", "improved"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"newLife", ">", "bestLife"}], ",", 
              RowBox[{
               RowBox[{"bestRule", "=", "newRule"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"bestLife", "=", "newLife"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Sow", "[", 
                RowBox[{"{", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"IntegerQ", "[", "r", "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"DrawCA", "[", 
                    RowBox[{
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"bestRule", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    "bestLife"}], "]"}], ",", "k"}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"SerratedBricksArrayPlot", "[", 
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"bestRule", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    "bestLife"}], "]"}], "]"}]}], "]"}], ",", "bestLife"}], 
                   "]"}], ",", "\[IndentingNewLine]", "bestLife"}], 
                 "\[IndentingNewLine]", "}"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"lambda", "/=", "2"}], ";"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Set", " ", "current", " ", "rule", " ", "to", " ", "the", " ", 
              "selected", " ", "one"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"currentRule", "=", "newRule"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"currentLife", "=", "newLife"}], ";"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "//", "Flatten"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Return", " ", "the", " ", "collected", " ", "sequence", " ", "of", " ",
        "best", " ", "configurations"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"sequence", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{"sequence", ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "sequence"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.961057065969493*^9, 3.961057065969533*^9}, {
   3.961057832436287*^9, 3.961057970427301*^9}, {3.961058044223514*^9, 
   3.9610580922903843`*^9}, {3.9610586071772738`*^9, 3.961058666908266*^9}, {
   3.961059401846601*^9, 3.9610594228976793`*^9}, {3.9610600030030603`*^9, 
   3.961060007107897*^9}, {3.961060053175294*^9, 3.961060058793449*^9}, {
   3.9610610113852663`*^9, 3.961061060072329*^9}, {3.961061201386507*^9, 
   3.961061204245224*^9}, {3.9610620371823587`*^9, 3.961062039547715*^9}, 
   3.961062180828327*^9, {3.961062211802476*^9, 3.9610622119170027`*^9}, 
   3.961145775302824*^9},ExpressionUUID->"e72686fb-2f60-714e-885f-\
8e2a19b7f860"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Concluding Remarks", "Section",
 CellChangeTimes->{{3.832335989380006*^9, 3.832335995602777*^9}, 
   3.926512336619938*^9},ExpressionUUID->"6a396f6d-2aad-aa48-a614-\
c574b008c3d6"],

Cell["\<\
This work explored the emergence of finite lifeforms in one-dimensional \
totalistic cellular automata, starting from a single active cell. By applying \
a series of logical filters, the number of rules to evaluate was drastically \
reduced, allowing a feasible brute-force search within small configurations.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
  3.802186780928506*^9, 3.802186861789569*^9}, {3.8323359350826187`*^9, 
  3.832335937574898*^9}, {3.8323360079148*^9, 3.832336026898738*^9}, {
  3.89817559356276*^9, 3.898175643774722*^9}, {3.8981759221117764`*^9, 
  3.898175945171869*^9}, {3.926512832910259*^9, 3.926512834650893*^9}, {
  3.92727250280524*^9, 3.927272515673345*^9}, {3.961028024570518*^9, 
  3.9610280274542503`*^9}},ExpressionUUID->"68ac3e41-0f9f-a043-b11e-\
0508707ae88e"],

Cell["\<\
Through this approach, a variety of finite patterns were discovered, and \
their distribution across the rule space was analyzed. The results showed \
that shorter lifeforms are more common and widely distributed, while longer \
lifeforms are rarer and more isolated in the rule space.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
  3.802186780928506*^9, 3.802186861789569*^9}, {3.8323359350826187`*^9, 
  3.832335937574898*^9}, {3.8323360079148*^9, 3.832336026898738*^9}, {
  3.89817559356276*^9, 3.898175643774722*^9}, {3.8981759221117764`*^9, 
  3.898175945171869*^9}, {3.926512832910259*^9, 3.926512834650893*^9}, {
  3.92727250280524*^9, 3.927272515673345*^9}, {3.961028024570518*^9, 
  3.96102802936854*^9}},ExpressionUUID->"39dfb100-4be9-5842-8b7d-\
f4c057a9d4c0"],

Cell["\<\
To better understand these relationships, we developed a graph-based \
exploration algorithm using a breadth-first strategy. This allowed us to \
group rules by behavior and reveal the connectivity between them through \
minimal mutations. The resulting graphs showed that rules producing similar \
finite lifeforms tend to form tightly connected clusters, while longer and \
more complex lifeforms appear at the periphery with fewer connections.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
  3.802186780928506*^9, 3.802186861789569*^9}, {3.8323359350826187`*^9, 
  3.832335937574898*^9}, {3.8323360079148*^9, 3.832336026898738*^9}, {
  3.89817559356276*^9, 3.898175643774722*^9}, {3.8981759221117764`*^9, 
  3.898175945171869*^9}, {3.926512832910259*^9, 3.926512834650893*^9}, {
  3.92727250280524*^9, 3.927272515673345*^9}, {3.961028024570518*^9, 
  3.961028031341824*^9}},ExpressionUUID->"9a9e2717-b9f3-6e4f-b113-\
e107ae3dc69b"],

Cell["\<\
Overall, this methodology not only allowed the discovery of interesting \
finite patterns but also provided a framework to study the structure of the \
rule space, the robustness of lifeforms, and the evolutionary paths between \
different configurations.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
  3.802186780928506*^9, 3.802186861789569*^9}, {3.8323359350826187`*^9, 
  3.832335937574898*^9}, {3.8323360079148*^9, 3.832336026898738*^9}, {
  3.89817559356276*^9, 3.898175643774722*^9}, {3.8981759221117764`*^9, 
  3.898175945171869*^9}, {3.926512832910259*^9, 3.926512834650893*^9}, {
  3.92727250280524*^9, 3.927272515673345*^9}, {3.961028024570518*^9, 
  3.961028033621241*^9}},ExpressionUUID->"e742333a-5ddc-8e40-98e5-\
90f5f55bfd13"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Acknowledgments", "Section",
 CellChangeTimes->{{3.802186344523418*^9, 3.802186368848865*^9}, 
   3.926512258861013*^9},
 CellTags->"Keywords",
 CellID->1836614011,ExpressionUUID->"c4152865-106b-b544-9d0b-01080f7b0167"],

Cell["\<\
I would like to express my deep gratitude to my mentor Willem Nielsen for his \
constant support and guidance throughout this project. His patience, clarity, \
and deep understanding of the subject were fundamental to my progress. I am \
also thankful to Alejandra Ortiz and Hugo Su\[AAcute]rez, who assisted me \
with the code and helped me overcome technical and style challenges during \
the development.\
\>", "Text",
 CellChangeTimes->{{3.802186374730517*^9, 3.802186375456683*^9}, {
  3.802186730191574*^9, 3.802186731523522*^9}, {3.8323358194918*^9, 
  3.832335879235589*^9}, {3.880799298533113*^9, 3.880799310827926*^9}, {
  3.894990547313821*^9, 3.894990548953347*^9}, {3.898028694104607*^9, 
  3.8980287132985263`*^9}, {3.898028958630477*^9, 3.8980290250101137`*^9}, {
  3.898029055714566*^9, 3.898029062069987*^9}, {3.898170091919715*^9, 
  3.898170105927931*^9}, {3.926512861672077*^9, 3.926512862089115*^9}, {
  3.926512957395006*^9, 3.926512960452987*^9}, {3.926676024978294*^9, 
  3.926676038720537*^9}, {3.961028147589526*^9, 3.961028150262505*^9}, {
  3.9610283300839663`*^9, 3.961028336173602*^9}, {3.9610294571325808`*^9, 
  3.961029460227921*^9}},ExpressionUUID->"084ba28c-297d-cc4c-9d9a-\
d74cdd66f9bf"],

Cell["\<\
Special thanks to Stephen Wolfram for suggesting the project direction and \
finally, I want to thank Professor Genaro Ju\[AAcute]rez for giving me the \
opportunity to attend the WSS and present this work.\
\>", "Text",
 CellChangeTimes->{{3.802186374730517*^9, 3.802186375456683*^9}, {
  3.802186730191574*^9, 3.802186731523522*^9}, {3.8323358194918*^9, 

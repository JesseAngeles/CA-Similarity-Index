Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Code", " ", "to", " ", "generate", " ", "config", " ", "rules"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"times", "=", "700"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"configRules", "=", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"definedRules", "=", 
            RowBox[{"defineRules", "[", 
             RowBox[{
              RowBox[{"config", "[", "\"\<k\>\"", "]"}], ",", 
              RowBox[{"config", "[", "\"\<r\>\"", "]"}], ",", "times", ",", 
              "init", ",", "0", ",", 
              RowBox[{"config", "[", "\"\<rules\>\"", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Apply", " ", "TestCALifetime", " ", "to", " ", "identify", " ", 
             "those", " ", "rules", " ", "with", " ", "finite", " ", 
             "lifeform"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"lts", "=", 
            RowBox[{"ParallelMap", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#", ",", "\[IndentingNewLine]", 
                 RowBox[{"TestCALifetime", "[", "\[IndentingNewLine]", 
                  RowBox[{"CellularAutomaton", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"config", "[", "\"\<k\>\"", "]"}], ",", "1"}], 
                    "}"}], ",", 
                    RowBox[{"config", "[", "\"\<r\>\"", "]"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    "times"}], "]"}], "\[IndentingNewLine]", "]"}]}], 
                "\[IndentingNewLine]", "}"}], "&"}], ",", "definedRules"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"finiteRules", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"lts", ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "!=", 
                 RowBox[{"-", "Infinity"}]}], "&"}], ")"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Group", " ", "rules", " ", "by", " ", "the", " ", "same", " ", 
             "lifeform"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"groupRules", "=", 
            RowBox[{"SimilarTCA", "[", 
             RowBox[{"finiteRules", ",", 
              RowBox[{"config", "[", "\"\<k\>\"", "]"}], ",", 
              RowBox[{"config", "[", "\"\<r\>\"", "]"}], ",", "init", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "*", 
                   RowBox[{"config", "[", "\"\<r\>\"", "]"}]}], "+", "1"}], 
                 ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"config", "[", "\"\<k\>\"", "]"}], "-", "1"}], 
                 ")"}]}], "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"groupRules", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{"groupRules", ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "\"\<length\>\"", "]"}], "]"}], "&"}], ")"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"config", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"config", ",", 
              RowBox[{"\"\<init\>\"", "->", "init"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"config", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"config", ",", 
              RowBox[{"\"\<groups\>\"", "->", "groupRules"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "config"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"init", ",", 
            RowBox[{
             RowBox[{"config", "[", "\"\<k\>\"", "]"}], "-", "1"}]}], "}"}]}],
          "]"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"config", ",", "configurations"}], "}"}]}], "]"}], "//", 
      "Flatten"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Iconize", "[", "configRules", "]"}]}]}]], "Input",

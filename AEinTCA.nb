   3.96082367069969*^9},
 CellID->1280287777,ExpressionUUID->"eceeda98-a4c9-8f48-b8e4-6862a8c4b3bb"],

Cell["\<\
The second filter considers the initial condition. If the output in the rule\
\[CloseCurlyQuote]s second position is the same as the initial cell\
\[CloseCurlyQuote]s state, the pattern will grow indefinitely. These rules \
are also excluded.\
\>", "Text",
 CellChangeTimes->{{3.960817991327653*^9, 3.960818018289193*^9}, 
   3.960818064224718*^9, {3.960818127867915*^9, 3.9608181681994553`*^9}, {

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "2186", ",", "3"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"#", ",", "9"}], "]"}], "==", "3"}], "&"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Generar", " ", "frames", " ", "rasterizados"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frames", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", "=", 
          RowBox[{"rules", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 

   3.898170140258331*^9, 3.898170246020052*^9}, 3.926512499894645*^9, {
   3.9266094882344837`*^9, 3.926609510140595*^9}, {3.926676124832939*^9, 
   3.9266761698317223`*^9}, 3.927272873245349*^9, {3.927359833191084*^9, 
   3.9273598516878605`*^9}, {3.927359892523365*^9, 3.927359923929069*^9}, {
   3.927359957458332*^9, 3.927360015778108*^9}, {3.927360367008919*^9, 
   3.927360367335776*^9}, {3.927361130102511*^9, 3.927361130451678*^9}, {
   3.927361316052264*^9, 3.927361316588394*^9}, {3.960736339210099*^9, 
   3.960736341207962*^9}, {3.960817256572544*^9, 3.960817470154181*^9}, {
   3.960817568887924*^9, 3.960817570816279*^9}, {3.9608180320834637`*^9, 
   3.960818059098493*^9}, {3.9608181168514137`*^9, 3.960818121908978*^9}, 
   3.9608202252631493`*^9, {3.960820883479535*^9, 3.960820883816391*^9}},
 CellID->2031967369,ExpressionUUID->"d97ba8ac-dc04-3f45-801e-cfe0b7c40a01"],


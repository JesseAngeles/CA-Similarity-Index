Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"from", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"to", "=", "2186"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"init", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", "=", "3"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Selecci\[OAcute]n", " ", "de", " ", "reglas"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rules", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"from", ",", "to", ",", "k"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"#", ",", 
           RowBox[{"k", "^", "2"}]}], "]"}], "!=", 
         RowBox[{"init", "*", "k"}]}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Filtro", " ", "de", " ", "reglas"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"filteredRules", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"result", "=", 
             RowBox[{"CellularAutomaton", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"rule", ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", "1"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{"result", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}], "==", "1"}], "&&", 
               RowBox[{
                RowBox[{"result", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "1"}], "]"}], "]"}], "==", "0"}]}], ",", 
              RowBox[{"Sow", "[", 
               RowBox[{"rule", ",", "\"\<rule\>\""}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "\"\<rule\>\"", "}"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}], "//", "Flatten"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generar", " ", "y", " ", "rasterizar", " ", "los", " ", "frames"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"frames", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rule", "=", 
           RowBox[{"filteredRules", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"Rasterize", "[", 
          RowBox[{
           RowBox[{"Labeled", "[", 
            RowBox[{
             RowBox[{"Grid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"RulePlot", "[", 
                   RowBox[{
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{"{", 
                    RowBox[{"rule", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], "]"}], 
                    ",", 
                    RowBox[{"ColorRules", "->", "globalColorRules"}]}], "]"}],
                   ",", 
                  RowBox[{"ArrayPlot", "[", 
                   RowBox[{
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"rule", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", "3"}],
                     "]"}], ",", 
                    RowBox[{"ColorRules", "->", "globalColorRules"}], ",", 
                    RowBox[{"Mesh", "->", "True"}]}], "]"}]}], "}"}], "}"}], ",", 
               RowBox[{"Spacings", "->", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
             RowBox[{"\"\<Celular Automaton: Rule \>\"", "<>", 
              RowBox[{"ToString", "[", "rule", "]"}], "<>", "\"\< (r=\>\"", "<>", 
              RowBox[{"ToString", "[", "r", "]"}], "<>", "\"\<, k=\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<)\>\""}], ",", 
             "Top"}], "]"}], ",", 
           RowBox[{"RasterSize", "->", "500"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "filteredRules", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Exportar", " ", "GIF"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"\"\<./img/filtered_rules_k\>\"", "<>", 
       RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<_r\>\"", "<>", 
       RowBox[{"ToString", "[", "r", "]"}], "<>", "\"\<.gif\>\""}], ",", 
      "frames", ",", 
      RowBox[{"\"\<DisplayDurations\>\"", "->", "0.4"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9608197760420647`*^9, 3.9608198061421137`*^9}, {

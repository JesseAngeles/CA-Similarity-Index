                RowBox[{"[", "1", "]"}], "]"}], "!=", "rule"}], ",", 
              RowBox[{"Sow", "[", 
               RowBox[{"m", ",", "\"\<finite\>\""}], "]"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "mutated"}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<zero\>\"", ",", "\"\<infinite\>\"", 
           ",", "\"\<finite\>\""}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 

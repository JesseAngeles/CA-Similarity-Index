Cell[CellGroupData[{

Cell["Totalistic Cellular Automata", "Subsubsection",
 CellChangeTimes->{{3.898195524720254*^9, 3.898195535561037*^9}, {
  3.915809133258247*^9, 3.91580913399594*^9}, {3.926609367013923*^9, 
  3.926609368821577*^9}, {3.9266094384454327`*^9, 3.926609440005599*^9}, {
  3.9272804090252943`*^9, 3.92728043009965*^9}, {3.960749503061179*^9, 
  3.9607495087779293`*^9}, {3.960749575411603*^9, 3.960749581461231*^9}},
 CellID->977860532,ExpressionUUID->"9cb37ebd-cb93-404d-83c4-c4d02eae6b7d"],

Cell["\<\
Totalistic Cellular Automata (TCA) are a type of cellular automaton in which \
the transition rules depend solely on the sum (or equivalently, the average) \
of the values of the cells in a neighborhood. Although TCAs can be described \
using standard cellular automaton formalisms, this formulation significantly \
reduces the number of possible rules.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
   3.802186780928506*^9, 3.802186861789569*^9}, {3.832335906349555*^9, 
   3.832335909229568*^9}, {3.832336112805627*^9, 3.832336113421673*^9}, 
   3.833031536056086*^9, {3.83303157648634*^9, 3.833031596344939*^9}, {
   3.898170140258331*^9, 3.898170246020052*^9}, 3.926512499894645*^9, {
   3.9266094882344837`*^9, 3.926609510140595*^9}, {3.926676124832939*^9, 
   3.9266761698317223`*^9}, 3.927272873245349*^9, {3.927359833191084*^9, 
   3.9273598516878605`*^9}, {3.927359892523365*^9, 3.927359923929069*^9}, {
   3.927359957458332*^9, 3.927360015778108*^9}, {3.927360367008919*^9, 
   3.927360367335776*^9}, {3.927361130102511*^9, 3.927361130451678*^9}, {
   3.927361316052264*^9, 3.927361316588394*^9}, {3.960736339210099*^9, 
   3.960736341207962*^9}, {3.960752094457897*^9, 3.960752110314907*^9}, {
   3.960752223426176*^9, 3.960752278800075*^9}, {3.960752596385584*^9, 
   3.960752664552824*^9}, {3.9607529110592613`*^9, 3.96075293462684*^9}},
 CellID->778744588,ExpressionUUID->"9fba5219-5c93-7742-812b-4d9bd78f595b"],

Cell["\<\
This type of rule is used, for example, in Conway' s Game of Life .\
\>", "Text",
 CellChangeTimes->{{3.960752937254047*^9, 
  3.960752941159277*^9}},ExpressionUUID->"3e33bdee-7b28-8043-a6aa-\
4edc9954fe56"],

Cell["\<\
The evolution of a one - dimensional totalistic cellular automaton is \
illustrated in the following figure.\
\>", "Text",
 CellChangeTimes->{{3.960752942915669*^9, 
  3.960752947297929*^9}},ExpressionUUID->"59857f50-17c2-4d45-a44a-\
161c19385370"],


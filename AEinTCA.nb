   3.961025373155333*^9, {3.9610254376253033`*^9, 3.9610254889750767`*^9}, 
   3.961025556113139*^9, 3.9610256661705847`*^9, 3.961025700594304*^9, {
   3.961027302778064*^9, 3.961027330633806*^9}, {3.9610273679812613`*^9, 
   3.9610274626617928`*^9}, 3.961027534314395*^9, 3.9610291618953447`*^9},
 CellLabel->
  "Out[456]=",ExpressionUUID->"dad36e53-d1bf-8746-b9da-48108c1f6707"]
}, {2}]],

Cell["\<\
The following algorithm implements a breadth-first search strategy to explore \
the space of totalistic cellular automata (TCA) rules that produce finite \
lifeforms . The process starts from the null rule, which is guaranteed to \
mutate into a valid finite lifeform with a single change.\
\>", "Text",
 CellChangeTimes->{{3.961027866128337*^9, 3.9610278783898277`*^9}, {
  3.961029629964183*^9, 
  3.9610296308645573`*^9}},ExpressionUUID->"9690ce5e-7a04-7045-ab12-\
ea2f72eb71dd"],

Cell[TextData[{
 "Once the first finite lifeform is found, its neighboring rules (i.e., those \
reachable through a single mutation) are collected. For each neighbor, the \
algorithm determines whether it produces the same evolution (same pattern and \
same lifetime). If so, the rule is grouped together with its equivalent \
class, and all of its neighbors are added to the search frontier (",
 Cell[BoxData[
 "toTest"], "InlineCode",ExpressionUUID->
  "441a3f96-a4ff-634c-9ae1-22bf6e983ab8"],
 ").\nIf the rule produces a new, distinct lifeform, it is either assigned to \
an existing group (if it matches an existing pattern) or used to create a new \
group."
}], "Text",
 CellChangeTimes->{{3.961027866128337*^9, 3.961027883047162*^9}, {
  3.961027917641292*^9, 
  3.961027921076666*^9}},ExpressionUUID->"5d0305ae-52b7-da41-a518-\
deea5c88b841"],

Cell["At each iteration:", "Text",
 CellChangeTimes->{{3.961027866128337*^9, 
  3.961027890363905*^9}},ExpressionUUID->"6262c50c-e887-3f4e-acfe-\
d06255a52cb4"],

Cell["\<\
New connections (edges) are created between the current node and its \
neighboring nodes.\
\>", "Item",
 CellChangeTimes->{{3.961027866128337*^9, 
  3.961027891838916*^9}},ExpressionUUID->"65c79df1-963c-d441-9136-\
bfab2de2b645"],

Cell["\<\
The algorithm continues expanding until the specified depth (i.e., number of \
nodes visited) is reached.\
\>", "Item",
 CellChangeTimes->{{3.961027866128337*^9, 
  3.961027897436488*^9}},ExpressionUUID->"36aeb2d4-16eb-3448-b749-\
9b5f826e3a4b"],

Cell["\<\
This strategy avoids redundant pattern checks and reveals how small mutations \
lead to connected components of rules producing similar finite patterns.\
\>", "Text",
 CellChangeTimes->{{3.961027866128337*^9, 
  3.9610279027254667`*^9}},ExpressionUUID->"d8eebc00-5f59-604e-8ba2-\
533f10f8cf98"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BreadthFirstGroup", "[", 
    RowBox[{"k_", ",", "r_", ",", "init_", ",", "depth_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"visitedRules", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"List", " ", "of", " ", "visited", " ", "rules"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"nodes", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"List", " ", "of", " ", "discovered", " ", "nodes"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"edges", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"List", " ", "of", " ", "edges", " ", 
         RowBox[{"(", "connections", ")"}], " ", "between", " ", "nodes"}], 
        "*)"}], 
       RowBox[{"pendingPositions", "=", 
        RowBox[{"{", "}"}]}], ",", "    ", 
       RowBox[{"(*", 
        RowBox[{
        "Temporary", " ", "positions", " ", "to", " ", "build", " ", 
         "edges"}], "*)"}], "\[IndentingNewLine]", "finiteNeighbors", ",", 
       "similarRules", ",", "currentNodeIndex", ",", "toTestIndex", ",", 
       "foundNode", ",", "neighborsToAdd"}], "\[IndentingNewLine]", "}"}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Start", " ", "from", " ", "the", " ", "null", " ", "rule"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rule", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"finiteNeighbors", "=", 
       RowBox[{
        RowBox[{"ClassifyNeighbourRules", "[", 
         RowBox[{
          RowBox[{"rule", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "k", ",", "r"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"similarRules", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Create", " ", "the", " ", "initial", " ", "node", " ", "and", " ", 
        "add", " ", "it", " ", "to", " ", "nodes"}], "*)"}], 
      RowBox[{"node", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<rules\>\"", "->", 
          RowBox[{"Append", "[", 
           RowBox[{"similarRules", ",", 
            RowBox[{"rule", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<length\>\"", "->", 
          RowBox[{"rule", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "|>"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"nodes", ",", "node"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"currentNodeIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Iterate", " ", "until", " ", "all", " ", "nodes", " ", "are", " ", 
        "visited", " ", "or", " ", "depth", " ", "limit", " ", "is", " ", 
        "reached"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Monitor", "[", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"currentNodeIndex", "<", 
           RowBox[{"Length", "[", "nodes", "]"}]}], ",", 
          RowBox[{
           RowBox[{"currentNodeIndex", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"node", "=", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", "currentNodeIndex", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Add", " ", "all", " ", "rules", " ", "in", " ", "the", " ", 
             "current", " ", "node", " ", "to", " ", "the", " ", "visited", " ",
              "list"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"visitedRules", "=", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{"visitedRules", ",", 
               RowBox[{"node", "[", "\"\<rules\>\"", "]"}]}], "]"}], "//", 
             "Flatten"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Generate", " ", "a", " ", "list", " ", "of", " ", "neighbor", " ",
              "rules", " ", "not", " ", "yet", " ", "visited"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"toTest", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"finiteNeighbors", "=", 
                    RowBox[{
                    RowBox[{"ClassifyNeighbourRules", "[", 
                    RowBox[{"rule", ",", "k", ",", "r"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"rule", ",", 
                    RowBox[{"node", "[", "\"\<rules\>\"", "]"}]}], "}"}]}], 
                    "]"}], ",", "1"}], "]"}], ",", 
                 RowBox[{"Select", "[", 
                  RowBox[{"finiteNeighbors", ",", 
                   RowBox[{
                    RowBox[{"Not", "[", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"similarRules", ",", "#"}], "]"}], "]"}], "&"}]}],
                   "]"}]}], "]"}], "//", "DeleteDuplicates"}], ",", 
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{"visitedRules", ",", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "&"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Mark", " ", "these", " ", "new", " ", "rules", " ", "as", " ", 
             "visited"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"visitedRules", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"visitedRules", ",", 
              RowBox[{"toTest", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Explore", " ", "each", " ", "candidate", " ", "rule"}], 
            "*)"}], 
           RowBox[{"toTestIndex", "=", "0"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Monitor", "[", 
            RowBox[{
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{"toTestIndex", "<", 
                RowBox[{"Length", "[", "toTest", "]"}]}], ",", 
               RowBox[{
                RowBox[{"toTestIndex", "++"}], ";", "\[IndentingNewLine]", 
                RowBox[{"rule", "=", 
                 RowBox[{"toTest", "[", 
                  RowBox[{"[", "toTestIndex", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                 "Find", " ", "existing", " ", "nodes", " ", "with", " ", 
                  "the", " ", "same", " ", "pattern", " ", "length"}], "*)"}], 
                RowBox[{"possibleNodes", "=", 
                 RowBox[{"Select", "[", 
                  RowBox[{"nodes", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<length\>\"", "]"}], "==", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                 "Check", " ", "if", " ", "the", " ", "rule", " ", "has", " ",
                   "the", " ", "same", " ", "evolution", " ", "as", " ", 
                  "any", " ", "existing", " ", "node"}], "*)"}], 
                RowBox[{"foundNode", "=", 
                 RowBox[{"Select", "[", 
                  RowBox[{"possibleNodes", ",", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"\"\<rules\>\"", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}], "==", 
                    RowBox[{"CellularAutomaton", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}]}], 
                    ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{
                  "If", " ", "no", " ", "matching", " ", "node", " ", 
                   "found"}], ",", 
                  RowBox[{"create", " ", "a", " ", "new", " ", "one"}]}], 
                 "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "foundNode", "]"}], "==", "0"}], ",", 
                  RowBox[{
                   RowBox[{"newNode", "=", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<rules\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ",", 
                    RowBox[{"\"\<length\>\"", "->", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                    RowBox[{"\"\<rule\>\"", "->", 
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "k", ",", 
                    RowBox[{"RuleLength", "[", 
                    RowBox[{"k", ",", "r"}], "]"}]}], "]"}]}]}], "|>"}]}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"nodes", ",", "newNode"}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"pendingPositions", ",", 
                    RowBox[{"Length", "[", "nodes", "]"}]}], "]"}]}], ",", 
                  "\[IndentingNewLine]", "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                   "Otherwise", " ", "add", " ", "the", " ", "rule", " ", 
                    "to", " ", "the", " ", "existing", " ", "node"}], "*)"}], 
                  RowBox[{
                   RowBox[{"addPos", "=", 
                    RowBox[{
                    RowBox[{"Position", "[", 
                    RowBox[{"nodes", ",", 
                    RowBox[{"foundNode", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"pendingPositions", ",", "addPos"}], "]"}], ";", 
                   "\[IndentingNewLine]", "\[IndentingNewLine]", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "If", " ", "the", " ", "node", " ", "found", " ", "is", " ",
                     "the", " ", "current", " ", "node"}], ",", " ", 
                    RowBox[{
                    "add", " ", "its", " ", "neighbors", " ", "to", " ", 
                    "toTest"}]}], "*)"}], 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"addPos", "==", "currentNodeIndex"}], ",", 
                    RowBox[{
                    RowBox[{"neighborsToAdd", "=", 
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ClassifyNeighbourRules", "[", 
                    RowBox[{
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "k", ",", "r"}], 
                    "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Not", "[", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"visitedRules", ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "&"}]}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"visitedRules", "=", 
                    RowBox[{"Join", "[", 
                    RowBox[{"visitedRules", ",", 
                    RowBox[{"neighborsToAdd", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"toTest", "=", 
                    RowBox[{"Join", "[", 
                    RowBox[{"toTest", ",", "neighborsToAdd"}], "]"}]}], 
                    ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{
                    RowBox[{"nodes", "[", 
                    RowBox[{"[", 
                    RowBox[{"addPos", ",", "\"\<rules\>\""}], "]"}], "]"}], ",", 
                    RowBox[{"rule", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}], "]"}], 
                ";"}]}], "]"}], ",", 
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{"toTestIndex", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"Length", "[", "toTest", "]"}]}], "}"}]}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Remove", " ", "duplicates", " ", "and", " ", "current", " ", 
             "node", " ", "from", " ", "positions"}], "*)"}], 
           RowBox[{"pendingPositions", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"pendingPositions", "//", "DeleteDuplicates"}], ",", 
              "currentNodeIndex"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Create", " ", "edges", " ", 
             RowBox[{"(", "connections", ")"}], " ", "between", " ", 
             "current", " ", "node", " ", "and", " ", "discovered", " ", 
             "nodes"}], "*)"}], 
           RowBox[{"edges", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"edges", ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"currentNodeIndex", ",", "pos"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"pos", ",", "pendingPositions"}], "}"}]}], "]"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Stop", " ", "if", " ", "depth", " ", "limit", " ", "is", " ", 
             "reached"}], "*)"}], 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"currentNodeIndex", "==", "depth"}], ",", 
             RowBox[{"Break", "[", "]"}], ",", 
             RowBox[{"PrintTemporary", "[", 
              RowBox[{"\"\<Nodes visited: \>\"", ",", "currentNodeIndex"}], 
              "]"}]}], "]"}], ";"}]}], "]"}], ",", 
        RowBox[{"ProgressIndicator", "[", 
         RowBox[{"currentNodeIndex", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "nodes", "]"}]}], "}"}]}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Return", " ", "the", " ", "undirected", " ", "graph", " ", "edges"}], 
       "*)"}], 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"nodes", "[", 
           RowBox[{"[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "\[UndirectedEdge]", 
          RowBox[{"nodes", "[", 
           RowBox[{"[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "edges"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;"}], "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",

        RowBox[{"#2", "=!=", "\"\<x\>\""}]}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"list1", ",", "list2"}], "}"}]}], "]"}], ",", "True"}], 
   "]"}]}]], "Input",

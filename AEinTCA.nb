               ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", 
                RowBox[{"-", "\[Infinity]"}]}], "||", 
               RowBox[{
                RowBox[{"m", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", "times"}]}], ",", 
              RowBox[{"Sow", "[", 
               RowBox[{
                RowBox[{"m", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<infinite\>\""}], 

Cell[BoxData[
 RowBox[{
  RowBox[{"MutateRule", "[", 
   RowBox[{"rule_", ",", "length_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"digits", ",", "mutated"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"digits", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"rule", ",", "k", ",", "length"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mutated", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Sow", "[", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"digits", ",", 
                RowBox[{"i", "->", "j"}]}], "]"}], "]"}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "0", ",", 
               RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"length", "-", "1"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}], "//", "DeleteDuplicates"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"FromDigits", "[", 
        RowBox[{"#", ",", "k"}], "]"}], "&"}], "/@", "mutated"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",

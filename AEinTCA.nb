  3.9608535892814713`*^9}, {3.961059217290152*^9, 3.961059218046178*^9}, {
  3.961063207390128*^9, 3.961063210211893*^9}},
 CellID->1851554135,ExpressionUUID->"7f068cf2-6878-f241-bdc6-29c431e5a072"],

Cell["\<\
The below plots shows the sequence of the largest lifeforms generated by \
random mutations: \
\>", "Text",
 CellChangeTimes->{{3.961062859077579*^9, 
  3.961062903367285*^9}},ExpressionUUID->"f229b9ec-859f-6c46-b86b-\
d77e93f61686"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"increment", "=", ".1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sequence", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"PoissonRandomWalkSearch", "[", 
     RowBox[{"k", ",", "r", ",", "1", ",", 
      RowBox[{"RuleLength", "[", 
       RowBox[{"k", ",", "r"}], "]"}], ",", "2000", ",", "increment"}], "]"}],
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9610708221590652`*^9, 3.961070830073827*^9}, {

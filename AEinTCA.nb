          RowBox[{"k", ",", "r"}], "]"}], ",", "k"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "zero", ",", " ", "infinite", ",", " ", 
      "finite"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mutated", "=", 

Cell[BoxData[
 RowBox[{
  RowBox[{"SimilarTCA", "[", 
   RowBox[{
   "finiteRules_", ",", "k_", ",", "r_", ",", "init_", ",", "ruleLength_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sameLength", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sameLength", "=", 
      RowBox[{
       RowBox[{"GroupBy", "[", 
        RowBox[{"finiteRules", ",", "Last"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Iterate", " ", "all", " ", "the", " ", "sameLenght", " ", "rules"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{
       RowBox[{"Reap", "[", 
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"evolutions", "=", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#", ",", 
                  RowBox[{"CellularAutomaton", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", 
                    RowBox[{"key", "-", "1"}]}], "]"}]}], "}"}], "&"}], ",", 
               RowBox[{"sameLength", "[", "key", "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"lifeforms", "=", 
             RowBox[{"GatherBy", "[", 
              RowBox[{"evolutions", ",", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Sow", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"key", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "&"}], "/@", 
                 "lifeforms"}]}], "}"}], ",", "\"\<evo\>\""}], "]"}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"key", ",", 
             RowBox[{"Keys", "[", "sameLength", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "\"\<evo\>\"", "}"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<length\>\"", "->", 
              RowBox[{"i", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{"\"\<rules\>\"", "->", "#"}], ",", "\[IndentingNewLine]", 
             RowBox[{"\"\<rule\>\"", "->", 
              RowBox[{"Table", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"SameQ", "@@", "col"}], ",", 
                  RowBox[{"First", "[", "col", "]"}], ",", "\"\<x\>\""}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"col", ",", 
                  RowBox[{"Transpose", "[", "\[IndentingNewLine]", 
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{"i", ",", "k", ",", "ruleLength"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "#"}], "}"}]}], "]"}], "]"}]}], "}"}]}],
                "]"}]}]}], "|>"}], "&"}], "/@", 
          RowBox[{"i", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "data"}], "}"}]}], "]"}], "//", "Flatten"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"d072740a-0c68-b047-abaf-4afc8365cb38"],


Cell[TextData[{
 "Below are the best rules found across different configurations.\n\nThe \
longest finite lifeform discovered through brute-force search was of length \
109,521, using parameters  ",
 StyleBox["k = 3, r = 2.5,",
  FontSlant->"Italic"],
 " initial states of ",
 StyleBox["2 ",
  FontSlant->"Italic"],
 "and a grid of length 699."
}], "Text",
 CellChangeTimes->{{3.961007174797958*^9, 3.9610072443519373`*^9}, {
  3.9610160151758537`*^9, 3.961016020209968*^9}, {3.961019416676646*^9, 
  3.961019440725914*^9}, {3.961020049524597*^9, 3.96102007699758*^9}, {
  3.961145200331627*^9, 
  3.961145202888132*^9}},ExpressionUUID->"c5a5f286-76f5-6b48-b5f5-\
ea3fb64edbfa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clean", "=", 
   RowBox[{"configRules", "[", 
    RowBox[{"[", 
     RowBox[{";;", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", "\"\<r\>\"", ",", "\"\<init\>\"", 
        ",", "\"\<groups\>\""}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"separated", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "\"\<k\>\"", "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"c", "[", 
            RowBox[{"[", "\"\<r\>\"", "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"c", "[", 
            RowBox[{"[", "\"\<init\>\"", "]"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"group", "[", 
            RowBox[{"[", "\"\<length\>\"", "]"}], "]"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"group", "[", 
            RowBox[{"[", "\"\<rules\>\"", "]"}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"group", ",", 
           RowBox[{"c", "[", 
            RowBox[{"[", "\"\<groups\>\"", "]"}], "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "clean"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"SortBy", "[", 
       RowBox[{"separated", ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "4", "]"}], "]"}], "&"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "10"}], ";;"}], "]"}], "]"}], "[", 
     RowBox[{"[", "All", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"imageList", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<best\>\"", ",", 
          RowBox[{"\"\<tca_\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.png\>\""}]}], 
         "}"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"labeledImages", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Labeled", "[", 
       RowBox[{
        RowBox[{"imageList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{"Column", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<k: \>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"rules", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
                 "Bold", ",", "14"}], "]"}], ",", 
               RowBox[{"\"\<r: \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"rules", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<init: \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"rules", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "3"}], "]"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<length: \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"rules", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "4"}], "]"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<rule: \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"rules", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "5", ",", "1"}], "]"}], "]"}], "]"}]}]}],
               "}"}], ",", 
             RowBox[{"Spacings", "->", "0.2"}]}], "]"}], "]"}], ",", "12"}], 
         "]"}], ",", "Bottom"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "imageList", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"Row", "[", "labeledImages", "]"}], "]"}]}], "Input",

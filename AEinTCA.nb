Cell[BoxData[{
 RowBox[{
  RowBox[{"best", "=", 
   RowBox[{
    RowBox[{"Reverse", "[", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "graph", "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "\"\<length\>\"", "]"}], "]"}], "&"}]}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DrawCA", "[", 
    RowBox[{
     RowBox[{"CellularAutomaton", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{

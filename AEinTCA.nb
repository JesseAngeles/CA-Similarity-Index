        RowBox[{"mutated", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"TestCALifetime", "[", 
            RowBox[{"CellularAutomaton", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "1"}], "}"}], ",", "r"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", "init", "}"}], ",", "0"}], "}"}], ",", "times"}],
              "]"}], "]"}], "&"}], "/@", "mutated"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 

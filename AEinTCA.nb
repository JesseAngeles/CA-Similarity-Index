  3.960823546262826*^9}},ExpressionUUID->"eb045351-7102-be4d-8620-\
a4eafc0bee19"],

Cell["\<\
The total number of TCA rules is given by the following formula:\
\>", "Text",
 CellChangeTimes->{{3.960820510241291*^9, 3.960820582118724*^9}, {
   3.960820694962666*^9, 3.96082070016144*^9}, 3.960820773867292*^9, {
   3.960820888676489*^9, 
   3.960820890970183*^9}},ExpressionUUID->"32720460-a78d-074a-a2a0-\
72de59a15798"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{"|", "rules", "|", "\[LongEqual]", 
       SuperscriptBox[
        StyleBox["k", "TI"], 
        RowBox[{
          RowBox[{"(", 
            RowBox[{"2", 
              StyleBox["r", "TI"], "+", "1"}], ")"}], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["k", "TI"], "-", "1"}], ")"}], "+", "1"}]]}], 
     TraditionalForm], "errors" -> {}, "input" -> 
   "$|\\text{rules}|={k}^{(2 r + 1)(k - 1) +1}$", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.960820584270295*^9, 
  3.9608208610126257`*^9},ExpressionUUID->"9a3c0d82-9fc2-7844-823b-\
3930d36a9af1"],

Cell["Where:", "Text",
 CellChangeTimes->{{3.960820702690914*^9, 
  3.960820707108046*^9}},ExpressionUUID->"bd29acea-304a-bd4b-bfc9-\
a2181e119001"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$k$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39a9cbe3-8bf7-1c4d-ba41-d23d5aca7f54"],
 " is the number of possible states per cell"
}], "Item",
 CellChangeTimes->{{3.960820723613792*^9, 3.960820735654838*^9}, {
  3.9608207831840353`*^9, 
  3.960820784708839*^9}},ExpressionUUID->"f00ebe51-289c-4e40-92df-\
dc423cf59d38"],

Cell[TextData[{
 StyleBox["r ",
  FontSlant->"Italic"],
 "is the neighborhood radius"
}], "Item",
 CellChangeTimes->{{3.960820723613792*^9, 3.960820756142106*^9}, {
  3.96082079242773*^9, 
  3.9608207971425037`*^9}},ExpressionUUID->"9d3f52a3-235d-fe49-a055-\
cd9210d963a8"],

Cell["\<\
This formula accounts for all possible totalistic transition functions.\
\>", "Text",
 CellChangeTimes->{{3.9608208062388077`*^9, 3.960820808111845*^9}, 
   3.9608208738230247`*^9},ExpressionUUID->"222f4a4b-8e2d-9548-b697-\
561972b3de6e"],

Cell[CellGroupData[{

Cell["Filtering totalistic rules", "Subsection",
 CellChangeTimes->{{3.898195524720254*^9, 3.898195535561037*^9}, {
  3.915809133258247*^9, 3.91580913399594*^9}, {3.926609367013923*^9, 
  3.926609368821577*^9}, {3.9266094384454327`*^9, 3.926609440005599*^9}, {
  3.960820215224524*^9, 3.9608202192606573`*^9}},
 CellID->515677554,ExpressionUUID->"37f2e73b-d74c-d349-9015-90a2ef4f6bcd"],

Cell["\<\
The number of TCA rules increases exponentially with the number of states. \
For this reason, it is necessary to apply a series of filters to reduce the \
search space.\
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
   3.802186780928506*^9, 3.802186861789569*^9}, {3.832335906349555*^9, 

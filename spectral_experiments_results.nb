Cell["\<\
De los 256 vectores solo hay 63 unicos y ninguno es el vector cero. \
Clustering con FindClusters:\
\>", "Text",ExpressionUUID->"316d9295-bf74-4012-a7ec-2cdb4f5a94d4"],

Cell[BoxData[
 RowBox[{"clustersEuclid", "=", 
  RowBox[{"FindClusters", "[", 
   RowBox[{"Thread", "[", 
    RowBox[{"momentsVectorsRot14", "->", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "255"}], "]"}]}], "]"}], "]"}]}]], "Input",ExpressionU\
UID->"2f99b10e-986d-4550-bb1e-facf558c08b7"],

Cell[BoxData[
 RowBox[{"clustersCoseno", "=", 
  RowBox[{"FindClusters", "[", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{"momentsVectorsRot14", "->", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "255"}], "]"}]}], "]"}], ",", 
    RowBox[{"DistanceFunction", "->", "CosineDistance"}]}], "]"}]}]], "Input",\
ExpressionUUID->"b47ea59e-626d-462b-aedc-ea1c4b869a1c"],


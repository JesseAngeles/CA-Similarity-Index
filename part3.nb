Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"getRules", "[", 
   RowBox[{"s_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"ParallelMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"#", ",", "s", ",", "n"}], "]"}], "&"}], ",", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"s", "^", 
        RowBox[{"(", 
         RowBox[{"s", "^", "n"}], ")"}]}], "-", "1"}]}], "]"}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.99352501400672*^9, 3.9935250554246283`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"1670fa52-8e26-4ce0-8ea0-6bb84bf09b67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evos", "[", 
   RowBox[{"rules_", ",", "space_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"conect", ",", "inits"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"inits", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"#", ",", 
            RowBox[{"rules", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "space"}], "]"}], 
          "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"rules", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "^", "space"}], "-", 
            "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"conect", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CaArray", "[", 
              RowBox[{
               RowBox[{"rules", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{
             RowBox[{"CaArray", "[", 
              RowBox[{
               RowBox[{"rules", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "&"}], ",", 
          "\[IndentingNewLine]", "inits"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rules", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", 
        RowBox[{"Graph", "[", "conect", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "rules", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",

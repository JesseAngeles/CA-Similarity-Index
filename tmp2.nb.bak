Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PerfilPT", "[", "f_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "f", "]"}]}], ",", "indeg", ",", "per", ",", 
       "trans", ",", "queue", ",", "qi", ",", "v", ",", "w", ",", "c"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"indeg", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "n"}], "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"indeg", "[", 
          RowBox[{"[", 
           RowBox[{"f", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "++"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"per", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "n"}], "]"}]}], ";", 
      RowBox[{"trans", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"(*", 
       RowBox[{"ciclos", ":", 
        RowBox[{"per\[IAcute]odo", " ", "y", " ", "transitorio", " ", "0"}]}],
        "*)"}], 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"visited", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"False", ",", "n"}], "]"}]}], ",", 
          RowBox[{"resto", "=", "indeg"}]}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "pela", " ", "hojas", " ", "para", " ", "marcar", " ", 
          "\[AAcute]rboles"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"queue", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Position", "[", 
            RowBox[{"resto", ",", "0"}], "]"}]}]}], ";", 
         RowBox[{"qi", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"qi", "<=", 
            RowBox[{"Length", "[", "queue", "]"}]}], ",", 
           RowBox[{
            RowBox[{"v", "=", 
             RowBox[{"queue", "[", 
              RowBox[{"[", 
               RowBox[{"qi", "++"}], "]"}], "]"}]}], ";", 
            RowBox[{"w", "=", 
             RowBox[{"f", "[", 
              RowBox[{"[", "v", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"--", 
                RowBox[{"resto", "[", 
                 RowBox[{"[", "w", "]"}], "]"}]}], "==", "0"}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"queue", ",", "w"}], "]"}]}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"resto", "[", 
                RowBox[{"[", "v", "]"}], "]"}], ">", "0"}], "&&", 
              RowBox[{"!", 
               RowBox[{"visited", "[", 
                RowBox[{"[", "v", "]"}], "]"}]}]}], ",", 
             RowBox[{
              RowBox[{"c", "=", 
               RowBox[{"{", "}"}]}], ";", 
              RowBox[{"w", "=", "v"}], ";", "\[IndentingNewLine]", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"visited", "[", 
                  RowBox[{"[", "w", "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"visited", "[", 
                   RowBox[{"[", "w", "]"}], "]"}], "=", "True"}], ";", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"c", ",", "w"}], "]"}], ";", 
                 RowBox[{"w", "=", 
                  RowBox[{"f", "[", 
                   RowBox[{"[", "w", "]"}], "]"}]}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"per", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "=", 
                   RowBox[{"Length", "[", "c", "]"}]}], ";", 
                  RowBox[{
                   RowBox[{"trans", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "=", "0"}]}], ")"}], 
                "&"}], "/@", "c"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"v", ",", "n"}], "}"}]}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"transitorios", ":", 
        RowBox[{
        "propaga", " ", "hacia", " ", "atr\[AAcute]s", " ", "desde", " ", 
         "los", " ", "ciclos"}]}], "*)"}], 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pend", "=", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Position", "[", 
            RowBox[{"trans", ",", 
             RowBox[{"-", "1"}]}], "]"}]}]}], "}"}], ",", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"pend", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"pend", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"pend", ",", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"trans", "[", 
                  RowBox[{"[", 
                   RowBox[{"f", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], ">=", "0"}],
                 ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"trans", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "=", 
                  RowBox[{
                   RowBox[{"trans", "[", 
                    RowBox[{"[", 
                    RowBox[{"f", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "+", 
                   "1"}]}], ";", 
                 RowBox[{
                  RowBox[{"per", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "=", 
                  RowBox[{"per", "[", 
                   RowBox[{"[", 
                    RowBox[{"f", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}]}], ";", 
                 "False"}], ",", "True"}], "]"}], "&"}]}], "]"}]}]}], "]"}]}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{"N", "@", 
          RowBox[{"Log2", "[", "per", "]"}]}], "]"}], ",", 
        RowBox[{"Sort", "[", 
         RowBox[{"N", "@", "trans"}], "]"}]}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DistanciaPT", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pa_", ",", "ta_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pb_", ",", "tb_"}], "}"}], ",", "nn_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Mean", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"pa", "-", "pb"}], "]"}], "]"}], "+", 
      RowBox[{"Mean", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"ta", "-", "tb"}], "]"}], "]"}]}], ")"}], "/", "nn"}]}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"pipeline", " ", "completo"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"perfiles", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PerfilPT", "[", 
      RowBox[{"TransMap", "[", 
       RowBox[{"r", ",", "n"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "1", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "r23"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Dtotal", "=", 
   RowBox[{"Mean", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DistanciaPT", "[", 
          RowBox[{"#1", ",", "#2", ",", "n"}], "]"}], "&"}], ",", 
        RowBox[{"perfiles", "[", 
         RowBox[{"[", "n", "]"}], "]"}], ",", 
        RowBox[{"perfiles", "[", 
         RowBox[{"[", "n", "]"}], "]"}], ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "8"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Similitud", "=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "5"}], " ", "Dtotal"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Lambda]", "=", "5"}], ",", "ajustable"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9928723640524054`*^9, 3.99287236405247*^9}, 
   3.9928734123940907`*^9},ExpressionUUID->"df69bb0b-24b0-4072-a874-\
f41f4838d3de"],


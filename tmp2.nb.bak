Cell[BoxData[
 RowBox[{
  RowBox[{"TransMap", "[", 
   RowBox[{
    RowBox[{"Subscript", "[", 
     RowBox[{"n_", ",", "2", ",", "3"}], "]"}], ",", "space_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tbl", ",", "configs", ",", "idx"}], "}"}], ",", 
    RowBox[{
     RowBox[{"tbl", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"n", ",", "2", ",", "8"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"tabla", ":", 
        RowBox[{"vecindad", " ", "7"}]}], ",", "6", ",", "...", ",", "0"}], 
      "*)"}], 
     RowBox[{"configs", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"2", "^", "space"}], "-", "1"}]}], "]"}], ",", "2", ",", 
        "space"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"idx", "=", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"RotateRight", "/@", "configs"}], ")"}]}], "+", 
       RowBox[{"2", " ", "configs"}], "+", 
       RowBox[{"(", 
        RowBox[{"RotateLeft", "/@", "configs"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"sucesor", " ", "de", " ", "la", " ", "config", " ", "i", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"como", " ", "entero"}], ",", 
         RowBox[{"1", "-", "indexado"}]}], ")"}]}], "*)"}], 

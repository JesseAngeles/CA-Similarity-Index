Cell["Gr\[AAcute]fica (rotaciones)", "Section",ExpressionUUID->"3219d7c3-07c8-4717-9f1d-f69864f53dec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ptsRot", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", "\"\<n\>\"", "]"}], ",", 
       RowBox[{"#", "[", "\"\<Classes\>\"", "]"}]}], "}"}], "&"}], "/@", 
    RowBox[{"Values", "[", 
     RowBox[{"KeySort", "[", "canonRotData", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yScale", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "^", "3"}], "&"}], ",", "CubeRoot"}], "}"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"ptsRot", ",", 
   RowBox[{"PlotMarkers", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", "yScale"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Space size n\>\"", 
      ",", "\"\<Distinct canonical forms (88 rules)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameTicks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "20", ",", "40", ",", "60", ",", "70", ",", "80", ",", "82", ",", 
          "84", ",", "85", ",", "88"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"81", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<81 (4 inheritance)\>\"", ",", "10", ",", "Gray"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"88", ",", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<88 (state permutation, mirror)\>\"", ",", "10", ",",
               "Gray"}], "]"}]}], "}"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "Automatic"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"81", ",", "88"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"GridLinesStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Gray", ",", "Dashed"}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "90"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "600"}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Classes by canonical form of the rotation quotient graph (ECA)\
\>\""}]}], "]"}]}], "Input",ExpressionUUID->"0c5649ed-c830-49e9-85eb-\
943154598d28"],


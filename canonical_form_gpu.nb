                    RowBox[{"{", 
                    RowBox[{"m", ",", "0", ",", 
                    RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}], ";", 
                  RowBox[{"code", "=", 
                   RowBox[{"Cast", "[", 
                    RowBox[{
                    "z", ",", "\"\<Integer64\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}]}], "]"}], ";", 
                RowBox[{"ci", "++"}], ";", 
                RowBox[{
                 RowBox[{"codes", "[", 
                  RowBox[{"[", "ci", "]"}], "]"}], "=", "code"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "c"}], "}"}]}], "]"}], ";", 
           RowBox[{"DeleteObject", "[", "mark", "]"}], ";", "codes"}]}], 
         "]"}]}], "]"}], "]"}]}], "]"}]}], ";"}]], "Input",

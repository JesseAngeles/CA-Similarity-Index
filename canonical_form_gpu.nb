Cell[CellGroupData[{

Cell["Experimento: n = 1, \[Ellipsis], 29", "Section",ExpressionUUID->"863e25e9-64c1-4742-92da-9c782c1e2dbd"],

Cell[TextData[{
 "Cada tama\[NTilde]o se guarda en ",
 Cell[BoxData[Cell["canonical_form_gpu_data.wl",
   Background->None,ExpressionUUID->"b041a8b1-a5fa-42ce-bd77-04ceeb9ce72e"]], 
  "InlineCode",ExpressionUUID->"70bb9a28-ae2f-4f64-ba4d-370151200034"],
 " al terminar, as\[IAcute] que si la corrida se interrumpe contin\[UAcute]a \
desde el \[UAcute]ltimo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ae506eb-397f-4d9f-94cc-e28eb53699e6"],
 " completo. "
}], "Text",ExpressionUUID->"f002b9b5-ead3-48af-9361-393280c60ed6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nMax", "=", "29"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}]}], 
      ",", "\"\<canonical_form_gpu_data.wl\>\""}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFile", "]"}], ",", 
     RowBox[{"Get", "[", "dataFile", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", " ", 
       RowBox[{"KeyExistsQ", "[", 
        RowBox[{"results", ",", "n"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"buf", "=", 
           RowBox[{"AllocateCanon", "[", "n", "]"}]}], ",", "rows", ",", 
          "t"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"First", "@", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"rows", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"CanonicalFormGPU", "[", 
                RowBox[{"r", ",", "buf"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "ecaReps"}], "}"}]}], "]"}]}], "]"}]}]}], ";",
          "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"results", "[", "n", "]"}], "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
            RowBox[{"\"\<Seconds\>\"", "->", "t"}], ",", 
            RowBox[{"\"\<Classes\>\"", "->", 
             RowBox[{"CountDistinct", "[", 
              RowBox[{"rows", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<Canonical\>\""}], "]"}], "]"}], 
              "]"}]}], ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Groups\>\"", "->", 
             RowBox[{"Values", "[", 
              RowBox[{"GroupBy", "[", 
               RowBox[{"rows", ",", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Canonical\>\"", "]"}], " ", "&"}], ",", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}], " ", 
                 "&"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Rules\>\"", "->", "rows"}]}], "|>"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"Put", "[", 
          RowBox[{"results", ",", "dataFile"}], "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<n\>\"", ",", "\"\<Classes\>\"", ",", "\"\<Seconds\>\""}], 
       "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", "results", "]"}], "]"}]}], "]"}]}], "Input",
 CellLabel->
  " In[24]:=",ExpressionUUID->"109ab04c-2796-4ef0-81b7-04f882e15478"],


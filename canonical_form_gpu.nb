Cell[CellGroupData[{

Cell["Cociente por rotaciones", "Section",ExpressionUUID->"7297c74b-cf3e-4cbf-a256-f490c60f36e5"],

Cell["\<\
Mismo experimento, pero sobre el grafo cociente por rotaciones (el de \
MakeGraphRot): cada nodo es una clase de configuraciones bajo \
rotaci\[OAcute]n c\[IAcute]clica, representada por su rotaci\[OAcute]n m\
\[IAcute]nima, y la arista va de [x] a [F(x)]. Como F conmuta con la rotaci\
\[OAcute]n, la arista est\[AAcute] bien definida. El n\[UAcute]mero de nodos \
baja de 2^n a unos 2^n/n (collares binarios): para n = 29 son 18 512 792 \
nodos y el c\[AAcute]lculo de las 88 reglas tarda 36 s.\
\>", "Text",ExpressionUUID->"5c7df4f6-6176-4ab3-97db-58bc67517f38"],

Cell["\<\
Solo cambia el c\[AAcute]lculo de sucesores. kRepMark marca los \
representantes (un hilo por configuraci\[OAcute]n, rotaci\[OAcute]n \
m\[IAcute]nima con n \[Minus] 1 rotaciones de bits) y guarda su \
\[IAcute]ndice compacto; kSuccRot aplica la regla al representante, rota el \
resultado a su m\[IAcute]nimo y busca su \[IAcute]ndice. La poda, los ciclos \
y la rotaci\[OAcute]n m\[IAcute]nima de cada ciclo usan los mismos kernels de \
arriba (kDeg, kSeed, kStep, kStepSmall, kCycA, kCycB, kCycH y cycleCodesC).\
\>", "Text",ExpressionUUID->"748c012a-26db-497a-a420-aa5722a02167"],

Cell["\<\
Validaci\[OAcute]n: para n = 1..9 la partici\[OAcute]n de las 88 reglas \
coincide con la que se obtiene en CPU construyendo el grafo cociente y \
agrupando con IsomorphicGraphQ.\
\>", "Text",ExpressionUUID->"b51577ee-31c2-4c2f-85fb-79843fdb2c0c"],

Cell[CellGroupData[{

Cell["Kernels del cociente", "Subsection",ExpressionUUID->"d12f769a-5ca0-4bea-9a07-56ab3e9a9cff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Representantes", " ", "de", " ", "las", " ", "clases", " ", "de", " ", 
    RowBox[{"rotaci\[OAcute]n", ":", " ", 
     RowBox[{
     "configuraciones", " ", "iguales", " ", "a", " ", "su", " ", 
      "rotaci\[OAcute]n", " ", 
      RowBox[{"m\[IAcute]nima", ".", " ", 
       RowBox[{"idx", "[", "x", "]"}]}], " ", "guarda", " ", "el", " ", 
      "\[IAcute]ndice", " ", "compacto", " ", "de", " ", "cada", " ", 
      "representante"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"kRepMark", "=", 
   RowBox[{"cudaFn", "[", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"reps", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"idx", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"cnt", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"n", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"total", ",", "\"\<MachineInteger\>\""}], "]"}]}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "id", ",", "x", ",", "y", ",", "m", ",", "mask", ",", "k", ",", 
          "i"}], "}"}], ",", 
        RowBox[{
         RowBox[{"id", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "LibraryFunction", "[", "\"\<BlockDimensions.x\>\"", "]"}], "[", 
             "]"}], "*", 
            RowBox[{
             RowBox[{"LibraryFunction", "[", "\"\<BlockID.x\>\"", "]"}], "[", 
             "]"}]}], "+", 
           RowBox[{
            RowBox[{"LibraryFunction", "[", "\"\<ThreadID.x\>\"", "]"}], "[", 
            "]"}]}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"id", "<", "total"}], ",", 
           RowBox[{
            RowBox[{"x", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
              "id", ",", "\"\<UnsignedInteger64\>\"", ",", "\"\<CCast\>\""}], 
              "]"}]}], ";", 
            RowBox[{"mask", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
               RowBox[{"total", "-", "1"}], ",", "\"\<UnsignedInteger64\>\"", 
               ",", "\"\<CCast\>\""}], "]"}]}], ";", 
            RowBox[{"m", "=", "x"}], ";", 
            RowBox[{"y", "=", "x"}], ";", 
            RowBox[{"k", "=", "1"}], ";", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"k", "<", "n"}], ",", 
              RowBox[{
               RowBox[{"y", "=", 
                RowBox[{"BitAnd", "[", 
                 RowBox[{
                  RowBox[{"BitOr", "[", 
                   RowBox[{
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"y", ",", "1"}], "]"}], ",", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"y", ",", 
                    RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}], ",", "mask"}], 
                 "]"}]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"y", "<", "m"}], ",", 
                 RowBox[{"m", "=", "y"}]}], "]"}], ";", 
               RowBox[{"k", "=", 
                RowBox[{"k", "+", "1"}]}]}]}], "]"}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"m", "==", "x"}], ",", 
              RowBox[{
               RowBox[{"i", "=", 
                RowBox[{"Compile`AtomicUpdate", "[", 
                 RowBox[{"cnt", ",", "0", ",", "\"\<Plus\>\"", ",", 
                  RowBox[{"Cast", "[", 
                   RowBox[{
                   "1", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                   "]"}]}], "]"}]}], ";", 
               RowBox[{"ToRawPointer", "[", 
                RowBox[{"reps", ",", "i", ",", 
                 RowBox[{"Cast", "[", 
                  RowBox[{
                  "id", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                  "]"}]}], "]"}], ";", 
               RowBox[{"ToRawPointer", "[", 
                RowBox[{"idx", ",", "id", ",", "i"}], "]"}]}]}], "]"}]}]}], 
          "]"}], ";"}]}], "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"(*", " ", 
  RowBox[{"Sucesor", " ", "en", " ", "el", " ", 
   RowBox[{"cociente", ":", " ", 
    RowBox[{
    "se", " ", "aplica", " ", "la", " ", "regla", " ", "al", " ", 
     "representante", " ", "y", " ", "se", " ", "busca", " ", "el", " ", 
     "\[IAcute]ndice", " ", "de", " ", "la", " ", "rotaci\[OAcute]n", " ", 
     "m\[IAcute]nima", " ", "del", " ", "resultado"}]}]}], " ", 
  "*)"}], "\n", 
 RowBox[{
  RowBox[{"kSuccRot", "=", 
   RowBox[{"cudaFn", "[", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Typed", "[", 
         RowBox[{"succ", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"pend", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"acc", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer64\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"reps", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"idx", ",", 
          RowBox[{
           RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
           "[", "\"\<Integer32\>\"", "]"}]}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"rule", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"n", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"total", ",", "\"\<MachineInteger\>\""}], "]"}], ",", 
        RowBox[{"Typed", "[", 
         RowBox[{"nr", ",", "\"\<MachineInteger\>\""}], "]"}]}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "id", ",", "x", ",", "mask", ",", "l", ",", "r", ",", "nx", ",", "a",
           ",", "b", ",", "c", ",", "y", ",", "m", ",", "k"}], "}"}], ",", 
        RowBox[{
         RowBox[{"id", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
             "LibraryFunction", "[", "\"\<BlockDimensions.x\>\"", "]"}], "[", 
             "]"}], "*", 
            RowBox[{
             RowBox[{"LibraryFunction", "[", "\"\<BlockID.x\>\"", "]"}], "[", 
             "]"}]}], "+", 
           RowBox[{
            RowBox[{"LibraryFunction", "[", "\"\<ThreadID.x\>\"", "]"}], "[", 
            "]"}]}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"id", "<", "nr"}], ",", 
           RowBox[{
            RowBox[{"x", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
               RowBox[{"FromRawPointer", "[", 
                RowBox[{"reps", ",", "id"}], "]"}], 
               ",", "\"\<UnsignedInteger64\>\"", ",", "\"\<CCast\>\""}], 
              "]"}]}], ";", 
            RowBox[{"mask", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
               RowBox[{"total", "-", "1"}], ",", "\"\<UnsignedInteger64\>\"", 
               ",", "\"\<CCast\>\""}], "]"}]}], ";", 
            RowBox[{"l", "=", 
             RowBox[{"BitAnd", "[", 
              RowBox[{
               RowBox[{"BitOr", "[", 
                RowBox[{
                 RowBox[{"BitShiftRight", "[", 
                  RowBox[{"x", ",", "1"}], "]"}], ",", 
                 RowBox[{"BitShiftLeft", "[", 
                  RowBox[{"x", ",", 
                   RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}], ",", "mask"}], 
              "]"}]}], ";", 
            RowBox[{"r", "=", 
             RowBox[{"BitAnd", "[", 
              RowBox[{
               RowBox[{"BitOr", "[", 
                RowBox[{
                 RowBox[{"BitShiftLeft", "[", 
                  RowBox[{"x", ",", "1"}], "]"}], ",", 
                 RowBox[{"BitShiftRight", "[", 
                  RowBox[{"x", ",", 
                   RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}], ",", "mask"}], 
              "]"}]}], ";", 
            RowBox[{"nx", "=", 
             RowBox[{"Cast", "[", 
              RowBox[{
              "0", ",", "\"\<UnsignedInteger64\>\"", ",", "\"\<CCast\>\""}], 
              "]"}]}], ";", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"BitAnd", "[", 
                  RowBox[{
                   RowBox[{"BitShiftRight", "[", 
                    RowBox[{"rule", ",", "v"}], "]"}], ",", "1"}], "]"}], "==",
                  "1"}], ",", 
                RowBox[{
                 RowBox[{"a", "=", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"v", ",", "4"}], "]"}], "!=", "0"}], ",", "l", ",", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{"l", ",", "mask"}], "]"}]}], "]"}]}], ";", 
                 RowBox[{"b", "=", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"v", ",", "2"}], "]"}], "!=", "0"}], ",", "x", ",", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{"x", ",", "mask"}], "]"}]}], "]"}]}], ";", 
                 RowBox[{"c", "=", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"v", ",", "1"}], "]"}], "!=", "0"}], ",", "r", ",", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{"r", ",", "mask"}], "]"}]}], "]"}]}], ";", 
                 RowBox[{"nx", "=", 
                  RowBox[{"BitOr", "[", 
                   RowBox[{"nx", ",", 
                    RowBox[{"BitAnd", "[", 
                    RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{"a", ",", "b"}], "]"}], ",", "c"}], "]"}]}], 
                   "]"}]}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"v", ",", "0", ",", "7"}], "}"}]}], "]"}], ";", 
            RowBox[{"m", "=", "nx"}], ";", 
            RowBox[{"y", "=", "nx"}], ";", 
            RowBox[{"k", "=", "1"}], ";", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"k", "<", "n"}], ",", 
              RowBox[{
               RowBox[{"y", "=", 
                RowBox[{"BitAnd", "[", 
                 RowBox[{
                  RowBox[{"BitOr", "[", 
                   RowBox[{
                    RowBox[{"BitShiftLeft", "[", 
                    RowBox[{"y", ",", "1"}], "]"}], ",", 
                    RowBox[{"BitShiftRight", "[", 
                    RowBox[{"y", ",", 
                    RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}], ",", "mask"}], 
                 "]"}]}], ";", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"y", "<", "m"}], ",", 
                 RowBox[{"m", "=", "y"}]}], "]"}], ";", 
               RowBox[{"k", "=", 
                RowBox[{"k", "+", "1"}]}]}]}], "]"}], ";", 
            RowBox[{"ToRawPointer", "[", 
             RowBox[{"succ", ",", "id", ",", 
              RowBox[{"FromRawPointer", "[", 
               RowBox[{"idx", ",", 
                RowBox[{"Cast", "[", 
                 RowBox[{
                 "m", ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                 "]"}]}], "]"}]}], "]"}], ";", 
            RowBox[{"ToRawPointer", "[", 
             RowBox[{"pend", ",", "id", ",", 
              RowBox[{"Cast", "[", 
               RowBox[{"0", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
               "]"}]}], "]"}], ";", 
            RowBox[{"ToRawPointer", "[", 
             RowBox[{"acc", ",", "id", ",", 
              RowBox[{"Cast", "[", 
               RowBox[{"0", ",", "\"\<Integer64\>\"", ",", "\"\<CCast\>\""}], 
               "]"}]}], "]"}]}]}], "]"}], ";"}]}], "]"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"9060fda2-b844-4924-aac3-7756538bf608"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Forma can\[OAcute]nica de una regla (cociente)", "Subsection",ExpressionUUID->"e3ecd9b3-c8b3-4e0f-bc41-03e055b3f817"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Los", " ", "representantes", " ", "solo", " ", "dependen", " ", "de", " ", 
    RowBox[{"n", ":", " ", 
     RowBox[{
     "se", " ", "calculan", " ", "una", " ", "vez", " ", "por", " ", 
      "tama\[NTilde]o"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AllocateCanonRot", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"total", "=", 
        RowBox[{"2", "^", "n"}]}], ",", "cnt", ",", "reps", ",", "idx", ",", 
       "nr", ",", "z32"}], "}"}], ",", 
     RowBox[{
      RowBox[{"reps", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"zerosNA", "[", 
         RowBox[{"\"\<Integer32\>\"", ",", "total"}], "]"}], "]"}]}], ";", 
      RowBox[{"idx", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"zerosNA", "[", 
         RowBox[{"\"\<Integer32\>\"", ",", "total"}], "]"}], "]"}]}], ";", 
      RowBox[{"cnt", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"NumericArray", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "8"}], "]"}], ",", "\"\<Integer32\>\""}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"kRepMark", "[", 
       RowBox[{"reps", ",", "idx", ",", "cnt", ",", "n", ",", "total"}], 
       "]"}], ";", 
      RowBox[{"nr", "=", 
       RowBox[{"First", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"reps", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"NumericArray", "[", "reps", "]"}], ",", "nr"}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"z32", "=", 
       RowBox[{"zerosNA", "[", 
        RowBox[{"\"\<Integer32\>\"", ",", "nr"}], "]"}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<N\>\"", "->", "nr"}], ",", 
        RowBox[{"\"\<total\>\"", "->", "total"}], ",", 
        RowBox[{"\"\<reps\>\"", "->", "reps"}], ",", 
        RowBox[{"\"\<idx\>\"", "->", "idx"}], ",", 
        RowBox[{"\"\<succ\>\"", "->", 
         RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", 
        RowBox[{"\"\<pend\>\"", "->", 
         RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", 
        RowBox[{"\"\<q\>\"", "->", 
         RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", 
        RowBox[{"\"\<acc\>\"", "->", 
         RowBox[{"GPUArray", "[", 
          RowBox[{"zerosNA", "[", 
           RowBox[{"\"\<Integer64\>\"", ",", "nr"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<h\>\"", "->", 
         RowBox[{"GPUArray", "[", 
          RowBox[{"zerosNA", "[", 
           RowBox[{"\"\<Integer64\>\"", ",", 
            RowBox[{"Min", "[", 
             RowBox[{"nr", ",", "$chunk"}], "]"}]}], "]"}], "]"}]}]}], 
       "|>"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"Igual", " ", "que", " ", "CanonicalFormGPU"}], ",", " ", 
   RowBox[{
   "pero", " ", "sobre", " ", "los", " ", "nr", " ", "nodos", " ", "del", " ",
     "cociente"}]}], " ", "*)"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CanonicalFormRotGPU", "[", 
    RowBox[{"rule_Integer", ",", "buf_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"buf", "[", "\"\<n\>\"", "]"}]}], ",", 
       RowBox[{"total", "=", 
        RowBox[{"buf", "[", "\"\<N\>\"", "]"}]}], ",", "cnt", ",", 
       RowBox[{"start", "=", "0"}], ",", "end", ",", 
       RowBox[{"height", "=", "0"}], ",", "len", ",", "nGoE", ",", "c", ",", 
       "nxt", ",", "h", ",", "codes"}], "}"}], ",", 
     RowBox[{
      RowBox[{"kSuccRot", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<reps\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<idx\>\"", "]"}], ",", "rule", ",", "n", ",", 
        
        RowBox[{"buf", "[", "\"\<total\>\"", "]"}], ",", "total", ",", 
        RowBox[{"\"\<GridDimensions\>\"", "->", 
         RowBox[{
          RowBox[{"Quotient", "[", 
           RowBox[{
            RowBox[{"total", "-", "1"}], ",", "256"}], "]"}], "+", "1"}]}], ",", 
        RowBox[{"\"\<BlockDimensions\>\"", "->", "256"}]}], "]"}], ";", 
      RowBox[{"kDeg", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", "total"}], "]"}], ";", 
      RowBox[{"cnt", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"NumericArray", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "8"}], "]"}], ",", "\"\<Integer32\>\""}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"kSeed", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", "cnt", ",", "total"}], 
       "]"}], ";", 
      RowBox[{"kAdvance", "[", 
       RowBox[{"cnt", ",", "0", ",", 
        RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<BlockDimensions\>\"", "->", "1"}]}], "]"}], ";", 
      RowBox[{"nGoE", "=", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"start", ",", "end"}], "}"}], "=", 
          RowBox[{
           RowBox[{"Normal", "[", 
            RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"3", ";;", "4"}], "]"}], "]"}]}], ";", 
         RowBox[{"end", ">", "start"}]}], ",", 
        RowBox[{
         RowBox[{"len", "=", 
          RowBox[{"end", "-", "start"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"len", ">", "$smallLevel"}], ",", 
           RowBox[{
            RowBox[{"kStep", "[", 
             RowBox[{
              RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", 
              "start", ",", "len", ",", 
              RowBox[{"\"\<GridDimensions\>\"", "->", 
               RowBox[{
                RowBox[{"Quotient", "[", 
                 RowBox[{
                  RowBox[{"len", "-", "1"}], ",", "256"}], "]"}], "+", 
                "1"}]}], ",", 
              RowBox[{"\"\<BlockDimensions\>\"", "->", "256"}]}], "]"}], ";", 
            
            RowBox[{"kAdvance", "[", 
             RowBox[{"cnt", ",", "1", ",", 
              RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
              RowBox[{"\"\<BlockDimensions\>\"", "->", "1"}]}], "]"}]}], ",", 
           
           RowBox[{"kStepSmall", "[", 
            RowBox[{
             RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", 
             "$smallLevel", ",", 
             RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<BlockDimensions\>\"", "->", "1024"}]}], "]"}]}], 
          "]"}]}]}], "]"}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"end", ",", "height"}], "}"}], "=", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "5"}], "}"}], "]"}], "]"}]}], ";", 
      RowBox[{"c", "=", 
       RowBox[{"total", "-", "end"}]}], ";", 
      RowBox[{"kCycA", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", "total"}], 
       "]"}], ";", 
      RowBox[{"kCycB", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", "total"}], "]"}], ";", 
      RowBox[{"h", "=", 
       RowBox[{"Join", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"kCycH", "[", 
            RowBox[{
             RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<h\>\"", "]"}], ",", "off", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"$chunk", ",", 
               RowBox[{"c", "-", "off"}]}], "]"}], ",", "total"}], "]"}], ";", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"NumericArray", "[", 
              RowBox[{"buf", "[", "\"\<h\>\"", "]"}], "]"}], ",", 
             RowBox[{"Min", "[", 
              RowBox[{"$chunk", ",", 
               RowBox[{"c", "-", "off"}]}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"off", ",", "0", ",", 
            RowBox[{"c", "-", "1"}], ",", "$chunk"}], "}"}]}], "]"}]}]}], ";", 
      RowBox[{"nxt", "=", 
       RowBox[{"NumericArray", "[", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], "]"}]}], ";", 
      RowBox[{"codes", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"cycleCodesC", "[", 
         RowBox[{"nxt", ",", "h", ",", "c"}], "]"}], "]"}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
        RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<Nodes\>\"", "->", "total"}], ",", 
        RowBox[{"\"\<GardenOfEden\>\"", "->", "nGoE"}], ",", 
        RowBox[{"\"\<Height\>\"", "->", "height"}], ",", 
        RowBox[{"\"\<CycleNodes\>\"", "->", "c"}], ",", 
        RowBox[{"\"\<Cycles\>\"", "->", 
         RowBox[{"Length", "[", "codes", "]"}]}], ",", 
        RowBox[{"\"\<Canonical\>\"", "->", 
         RowBox[{"Hash", "[", "codes", "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"9a322860-a5e9-4599-bf8a-a025e77efc87"]
}, Open  ]]

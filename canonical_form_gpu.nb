Cell[CellGroupData[{

Cell["Las 88 reglas representantes", "Subsection",ExpressionUUID->"1e4d1824-ef24-46e3-a64b-55d5e8059cc6"],

Cell["\<\
M\[IAcute]nimo de cada clase bajo espejo e inverso (complemento de estados). \
\
\>", "Text",ExpressionUUID->"3df450be-a4d8-48a0-b036-a5b9bf750aba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mirrorRule", "[", "r_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"BitGet", "[", 
       RowBox[{"r", ",", 
        RowBox[{
         RowBox[{"4", " ", 
          RowBox[{"BitGet", "[", 
           RowBox[{"v", ",", "0"}], "]"}]}], "+", 
         RowBox[{"2", " ", 
          RowBox[{"BitGet", "[", 
           RowBox[{"v", ",", "1"}], "]"}]}], "+", 
         RowBox[{"BitGet", "[", 
          RowBox[{"v", ",", "2"}], "]"}]}]}], "]"}], " ", 
      RowBox[{"2", "^", "v"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"complementRule", "[", "r_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"BitGet", "[", 
         RowBox[{"r", ",", 
          RowBox[{"7", "-", "v"}]}], "]"}]}], ")"}], " ", 
      RowBox[{"2", "^", "v"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ecaReps", "=", 
   RowBox[{"Union", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"r", ",", 
        RowBox[{"mirrorRule", "[", "r", "]"}], ",", 
        RowBox[{"complementRule", "[", "r", "]"}], ",", 
        RowBox[{"mirrorRule", "[", 
         RowBox[{"complementRule", "[", "r", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "ecaReps", "]"}]}], "Input",
 CellLabel->
  " In[20]:=",ExpressionUUID->"b75fe7eb-b372-4866-8703-484388b076f3"],


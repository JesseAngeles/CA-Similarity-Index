Cell["Forma can\[OAcute]nica de una regla", "Subsection",ExpressionUUID->"6f78c7a9-a636-4672-aa62-38f62a45d536"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zerosNA", "[", 
    RowBox[{"type_", ",", "total_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", "=", 
       RowBox[{"NumericArray", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"total", ",", 
             RowBox[{"2", "^", "20"}]}], "]"}]}], "]"}], ",", "type"}], 
        "]"}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "z", "]"}], "<", "total"}], ",", 
        RowBox[{"z", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"z", ",", "z"}], "]"}]}]}], "]"}], ";", " ", "z"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$chunk", "=", 
   RowBox[{"2", "^", "26"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$smallLevel", "=", "16384"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Reserva", " ", "de", " ", "memoria", " ", "en", " ", "GPU", " ", "para", " ",
     "un", " ", "tamano", " ", "n", " ", 
    RowBox[{"(", 
     RowBox[{
     "se", " ", "reutiliza", " ", "para", " ", "todas", " ", "las", " ", 
      "reglas"}], ")"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AllocateCanon", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"total", "=", 
         RowBox[{"2", "^", "n"}]}], ",", "z32"}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"z32", "=", 
        RowBox[{"zerosNA", "[", 
         RowBox[{"\"\<Integer32\>\"", ",", "total"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
         RowBox[{"\"\<N\>\"", "->", "total"}], ",", 
         RowBox[{"\"\<succ\>\"", "->", 
          RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", 
         RowBox[{"\"\<pend\>\"", "->", 
          RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", 
         RowBox[{"\"\<q\>\"", "->", 
          RowBox[{"GPUArray", "[", "z32", "]"}]}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<acc\>\"", "->", 
          RowBox[{"GPUArray", "[", 
           RowBox[{"zerosNA", "[", 
            RowBox[{"\"\<Integer64\>\"", ",", "total"}], "]"}], "]"}]}], ",", 
         
         RowBox[{"\"\<h\>\"", "->", 
          RowBox[{"GPUArray", "[", 
           RowBox[{"zerosNA", "[", 
            RowBox[{"\"\<Integer64\>\"", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"total", ",", "$chunk"}], "]"}]}], "]"}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CanonicalFormGPU", "[", 
    RowBox[{"rule_Integer", ",", "buf_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"buf", "[", "\"\<n\>\"", "]"}]}], ",", 
       RowBox[{"total", "=", 
        RowBox[{"buf", "[", "\"\<N\>\"", "]"}]}], ",", "cnt", ",", 
       RowBox[{"start", "=", "0"}], ",", "end", ",", 
       RowBox[{"height", "=", "0"}], ",", "len", ",", "\[IndentingNewLine]", 
       "    ", "nGoE", ",", "c", ",", "nxt", ",", "h", ",", "codes"}], "}"}], 
     ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"kSucc", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "rule", ",", "n", ",", 
        "total"}], "]"}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"kDeg", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", "total"}], "]"}], ";",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"cnt", "=", 
       RowBox[{"GPUArray", "[", 
        RowBox[{"NumericArray", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "8"}], "]"}], ",", "\"\<Integer32\>\""}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"kSeed", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", "cnt", ",", "total"}], 
       "]"}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"kAdvance", "[", 
       RowBox[{"cnt", ",", "0", ",", 
        RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<BlockDimensions\>\"", "->", "1"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"nGoE", "=", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"start", ",", "end"}], "}"}], "=", 
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"3", " ", ";;", " ", "4"}], "]"}], "]"}]}], ";", " ", 
          RowBox[{"end", ">", "start"}]}], ")"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"len", "=", 
          RowBox[{"end", "-", "start"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"len", ">", "$smallLevel"}], ",", "\[IndentingNewLine]", 
           "     ", 
           RowBox[{
            RowBox[{"kStep", "[", 
             RowBox[{
              RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
              RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", 
              "start", ",", "len", ",", "\[IndentingNewLine]", "      ", 
              RowBox[{"\"\<GridDimensions\>\"", "->", 
               RowBox[{
                RowBox[{"Quotient", "[", 
                 RowBox[{
                  RowBox[{"len", "-", "1"}], ",", "256"}], "]"}], "+", 
                "1"}]}], ",", 
              RowBox[{"\"\<BlockDimensions\>\"", "->", "256"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "     ", 
            RowBox[{"kAdvance", "[", 
             RowBox[{"cnt", ",", "1", ",", 
              RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
              RowBox[{"\"\<BlockDimensions\>\"", "->", "1"}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", "     ", 
           RowBox[{"kStepSmall", "[", 
            RowBox[{
             RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", 
             "$smallLevel", ",", "\[IndentingNewLine]", "      ", 
             RowBox[{"\"\<GridDimensions\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<BlockDimensions\>\"", "->", "1024"}]}], "]"}]}], 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"end", ",", "height"}], "}"}], "=", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"NumericArray", "[", "cnt", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "5"}], "}"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"c", "=", 
       RowBox[{"total", "-", "end"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"kCycA", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", "cnt", ",", "total"}], 
       "]"}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"kCycB", "[", 
       RowBox[{
        RowBox[{"buf", "[", "\"\<succ\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], ",", "total"}], "]"}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"h", "=", 
       RowBox[{"Join", " ", "@@", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"kCycH", "[", 
            RowBox[{
             RowBox[{"buf", "[", "\"\<pend\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<acc\>\"", "]"}], ",", 
             RowBox[{"buf", "[", "\"\<h\>\"", "]"}], ",", "off", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"$chunk", ",", 
               RowBox[{"c", "-", "off"}]}], "]"}], ",", "total"}], "]"}], ";",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"NumericArray", "[", 
              RowBox[{"buf", "[", "\"\<h\>\"", "]"}], "]"}], ",", 
             RowBox[{"Min", "[", 
              RowBox[{"$chunk", ",", 
               RowBox[{"c", "-", "off"}]}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"off", ",", "0", ",", 
            RowBox[{"c", "-", "1"}], ",", "$chunk"}], "}"}]}], "]"}]}]}], ";",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"nxt", "=", 
       RowBox[{"NumericArray", "[", 
        RowBox[{"buf", "[", "\"\<q\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"codes", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"cycleCodesC", "[", 
         RowBox[{"nxt", ",", "h", ",", "c"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Rule\>\"", "->", "rule"}], ",", 
        RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<GardenOfEden\>\"", "->", "nGoE"}], ",", 
        RowBox[{"\"\<Height\>\"", "->", "height"}], ",", 
        RowBox[{"\"\<CycleNodes\>\"", "->", "c"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Cycles\>\"", "->", 
         RowBox[{"Length", "[", "codes", "]"}]}], ",", 
        RowBox[{"\"\<Canonical\>\"", "->", 
         RowBox[{"Hash", "[", "codes", "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",

Cell[CellGroupData[{

Cell["Experimento con rotaciones: n = 1, \[Ellipsis], 29", "Section",ExpressionUUID->"be80a744-a14b-4157-8ca2-3cf24bae6954"],

Cell["\<\
Cada tama\[NTilde]o se guarda en canonical_form_rot_gpu_data.wl; si el \
archivo existe, solo se calculan los tama\[NTilde]os que faltan. Requiere las \
celdas de Funciones y nMax de la secci\[OAcute]n del grafo completo.\
\>", "Text",ExpressionUUID->"07b9b1c7-42be-4a28-9793-7d11a1c7cf6c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataFileRot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], 
      ",", "\"\<canonical_form_rot_gpu_data.wl\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"resultsRot", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "dataFileRot", "]"}], ",", 
     RowBox[{"Get", "[", "dataFileRot", "]"}], ",", 
     RowBox[{"<|", "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{

Cell[TextData[{
 "Hipotesis: El tama\[NTilde]o ideal del espacio para comparar el tama\
\[NTilde]o de 2 reglas, no tiene que ser multiplo del numero de estados. Para \
2 estados, no hay que comparar con espacios pares, vamos a hacer la prueba \
con 3, pero unicamente para ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        RowBox[{"3", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{3,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5e8d51f4-0b32-4470-8e43-db538c8c56cf"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{3,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d24c7b47-3fa8-4b2e-b090-c05e7097f0aa"],
 " porque querer computar mas es practicamente imposible."
}], "Text",
 CellChangeTimes->{{3.993618248194395*^9, 
  3.993618356361854*^9}},ExpressionUUID->"96344dc5-b337-4412-9e60-\
65d8be160d76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nrs", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"data", "[", "\"\<neighbor\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "==", "3"}], "&"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nrs", "=", 
   RowBox[{"List", "@@@", 
    RowBox[{"EdgeList", "[", 
     RowBox[{"TransitiveClosureGraph", "[", "nrs", "]"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9936183957590523`*^9, 3.9936184506323338`*^9}, {
  3.993620378324888*^9, 3.993620510483348*^9}},
 CellLabel->

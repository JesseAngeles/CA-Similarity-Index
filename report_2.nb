          RowBox[{"groups", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"#", ",", "1"}], "]"}], "==", "i"}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"legends", "=", 

Cell[TextData[{
 "Esto nos dice que si queremos medir la similitud entre todas las reglas en ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        RowBox[{"2", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{2,3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "941f44ee-a815-44fd-b333-20826a619bd9"],
 " con las reglas en ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{2,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd817f3a-ddeb-4409-af9a-00e6b3ddf9d6"],
 " es mejor usar un espacio impar, ahora es normal preguntarse \
\[DownQuestion]Porque un espacio impar? \[DownQuestion]Esto aplica todas las \
relaciones que tengan 2 estados? Para intentar responder estas preguntas \
haremos el experimento para medir todas las relaciones de eliminacion de \
vecinos de forma interativa, es decir, incluir el analisis de ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{2,1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b40aff2-6186-4014-9a44-e09d372f5968"],
 " y comparar los tres para ver si existe alg\[UAcute]n patr\[OAcute]n. "
}], "Text",
 CellChangeTimes->{{3.993617072238626*^9, 3.9936170766285667`*^9}, {
  3.993617123394981*^9, 3.993617160159855*^9}, {3.9936171925178137`*^9, 
  3.993617310851224*^9}, {3.9936181267844133`*^9, 
  3.99361813303439*^9}},ExpressionUUID->"046ecbc0-9bfb-42c2-86c1-\
ecaeadaa60ec"],

Cell["\<\
Con el grafo de todas las reglas con 2 estados y 1,2 y 3 vecinos, obtenemos \
todas las transiciones con TransitiveClosureGraph (si a->b y b->c entonces \
a->c) y vemos que todas, en un espacio impar, tienen una similitud de 1, si \
es par, solo algunos casos difieren. \
\>", "Text",
 CellChangeTimes->{{3.993618135221534*^9, 
  3.993618242501857*^9}},ExpressionUUID->"93e6a9e5-8ba9-470b-8fa1-\
9e7841248988"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nrs", "=", 
   RowBox[{
    RowBox[{"addData", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"getRules", "[", 
        RowBox[{"2", ",", "3"}], "]"}], ",", 
       RowBox[{"getRules", "[", 
        RowBox[{"2", ",", "2"}], "]"}], ",", 
       RowBox[{"getRules", "[", 
        RowBox[{"2", ",", "1"}], "]"}]}], "]"}], "]"}], 
    "[", "\"\<neighbor\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nrs", "=", 
   RowBox[{"List", "@@@", 
    RowBox[{"EdgeList", "[", 
     RowBox[{"TransitiveClosureGraph", "[", "nrs", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParallelMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "->", 
     RowBox[{"1", "-", 
      RowBox[{"cosineComplex", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"N", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"AdjacencyMatrix", "[", "#", "]"}], "]"}], "]"}], "]"}],
            "]"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"evos", "[", 
           RowBox[{"#", ",", "8"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ")"}]}]}]}], "&"}], ",", 
   "nrs"}], "]"}]}], "Input",
 CellChangeTimes->{{3.993617643376504*^9, 3.993617701780148*^9}, {
  3.9936179609261093`*^9, 3.993618109530154*^9}, {3.993621606233904*^9, 

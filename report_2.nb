Cell[BoxData[
 RowBox[{
  RowBox[{"cosineComplex", "[", 
   RowBox[{"v1_", ",", "v2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"Conjugate", "[", "v1", "]"}], ".", "v2"}], "]"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Norm", "[", "v1", "]"}], " ", 
     RowBox[{"Norm", "[", "v2", "]"}]}], ")"}]}]}]], "Input",

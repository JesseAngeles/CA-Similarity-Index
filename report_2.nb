Cell[BoxData[
 RowBox[{
  RowBox[{"evos", "[", 
   RowBox[{"rules_", ",", "space_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"conect", ",", "inits"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"inits", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"#", ",", 
            RowBox[{"rules", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "space"}], "]"}], 
          "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"rules", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}], "^", "space"}], "-", 
            "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"conect", "=", 
        RowBox[{"Map", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CaArray", "[", 
              RowBox[{
               RowBox[{"rules", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{
             RowBox[{"CaArray", "[", 
              RowBox[{
               RowBox[{"rules", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "#", ",", "1"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "&"}], ",", 
          "\[IndentingNewLine]", "inits"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rules", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", 
        RowBox[{"Graph", "[", "conect", "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 

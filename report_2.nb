Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParallelMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"#", "->", 
     RowBox[{"cosineComplex", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"AdjacencyMatrix", "[", "#", "]"}], "]"}], "]"}], "]"}], 
         "&"}], "/@", 
        RowBox[{
         RowBox[{"evos", "[", 
          RowBox[{"#", ",", "6"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], "&"}], ",", 
   "nrs"}], "]"}]], "Input",

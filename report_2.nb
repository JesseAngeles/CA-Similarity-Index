Cell[BoxData[
 RowBox[{
  RowBox[{"getRules", "[", 
   RowBox[{"s_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"ParallelMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"#", ",", "s", ",", "n"}], "]"}], "&"}], ",", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"s", "^", 
        RowBox[{"(", 
         RowBox[{"s", "^", "n"}], ")"}]}], "-", "1"}]}], "]"}]}], 
   "]"}]}]], "Input",

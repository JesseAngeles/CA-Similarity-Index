Cell[BoxData[{
 RowBox[{
  RowBox[{"nrel", "=", 
   RowBox[{
    RowBox[{"reduce", "[", 
     RowBox[{"addData", "[", 
      RowBox[{"getRules", "[", 
       RowBox[{"2", ",", "3"}], "]"}], "]"}], "]"}], "[", "\"\<neighbor\>\"", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dis", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "->", 
         RowBox[{"cosineComplex", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"AdjacencyMatrix", "[", "#", "]"}], "]"}], "]"}], 
              "]"}], "&"}], "/@", 
            RowBox[{
             RowBox[{"evos", "[", 
              RowBox[{"#", ",", "i"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], "&"}], ",",
        "nrel"}], "]"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "12"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"noneq", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"d", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "!=", "1."}], "&"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "dis"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rls", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"noneq", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", ";;", ",", "1"}], "]"}], "]"}], "]"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sequences", "=", 
   RowBox[{"Association", "@", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"pos", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"dis", ",", 
          RowBox[{"j", "[", 
           RowBox[{"[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"val", "=", 
        RowBox[{"Values", "[", 
         RowBox[{"Extract", "[", 
          RowBox[{"dis", ",", 
           RowBox[{
            RowBox[{"#", "&"}], "/@", 
            RowBox[{"pos", "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", 
               RowBox[{";;", 
                RowBox[{"-", "2"}]}]}], "]"}], "]"}]}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"j", "->", "val"}]}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "nrel"}], "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"GroupBy", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "sequences", "]"}], ",", 
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"sequences", "[", "#", "]"}], ",", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], "]"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Reverse", "/@", 
     RowBox[{"Normal", "[", "groups", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cous", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", 
      RowBox[{"Values", "[", "groups", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tp", "=", 

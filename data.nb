Cell[BoxData[
 RowBox[{
  RowBox[{"addData", "[", 
   RowBox[{"rulesIn_List", ",", 
    RowBox[{"dataIn_Association", ":", 
     RowBox[{"<|", "|>"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", "dataIn"}], ",", 
      RowBox[{"rules", "=", "rulesIn"}], ",", "\[IndentingNewLine]", 
      "inverseRules", ",", "mirrorRules", ",", "stateRules", ",", 
      "neighborRules"}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "inverseRules", ",", "mirrorRules", ",", "stateRules", ",", 
        "neighborRules"}], "}"}], "=", 
      RowBox[{"Parallelize", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"DeleteDuplicates", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"rule", "->", "#"}], "&"}], ",", 
               RowBox[{"InverseRules", "[", "rule", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DeleteDuplicates", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"rule", "->", "#"}], "&"}], ",", 
               RowBox[{"MirrorRules", "[", "rule", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"DeleteDuplicates", "@", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"rule", "->", "#"}], "&"}], ",", 
               RowBox[{"DeleteState", "[", "rule", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "->", 
               RowBox[{"DeleteNeighbor", "[", "#", "]"}]}], "&"}], ",", 
             "rules"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "=!=", "Null"}], "&"}]}], 
          "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<inverse\>\"", "->", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"dataIn", ",", "\"\<inverse\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], ",", "inverseRules"}], "]"}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<mirror\>\"", "->", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"dataIn", ",", "\"\<mirror\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], ",", "mirrorRules"}], "]"}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<state\>\"", "->", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"dataIn", ",", "\"\<state\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], ",", "stateRules"}], "]"}], "]"}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<neighbor\>\"", "->", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"dataIn", ",", "\"\<neighbor\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], ",", "neighborRules"}], "]"}], 
         "]"}]}]}], "\[IndentingNewLine]", "|>"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

           RowBox[{"r", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "2", ",", "3"}], "}"}], ",", 
         "10"}], "]"}], "]"}], ",", 
      RowBox[{"smVector", "[", 
       RowBox[{"SuccArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Lift3", "[", "r", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "3", ",", "3"}], "}"}], ",", 
         "10"}], "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", "ecaR"}], "}"}]}], "]"}], "]"}]}], "Input",ExpressionUU\

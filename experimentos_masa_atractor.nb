Cell[BoxData[
 RowBox[{
  RowBox[{"InverseRules", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"s", "=", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"n", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", "1"}], ")"}], "/", "2"}]}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{
        RowBox[{"ca", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "^", 
        RowBox[{"ca", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], ",", "outputs", ",", "tuples", ",",
       "perms", ",", "res"}], "\[IndentingNewLine]", "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"outputs", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{"r", ",", "s", ",", "L"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"outputs", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"salida", " ", "de", " ", "la", " ", "vecindad", " ", "k"}], "-",
         "1"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"tuples", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", "s", ",", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"L", "-", "1"}]}], "]"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"tuples", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vecindad", " ", "k"}], "-", 
        RowBox[{"1", " ", "como", " ", "n"}], "-", "tupla"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"perms", "=", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"s", "-", "1"}]}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"solo", " ", 
       RowBox[{"s", "!"}], " ", "permutaciones", " ", "de", " ", "ESTADOS"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Module", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pi", "=", 
               RowBox[{"AssociationThread", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"s", "-", "1"}]}], "]"}], "->", "perm"}], "]"}]}], 
              ",", 
              RowBox[{"newOut", "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", "L"}], "]"}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Do", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"newOut", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"FromDigits", "[", 
                    RowBox[{
                    RowBox[{"pi", "/@", 
                    RowBox[{"tuples", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", "s"}], "]"}], "+", 
                   "1"}], "]"}], "]"}], "=", 
                RowBox[{"pi", "[", 
                 RowBox[{"outputs", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}]}], 
               "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "1", ",", "L"}], "}"}]}], 
              "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"FromDigits", "[", 
              RowBox[{
               RowBox[{"Reverse", "[", "newOut", "]"}], ",", "s"}], "]"}]}]}],
            "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"perm", ",", "perms"}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"#", ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", "res"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->"7d6c2041-9ab1-\
4e0f-8e0e-d56c7c1eb29e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MirrorRules", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", "rule", ",", "assoc", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"ca", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", 
           RowBox[{"ca", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "-", "1"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rule", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{
        RowBox[{"ca", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"ca", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"Length", "[", "pos", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assoc", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"pos", ",", "rule"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Sort", "@", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"FromDigits", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Reverse", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
                "assoc"}], ",", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "&"}]}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{";;", ",", "2"}], "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"ca", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
          "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"#", ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "&"}], "/@", "res"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->"ae9945a0-edb2-\
4e31-9b7a-87b35f24ab98"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DeleteState", "[", "ca_Subscript", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vector", ",", "pos", ",", "rule", ",", "newpos"}], "}"}], ",", 
     
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "==", "1"}], ",", 
        RowBox[{
         RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vector", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ca", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", 
             RowBox[{"ca", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "-", "1"}], ",", "0", ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"vector", ",", 
          RowBox[{
           RowBox[{"ca", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rule", "=", 
       RowBox[{"IntegerDigits", "[", 
        RowBox[{
         RowBox[{"ca", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"ca", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "^", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"rule", "[", 
           RowBox[{"[", "pos", "]"}], "]"}], "==", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Length", "[", "pos", "]"}]}], "]"}]}], "&&", 
         RowBox[{"Not", "@", 
          RowBox[{"ContainsAny", "[", 
           RowBox[{"rule", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ca", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], "}"}]}], "]"}]}]}],
         ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Puede", " ", "eliminarse", " ", "ese", " ", "estado"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"newpos", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ca", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "^", 
               RowBox[{"ca", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", "1", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "pos"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Subscript", "[", 
          RowBox[{
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"rule", "[", 
              RowBox[{"[", "newpos", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"ca", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"ca", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", 
           RowBox[{"ca", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"No", " ", "puede", " ", "eliminarse"}], "*)"}], 
        "\[IndentingNewLine]", "Null"}], "]"}]}]}], "]"}]}], ";"}]], "Input",E\
xpressionUUID->"f17b40c0-1c1a-41cf-a953-1623b2af0a9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DeleteNeighbor", "[", "ca_Subscript", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "r", ",", "s", ",", "n", ",", "rv", ",", "tuples", ",", "ruleIdx", ",", 
      "indepQ", ",", "ip", ",", "relPos", ",", "nRed", ",", "redRV"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", 
     RowBox[{"s", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"ca", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "==", "1"}], ",", 
       RowBox[{
        RowBox[{"Return", "[", "]"}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rv", "=", 
      RowBox[{"IntegerDigits", "[", 
       RowBox[{"r", ",", "s", ",", 
        RowBox[{"s", "^", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tuples", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"IntegerDigits", "[", 
         RowBox[{"#", ",", "s", ",", "n"}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "^", "n"}], "-", "1"}], ",", "0", ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ruleIdx", "[", "inp_", "]"}], ":=", 
      RowBox[{
       RowBox[{"s", "^", "n"}], "-", 
       RowBox[{"FromDigits", "[", 
        RowBox[{"inp", ",", "s"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"indepQ", "[", "pos_", "]"}], ":=", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"tuples", ",", 
        RowBox[{"Function", "[", 
         RowBox[{"inp", ",", 
          RowBox[{"SameQ", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"rv", "[", 
              RowBox[{"[", 
               RowBox[{"ruleIdx", "[", 
                RowBox[{"ReplacePart", "[", 
                 RowBox[{"inp", ",", 
                  RowBox[{"pos", "->", "v"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"v", ",", "0", ",", 
               RowBox[{"s", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ip", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", "indepQ"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "ip", "]"}], "==", "0"}], ",", "Null", ",", 
       RowBox[{
        RowBox[{"relPos", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ip", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"solo", " ", "elimina", " ", "1", " ", "posici\[OAcute]n"}], 
         "*)"}], 
        RowBox[{"nRed", "=", 
         RowBox[{"n", "-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"redRV", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"rv", "[", 
            RowBox[{"[", 
             RowBox[{"ruleIdx", "[", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", "n"}], "]"}], ",", 
                RowBox[{"Thread", "[", 
                 RowBox[{"relPos", "->", "#"}], "]"}]}], "]"}], "]"}], "]"}], 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"#", ",", "s", ",", "nRed"}], "]"}], "&"}], "/@", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"s", "^", "nRed"}], "-", "1"}], ",", "0", ",", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Subscript", "[", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{"redRV", ",", "s"}], "]"}], ",", "s", ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}]}], "]"}]}]}], "]"}]}]], "Input",E\
xpressionUUID->"55fb903a-2c3a-40d5-a0bf-059deb0d46cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GroupRelations", "[", 
    RowBox[{"rels_Association", ",", 
     RowBox[{"types_", " ", ":", " ", "All"}], ",", 
     RowBox[{"extra_List", " ", ":", " ", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"keys", ",", "edges"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"keys", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"types", "===", "All"}], ",", 
         RowBox[{"Keys", "[", "rels", "]"}], ",", 
         RowBox[{"Intersection", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"{", "types", "}"}], "]"}], ",", 
           RowBox[{"Keys", "[", "rels", "]"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"edges", "=", 
       RowBox[{"UndirectedEdge", " ", "@@@", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Lookup", "[", 
          RowBox[{"rels", ",", "keys", ",", 
           RowBox[{"{", "}"}]}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"Sort", " ", "/@", " ", 
         RowBox[{"ConnectedComponents", "[", 
          RowBox[{"Graph", "[", 
           RowBox[{"extra", ",", "edges"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Length", "[", "#", "]"}]}], " ", "&"}], ",", "First"}], 
         "}"}]}], "]"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Se", " ", "aplica", " ", "DESPUES", " ", "de", " ", 
    RowBox[{"agrupar", ":", " ", 
     RowBox[{"conserva", " ", "solo", " ", "las", " ", "ECA", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "estados"}], ",", " ", 
        RowBox[{"3", " ", "vecinos"}]}], ")"}], " ", "y", " ", "descarta", " ",
       "los", " ", "grupos", " ", "vacios"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OnlyECA", "[", "groups_List", "]"}], ":=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Cases", "[", 
       RowBox[{"#", ",", 
        RowBox[{"Subscript", "[", 
         RowBox[{"_", ",", "2", ",", "3"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
      " ", "groups"}], ",", 
    RowBox[{"{", "}"}]}], "]"}]}]}], "Input",ExpressionUUID->"9525c43c-970f-\
4b73-aa55-7acfc390ab81"],

Cell["\<\
addDataS es la versi\[OAcute]n secuencial de addData. Lift3 extiende una \
regla de 2 estados a 3: el estado 2 nunca se produce y toda vecindad que lo \
contiene produce 0, as\[IAcute] que DeleteState la regresa a la regla \
original. \
\>", "Text",ExpressionUUID->"e3848f8b-9e34-4392-90be-cb37460682a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getRulesS", "[", 
    RowBox[{"s_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"i", ",", "s", ",", "m"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{
        RowBox[{"s", "^", 
         RowBox[{"(", 
          RowBox[{"s", "^", "m"}], ")"}]}], "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"addDataS", "[", "rules_List", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<inverse\>\"", "->", 
      RowBox[{"DeleteDuplicates", "@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rule", "->", "#"}], " ", "&"}], ",", 
            RowBox[{"InverseRules", "[", "rule", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<mirror\>\"", "->", 
      RowBox[{"DeleteDuplicates", "@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rule", "->", "#"}], " ", "&"}], ",", 
            RowBox[{"MirrorRules", "[", "rule", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"rule", ",", "rules"}], "}"}]}], "]"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<state\>\"", "->", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "->", 
            RowBox[{"DeleteState", "[", "#", "]"}]}], " ", "&"}], ",", 
          "rules"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "=!=", "Null"}], " ", "&"}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<neighbor\>\"", "->", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "->", 
            RowBox[{"DeleteNeighbor", "[", "#", "]"}]}], " ", "&"}], ",", 
          "rules"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "=!=", "Null"}], " ", "&"}]}], 
       "]"}]}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Lift3", "[", 
    RowBox[{"Subscript", "[", 
     RowBox[{"r_", ",", "2", ",", "m_"}], "]"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tab2", "=", 
        RowBox[{"Reverse", "[", 
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"r", ",", "2", ",", 
           RowBox[{"2", "^", "m"}]}], "]"}], "]"}]}], ",", "tab3"}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"tab3", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"d", "=", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{"v", ",", "3", ",", "m"}], "]"}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"d", ",", "2"}], "]"}], ",", "0", ",", 
             RowBox[{"tab2", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"FromDigits", "[", 
                 RowBox[{"d", ",", "2"}], "]"}], "+", "1"}], "]"}], "]"}]}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "0", ",", 
           RowBox[{
            RowBox[{"3", "^", "m"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Subscript", "[", 
       RowBox[{
        RowBox[{"FromDigits", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", "tab3", "]"}], ",", "3"}], "]"}], ",", "3", 
        ",", "m"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dom", "[", 
    RowBox[{"Subscript", "[", 
     RowBox[{"_", ",", "k_", ",", "m_"}], "]"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"k", ",", "m"}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"0d66c7a4-fe93-4dfc-bfce-dac693c6abd2"],

Cell["\<\
Relaciones entre todas las reglas de los dominios (2,1), (2,2), (2,3), (3,1) \
y (3,2), m\[AAcute]s la extensi\[OAcute]n a 3 estados de cada ECA (dominio \
(3,3)). Resultado: 81 clases en ECA y 84 clases con reglas de al menos dos \
dominios. \
\>", "Text",ExpressionUUID->"7899ae9f-41d0-4bd5-a650-de2ddc7f6d55"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"liftsECA", "=", 
   RowBox[{"Lift3", " ", "/@", " ", 
    RowBox[{"getRulesS", "[", 
     RowBox[{"2", ",", "3"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rulesX", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"3", ",", "1"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"3", ",", "2"}], "]"}], ",", "liftsECA"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"relX", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"addDataS", "[", "rulesX", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"classesX", "=", 
   RowBox[{"GroupRelations", "[", "relX", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crossX", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"classesX", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"dom", " ", "/@", " ", "#"}], "]"}], "]"}], ">=", "2"}], " ",
       "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", " ", "/@", " ", "relX"}], ",", 
   RowBox[{"Length", "[", 
    RowBox[{"OnlyECA", "[", "classesX", "]"}], "]"}], ",", 
   RowBox[{"Length", "[", "crossX", "]"}], ",", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"getRulesS", "[", 
         RowBox[{"2", ",", "3"}], "]"}], ",", "liftsECA"}], "}"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"DeleteState", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "===", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "}"}]}], "Input",ExpressionUUID->"cb8147af-da77-4c66-9bd7-f3e2d0764134"],

Cell[TextData[{
 "Vectores (completo y cociente) de las reglas evaluadas con n = 10, 11 y 12: \
todas las de los dominios chicos, las (3,2) que est\[AAcute]n en clases que \
cruzan dominios y las extensiones de las ECA. Se cargan de cross",
 StyleBox["domain",
  FontSlant->Italic],
 "am_data.wl o se calculan y se guardan. "
}], "Text",ExpressionUUID->"00bd4702-b729-4225-80d6-504ef833b59d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r32cross", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", "crossX", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"dom", "[", "#", "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], " ", "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evalRules", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "1"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "2"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"2", ",", "3"}], "]"}], ",", 
     RowBox[{"getRulesS", "[", 
      RowBox[{"3", ",", "1"}], "]"}], ",", "r32cross", ",", "liftsECA"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"amVec", ",", "amVecRot"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amVec", "[", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"r_", ",", "k_", ",", "m_"}], "]"}], ",", "n_Integer"}], "]"}], 
   ":=", 
   RowBox[{
    RowBox[{"amVec", "[", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"r", ",", "k", ",", "m"}], "]"}], ",", "n"}], "]"}], "=", 
    RowBox[{"AMVector", "[", 
     RowBox[{"SuccArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "k", ",", "m"}], "}"}], ",", "n"}], "]"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"amVecRot", "[", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"r_", ",", "k_", ",", "m_"}], "]"}], ",", "n_Integer"}], "]"}], 
   ":=", 
   RowBox[{
    RowBox[{"amVecRot", "[", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"r", ",", "k", ",", "m"}], "]"}], ",", "n"}], "]"}], "=", 
    RowBox[{"AMVector", "[", 
     RowBox[{"RotQuotient", "[", 
      RowBox[{
       RowBox[{"SuccArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", "k", ",", "m"}], "}"}], ",", "n"}], "]"}], ",", 
       "k", ",", "n"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataFileX", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"dir", ",", "\"\<cross_domain_am_data.wl\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", "dataFileX", "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"crossData", "=", 
      RowBox[{"Get", "[", "dataFileX", "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", "a"}], "}"}], ",", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"amVec", "[", 
               RowBox[{"#1", ",", "n"}], "]"}], "=", "#2"}], ")"}], " ", 
            "&"}], ",", "a"}], "]"}]}], "]"}], ",", 
       RowBox[{"crossData", "[", "\"\<Full\>\"", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", "a"}], "}"}], ",", 
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"amVecRot", "[", 
               RowBox[{"#1", ",", "n"}], "]"}], "=", "#2"}], ")"}], " ", 
            "&"}], ",", "a"}], "]"}]}], "]"}], ",", 
       RowBox[{"crossData", "[", "\"\<Rot\>\"", "]"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Scan", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"n", ",", 
         RowBox[{"Scan", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"amVec", "[", 
               RowBox[{"#", ",", "n"}], "]"}], ";", " ", 
              RowBox[{"amVecRot", "[", 
               RowBox[{"#", ",", "n"}], "]"}]}], ")"}], " ", "&"}], ",", 
           "evalRules"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"10", ",", "11", ",", "12"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Put", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Description\>\"", 
          "->", "\"\<Momentos espectrales con masa de atractor (K = 60) de \
reglas de varios dominios; completo y cociente por rotaciones; n = 10, 11, 12\
\>\""}], ",", "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<Relations\>\"", "->", "relX"}], ",", 
         RowBox[{"\"\<Rules\>\"", "->", "evalRules"}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<Full\>\"", "->", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"n", ",", 
              RowBox[{"AssociationMap", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"amVec", "[", 
                  RowBox[{"#", ",", "n"}], "]"}], " ", "&"}], ",", 
                "evalRules"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"10", ",", "11", ",", "12"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<Rot\>\"", "->", 
          RowBox[{"AssociationMap", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"n", ",", 
              RowBox[{"AssociationMap", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"amVecRot", "[", 
                  RowBox[{"#", ",", "n"}], "]"}], " ", "&"}], ",", 
                "evalRules"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"10", ",", "11", ",", "12"}], "}"}]}], "]"}]}]}], "|>"}],
        ",", "dataFileX"}], "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "evalRules", "]"}]}], "Input",ExpressionUUID->\
"5b106158-7a2b-4100-8566-b352a4e33cda"],

Cell["\<\
Distancia entre las dos reglas de cada relaci\[OAcute]n (arista del grafo de \
relaciones), en el mismo tama\[NTilde]o n. \
\>", "Text",ExpressionUUID->"ac1633f6-489e-40aa-b5f7-cdee1c70defd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evalSet", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"evalRules", "->", "True"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeDist", "[", 
    RowBox[{"type_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"es", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"relX", "[", "type", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"evalSet", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&&", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"evalSet", ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "=!=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], " ", "&"}]}], "]"}]}], "}"}],
      ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "type"}], ",", 
         RowBox[{"\"\<From\>\"", "->", 
          RowBox[{"e", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<To\>\"", "->", 
          RowBox[{"e", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<DomFrom\>\"", "->", 
          RowBox[{"dom", "[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<DomTo\>\"", "->", 
          RowBox[{"dom", "[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{"\"\<dFull\>\"", "->", 
          RowBox[{"cd", "[", 
           RowBox[{
            RowBox[{"amVec", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
            RowBox[{"amVec", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<dRot\>\"", "->", 
          RowBox[{"cd", "[", 
           RowBox[{
            RowBox[{"amVecRot", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
            RowBox[{"amVecRot", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}]}]}],
         "|>"}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "es"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summ", "[", "rows_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Pares\>\"", "->", 
      RowBox[{"Length", "[", "rows", "]"}]}], ",", 
     RowBox[{"\"\<d=0 completo\>\"", "->", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"rows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<dFull\>\""}], "]"}], "]"}], ",", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{"x", "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}]}]}], "]"}]}], ",", 
     RowBox[{"\"\<d=0 cociente\>\"", "->", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"rows", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<dRot\>\""}], "]"}], "]"}], ",", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{"x", "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}]}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"\"\<Mediana completo\>\"", "->", 
      RowBox[{"Median", "[", 
       RowBox[{"rows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<dFull\>\""}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Mediana cociente\>\"", "->", 
      RowBox[{"Median", "[", 
       RowBox[{"rows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "\"\<dRot\>\""}], "]"}], "]"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ed", "[", "n_", "]"}], ":=", 
   RowBox[{"Join", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"edgeDist", "[", 
        RowBox[{"#", ",", "n"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<inverse\>\"", ",", "\"\<mirror\>\"", ",", "\"\<state\>\"",
         ",", "\"\<neighbor\>\""}], "}"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ed12", "=", 
   RowBox[{"ed", "[", "12", "]"}]}], ";", " ", 
  RowBox[{"ed11", "=", 
   RowBox[{"ed", "[", "11", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"KeyValueMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Relaci\[OAcute]n\>\"", "->", 
        RowBox[{"#1", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<De\>\"", "->", 
        RowBox[{"#1", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"\"\<A\>\"", "->", 
        RowBox[{"#1", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"Normal", "[", 
         RowBox[{"summ", "[", "#2", "]"}], "]"}]}]}], "|>"}], " ", "&"}], ",", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"ed12", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#Type", ",", "#DomFrom", ",", "#DomTo"}], "}"}], " ", 
       "&"}]}], "]"}]}], "]"}], "]"}]}], "Input",ExpressionUUID->"df7fad05-\
fb95-47ef-b969-aee6bfeafd42"],

Cell["\<\
Filas agrupadas de la Tabla 3 del paper y la referencia: pares de ECA \
representantes de clases distintas. \
\>", "Text",ExpressionUUID->"0b920854-b53b-4b1e-a046-e6e067e65e1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"selT", "[", 
    RowBox[{"rows_", ",", "t_", ",", "doms_"}], "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{"rows", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#Type", "==", "t"}], "&&", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"doms", ",", "#DomFrom"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ecaR", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"#", ",", "2", ",", "3"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "ecaReps"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"clsOf", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{"#1", "->", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "&"}], ",", 
       RowBox[{"OnlyECA", "[", "classesX", "]"}]}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pairsUnrel", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"ecaR", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"clsOf", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "=!=", 
       RowBox[{"clsOf", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"baseU", "[", "n_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bf", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"cd", "[", 
           RowBox[{
            RowBox[{"amVec", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
            RowBox[{"amVec", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}], 
          " ", "&"}], " ", "/@", " ", "pairsUnrel"}]}], ",", 
       RowBox[{"br", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"cd", "[", 
           RowBox[{
            RowBox[{"amVecRot", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
            RowBox[{"amVecRot", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}], 
          " ", "&"}], " ", "/@", " ", "pairsUnrel"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Pares\>\"", "->", 
        RowBox[{"Length", "[", "pairsUnrel", "]"}]}], ",", 
       RowBox[{"\"\<d=0 completo\>\"", "->", 
        RowBox[{"Count", "[", 
         RowBox[{"bf", ",", 
          RowBox[{"x_", " ", "/;", " ", 
           RowBox[{"x", "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<d=0 cociente\>\"", "->", 
        RowBox[{"Count", "[", 
         RowBox[{"br", ",", 
          RowBox[{"x_", " ", "/;", " ", 
           RowBox[{"x", "<", 
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}]}]}]}], "]"}]}], ",", 
       RowBox[{"\"\<Mediana completo\>\"", "->", 
        RowBox[{"Median", "[", "bf", "]"}]}], ",", 
       RowBox[{"\"\<Mediana cociente\>\"", "->", 
        RowBox[{"Median", "[", "br", "]"}]}]}], "|>"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Permutaci\[OAcute]n (todos salvo (3,3))\>\"", "->", 
     RowBox[{"summ", "[", 
      RowBox[{"selT", "[", 
       RowBox[{"ed12", ",", "\"\<inverse\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<Espejo, m impar\>\"", "->", 
     RowBox[{"summ", "[", 
      RowBox[{"selT", "[", 
       RowBox[{"ed12", ",", "\"\<mirror\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "}"}]}], "]"}], "]"}]}], ",", 
    RowBox[{"\"\<Espejo, m = 2\>\"", "->", 
     RowBox[{"summ", "[", 
      RowBox[{"selT", "[", 
       RowBox[{"ed12", ",", "\"\<mirror\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], "]"}]}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<ECA de clases distintas\>\"", "->", 
     RowBox[{"baseU", "[", "12", "]"}]}]}], "|>"}], "]"}]}], "Input",Expressio\
nUUID->"8baf653f-5cc3-4316-9479-243267d507f4"],

Cell["\<\
Qu\[EAcute] tan bien se identifica la regla relacionada: lugar de la regla \
reducida entre todas las candidatas de su dominio (1 = la m\[AAcute]s \
cercana), correlaci\[OAcute]n de Spearman entre las distancias de las ECA y \
las de sus extensiones, y reducci\[OAcute]n de vecindad con n impar. \
\>", "Text",ExpressionUUID->"a3b1e628-80d6-41cd-a9bd-e306c0bcade2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rankOf", "[", 
    RowBox[{"a_", ",", "b_", ",", "cands_List", ",", "vf_", ",", "n_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"da", "=", 
        RowBox[{"vf", "[", 
         RowBox[{"a", ",", "n"}], "]"}]}], ",", "dists", ",", "db"}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"dists", "=", 
       RowBox[{"Union", "[", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"cd", "[", 
             RowBox[{"da", ",", 
              RowBox[{"vf", "[", 
               RowBox[{"#", ",", "n"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
            " ", "cands"}], ",", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "12"}]}]}], "]"}], "]"}]}], ";", " ", 
      RowBox[{"db", "=", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{"da", ",", 
           RowBox[{"vf", "[", 
            RowBox[{"b", ",", "n"}], "]"}]}], "]"}], ",", 
         RowBox[{"10.", "^", 
          RowBox[{"-", "12"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"1", "+", 
       RowBox[{"Count", "[", 
        RowBox[{"dists", ",", 
         RowBox[{"x_", " ", "/;", " ", 
          RowBox[{"x", "<", "db"}]}]}], "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nbPairs", "=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"relX", "[", "\"\<neighbor\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"dom", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], " ", "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"liftRank", "[", 
    RowBox[{"n_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rankOf", "[", 
      RowBox[{
       RowBox[{"Lift3", "[", "r", "]"}], ",", "r", ",", "ecaR", ",", "vf", ",",
        "n"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "ecaR"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nbRank", "[", 
    RowBox[{"n_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"rankOf", "[", 
      RowBox[{
       RowBox[{"e", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"e", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"getRulesS", "[", 
        RowBox[{"2", ",", "2"}], "]"}], ",", "vf", ",", "n"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", "nbPairs"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"liftCorr", "[", 
    RowBox[{"n_", ",", "vf_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{"ecaR", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"SpearmanRho", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{
           RowBox[{"vf", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
           RowBox[{"vf", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}], " ",
          "&"}], " ", "/@", " ", "p"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"cd", "[", 
          RowBox[{
           RowBox[{"vf", "[", 
            RowBox[{
             RowBox[{"Lift3", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "n"}], "]"}], ",", 
           
           RowBox[{"vf", "[", 
            RowBox[{
             RowBox[{"Lift3", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "n"}], "]"}]}], 
          "]"}], " ", "&"}], " ", "/@", " ", "p"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Reducci\[OAcute]n de vecindad: reducida m\[AAcute]s cercana \
{completo, cociente}\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"nbRank", "[", 
         RowBox[{"12", ",", "amVec"}], "]"}], ",", "1"}], "]"}], ",", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"nbRank", "[", 
         RowBox[{"12", ",", "amVecRot"}], "]"}], ",", "1"}], "]"}]}], "}"}]}],
    ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Excepciones en el cociente\>\"", "->", 
    RowBox[{"Pick", "[", 
     RowBox[{"nbPairs", ",", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"nbRank", "[", 
         RowBox[{"12", ",", "amVecRot"}], "]"}], ">", "1"}], "]"}]}], "]"}]}],
    ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Extensi\[OAcute]n: original m\[AAcute]s cercana\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"liftRank", "[", 
         RowBox[{"12", ",", "amVec"}], "]"}], ",", "1"}], "]"}], ",", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"liftRank", "[", 
         RowBox[{"12", ",", "amVecRot"}], "]"}], ",", "1"}], "]"}]}], "}"}]}],
    ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Extensi\[OAcute]n: original entre las 5 m\[AAcute]s \
cercanas\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"liftRank", "[", 
         RowBox[{"12", ",", "amVec"}], "]"}], ",", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{"x", "<=", "5"}]}]}], "]"}], ",", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"liftRank", "[", 
         RowBox[{"12", ",", "amVecRot"}], "]"}], ",", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{"x", "<=", "5"}]}]}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Spearman ECA vs extensiones\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"liftCorr", "[", 
       RowBox[{"12", ",", "amVec"}], "]"}], ",", 
      RowBox[{"liftCorr", "[", 
       RowBox[{"12", ",", "amVecRot"}], "]"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Reducciones de ECA con d = 0 en el cociente, n = 11\>\"", "->", 
    RowBox[{"Count", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"ed11", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#Type", "==", "\"\<neighbor\>\""}], "&&", 
           RowBox[{"#DomFrom", "==", 
            RowBox[{"{", 
             RowBox[{"2", ",", "3"}], "}"}]}]}], " ", "&"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<dRot\>\""}], "]"}], "]"}], ",", 
      RowBox[{"x_", " ", "/;", " ", 
       RowBox[{"x", "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}]}]}]}], "]"}]}]}], "|>"}]}], "Input",ExpressionU\
UID->"6d41cb4d-3b72-4000-99c1-f205f81abe59"],

Cell["\<\
Ejemplos del texto: la identidad 204 y sus reducciones, las reglas aditivas \
90 y 60, y la extensi\[OAcute]n de la regla 30. \
\>", "Text",ExpressionUUID->"d882f95c-5cec-49b8-8fad-b738de589d9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rl", "[", 
    RowBox[{"r_", ",", "k_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Subscript", "[", 
    RowBox[{"r", ",", "k", ",", "m"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Regla\>\"", "->", 
         RowBox[{"p", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<Relacionada\>\"", "->", 
         RowBox[{"p", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<Completo\>\"", "->", 
         RowBox[{"cd", "[", 
          RowBox[{
           RowBox[{"amVec", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
           RowBox[{"amVec", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"\"\<Cociente\>\"", "->", 
         RowBox[{"cd", "[", 
          RowBox[{
           RowBox[{"amVecRot", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "n"}], "]"}], ",", 
           RowBox[{"amVecRot", "[", 
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "n"}], "]"}]}], "]"}]}]}], 
       "|>"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"{", 
         RowBox[{"11", ",", "12"}], "}"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rl", "[", 
             RowBox[{"204", ",", "2", ",", "3"}], "]"}], ",", 
            RowBox[{"rl", "[", 
             RowBox[{"12", ",", "2", ",", "2"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rl", "[", 
             RowBox[{"204", ",", "2", ",", "3"}], "]"}], ",", 
            RowBox[{"rl", "[", 
             RowBox[{"2", ",", "2", ",", "1"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rl", "[", 
             RowBox[{"90", ",", "2", ",", "3"}], "]"}], ",", 
            RowBox[{"rl", "[", 
             RowBox[{"6", ",", "2", ",", "2"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rl", "[", 
             RowBox[{"60", ",", "2", ",", "3"}], "]"}], ",", 
            RowBox[{"rl", "[", 
             RowBox[{"6", ",", "2", ",", "2"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rl", "[", 
             RowBox[{"30", ",", "2", ",", "3"}], "]"}], ",", 
            RowBox[{"Lift3", "[", 
             RowBox[{"rl", "[", 
              RowBox[{"30", ",", "2", ",", "3"}], "]"}], "]"}]}], "}"}]}], 
         "}"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], "]"}]}], "Input",Expressi\
onUUID->"f001a8ff-47df-4b54-a4a8-75d1f2b110d0"],

Cell["\<\
Los momentos espectrales simples (solo los nodos de los ciclos, j0 = 1) s\
\[IAcute] son invariantes ante la extensi\[OAcute]n: los ciclos son los \
mismos y solo cambia la escala. \
\>", "Text",ExpressionUUID->"557cde01-20c7-422c-a4e1-02f913555d18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"smVector", "[", 
    RowBox[{"succ_NumericArray", ",", 
     RowBox[{"K_Integer", " ", ":", " ", "60"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"attractorMassC", "[", 
          RowBox[{"succ", ",", "K"}], "]"}], ",", "K"}], "]"}]}], "}"}], ",", 
     
     RowBox[{

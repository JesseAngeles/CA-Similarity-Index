Notebook[{
Cell["Experimentos con la masa de atractor", "Title",ExpressionUUID->"05d9b41e-41e9-42a9-9472-e42cf29a532b"],

Cell["\<\
Experimentos de la Secci\[OAcute]n 6 del paper \
(Paper/sections/experiments.tex). Solo se eval\[UAcute]a el \[UAcute]ltimo m\
\[EAcute]todo, los momentos espectrales con masa de atractor, con K = 60 y la \
distancia coseno, en el grafo completo y en el cociente por rotaciones.\
\>", "Text",ExpressionUUID->"606cb0d6-ab72-4d71-ae41-d311e23a52f0"],

Cell["\<\
1. Relaciones de herencia entre dominios: distancia entre reglas unidas por \
una relaci\[OAcute]n.\
\>", "Text",ExpressionUUID->"461aa684-5320-431f-b0e0-25ed22cc8fcd"],

Cell["2. Una regla en espacios de distinto tama\[NTilde]o.", "Text",ExpressionUUID->"bda64656-bb9e-4706-a278-616cdaae8b34"],

Cell["3. Distancia entre las reglas 0 y 8.", "Text",ExpressionUUID->"dda692e6-4be5-4a9d-8ed9-a1b0167fff9a"],

Cell["\<\
4. Agrupamiento de las 88 ECA representantes y proyecci\[OAcute]n a 2D.\
\>", "Text",ExpressionUUID->"d75eb32d-f874-42de-ab02-247e706bdccd"],

Cell[TextData[{
 "Requiere los datos de GPU de eigenvalues",
 StyleBox["method.nb (attractor",
  FontSlant->Italic],
 "mass",
 StyleBox["gpu",
  FontSlant->Italic],
 "data.wl y attractor",
 StyleBox["mass",
  FontSlant->Italic],
 "rot",
 StyleBox["gpu",
  FontSlant->Italic],
 "data.wl). Los vectores de las reglas de otros dominios se guardan en \
cross",
 StyleBox["domain",
  FontSlant->Italic],
 "am_data.wl; si el archivo no existe, se calculan en CPU (unos 15 min para n \
= 10, 11 y 12). "
}], "Text",ExpressionUUID->"011b763a-f087-48cd-b757-e3429ccd639e"],

Cell["Datos y funciones", "Section",ExpressionUUID->"a2f33a3d-48e0-4b62-9cc4-bf4e16df474e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dir", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amData", "=", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dir", ",", "\"\<attractor_mass_gpu_data.wl\>\""}], "}"}], 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amRotData", "=", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dir", ",", "\"\<attractor_mass_rot_gpu_data.wl\>\""}], "}"}], 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ecaReps", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"amData", "[", "12", "]"}], "[", "\"\<Rules\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "\"\<Rule\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "ecaReps", "]"}]}], "Input",ExpressionUUID->"54e8f06c-\
1cb3-43dd-a65f-7b3ff4df64ea"],

Cell["\<\
Mismas funciones que en eigenvalues_method.nb (secci\[OAcute]n de masa de \
atractor): attractorMassC recorre el arreglo de sucesores en O(N) y devuelve \
la tabla c[p, j0]; AttractorMassMoments arma el vector. \
\>", "Text",ExpressionUUID->"0e1ae508-54b0-4412-9e34-c29a257199ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Altura", " ", "h", " ", "y", " ", "periodo", " ", "p", " ", "de", " ", 
       "cada", " ", "nodo", " ", "en", " ", "un", " ", "solo", " ", 
       "recorrido", " ", "O", 
       RowBox[{"(", "N", ")"}]}], ":", " ", 
      RowBox[{
      "se", " ", "sigue", " ", "cada", " ", "camino", " ", "hasta", " ", "un",
        " ", "nodo", " ", "conocido", " ", "o", " ", "hasta", " ", "cerrar", " ",
        "un", " ", "ciclo", " ", "y", " ", "se", " ", "asignan", " ", "las", " ",
        "alturas", " ", "hacia", " ", 
       RowBox[{"atr\[AAcute]s", ".", " ", "Cada"}], " ", "nodo", " ", 
       "cuenta", " ", "desde", " ", "k"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"p", " ", "j0", " ", "con", " ", "j0"}], " ", "=", " ", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"h", "/", "p"}], "]"}]}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"se", " ", "devuelve", " ", "la", " ", "tabla", " ", 
      RowBox[{"c", "[", 
       RowBox[{"p", ",", " ", "j0"}], "]"}], " ", 
      RowBox[{"(", "aplanada", ")"}], " ", "para", " ", "p", " ", "j0"}], " ",
      "<=", " ", "kmax"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"attractorMassC", "=", 
     RowBox[{"FunctionCompile", "[", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Typed", "[", 
           RowBox[{"succ", ",", 
            RowBox[{
             RowBox[{"TypeSpecifier", "[", "\"\<NumericArray\>\"", "]"}], "[", 
             RowBox[{"\"\<Integer32\>\"", ",", "1"}], "]"}]}], "]"}], ",", 
          RowBox[{"Typed", "[", 
           RowBox[{"kmax", ",", "\"\<MachineInteger\>\""}], "]"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "=", 
             RowBox[{"Length", "[", "succ", "]"}]}], ",", "hgt", ",", "per", ",",
             "stack", ",", 
            RowBox[{"top", "=", "0"}], ",", "w", ",", "v", ",", "u", ",", "h",
             ",", "p", ",", "j0", ",", "cnt", ",", "cstart", ",", "len"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"hgt", "=", 
            RowBox[{"CreateTypeInstance", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
               "[", "\"\<Integer32\>\"", "]"}], ",", "n"}], "]"}]}], ";", 
           RowBox[{"per", "=", 
            RowBox[{"CreateTypeInstance", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
               "[", "\"\<Integer32\>\"", "]"}], ",", "n"}], "]"}]}], ";", 
           RowBox[{"stack", "=", 
            RowBox[{"CreateTypeInstance", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"TypeSpecifier", "[", "\"\<CArray\>\"", "]"}], 
               "[", "\"\<Integer32\>\"", "]"}], ",", "n"}], "]"}]}], ";", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"ToRawPointer", "[", 
              RowBox[{"hgt", ",", "i0", ",", 
               RowBox[{"Cast", "[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "\"\<Integer32\>\"", 
                 ",", "\"\<CCast\>\""}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i0", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
           RowBox[{"cnt", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", 
              RowBox[{"kmax", "*", "kmax"}]}], "]"}]}], ";", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"FromRawPointer", "[", 
                 RowBox[{"hgt", ",", "s"}], "]"}], "==", 
                RowBox[{"Cast", "[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "\"\<Integer32\>\"", 
                  ",", "\"\<CCast\>\""}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"top", "=", "0"}], ";", 
                RowBox[{"w", "=", "s"}], ";", 
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FromRawPointer", "[", 
                    RowBox[{"hgt", ",", "w"}], "]"}], "==", 
                   RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "\"\<Integer32\>\"", 
                    ",", "\"\<CCast\>\""}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"ToRawPointer", "[", 
                    RowBox[{"hgt", ",", "w", ",", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", "\"\<Integer32\>\"", 
                    ",", "\"\<CCast\>\""}], "]"}]}], "]"}], ";", 
                   RowBox[{"ToRawPointer", "[", 
                    RowBox[{"per", ",", "w", ",", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    "top", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], "]"}], ";", 
                   RowBox[{"ToRawPointer", "[", 
                    RowBox[{"stack", ",", "top", ",", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    "w", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], "]"}], ";", 
                   RowBox[{"top", "++"}], ";", 
                   RowBox[{"w", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"succ", "[", 
                    RowBox[{"[", 
                    RowBox[{"w", "+", "1"}], "]"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}]}]}], "]"}], ";", 
                RowBox[{"len", "=", "top"}], ";", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"FromRawPointer", "[", 
                    RowBox[{"hgt", ",", "w"}], "]"}], "==", 
                   RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", "\"\<Integer32\>\"", 
                    ",", "\"\<CCast\>\""}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"cstart", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"per", ",", "w"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"u", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"stack", ",", "i"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                    RowBox[{"ToRawPointer", "[", 
                    RowBox[{"hgt", ",", "u", ",", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    "0", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], "]"}], ";", 
                    RowBox[{"ToRawPointer", "[", 
                    RowBox[{"per", ",", "u", ",", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"top", "-", "cstart"}], ",", "\"\<Integer32\>\"", 
                    ",", "\"\<CCast\>\""}], "]"}]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "cstart", ",", 
                    RowBox[{"top", "-", "1"}]}], "}"}]}], "]"}], ";", 
                   RowBox[{"top", "=", "cstart"}]}]}], "]"}], ";", 
                RowBox[{"Do", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"v", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"stack", ",", "i"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"u", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"succ", "[", 
                    RowBox[{"[", 
                    RowBox[{"v", "+", "1"}], "]"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"ToRawPointer", "[", 
                    RowBox[{"hgt", ",", "v", ",", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"hgt", ",", "u"}], "]"}], "+", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    "1", ",", "\"\<Integer32\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}]}], "]"}], ";", 
                   RowBox[{"ToRawPointer", "[", 
                    RowBox[{"per", ",", "v", ",", 
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"per", ",", "u"}], "]"}]}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", 
                    RowBox[{"top", "-", "1"}], ",", "0", ",", 
                    RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", 
                RowBox[{"Do", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"v", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"stack", ",", "i"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"h", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"hgt", ",", "v"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"p", "=", 
                    RowBox[{"Cast", "[", 
                    RowBox[{
                    RowBox[{"FromRawPointer", "[", 
                    RowBox[{"per", ",", "v"}], "]"}], 
                    ",", "\"\<MachineInteger\>\"", ",", "\"\<CCast\>\""}], 
                    "]"}]}], ";", 
                   RowBox[{"j0", "=", 
                    RowBox[{"1", "+", 
                    RowBox[{"Quotient", "[", 
                    RowBox[{
                    RowBox[{"h", "+", "p", "-", "1"}], ",", "p"}], "]"}]}]}], 
                   ";", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"p", "*", "j0"}], "<=", "kmax"}], ",", 
                    RowBox[{
                    RowBox[{"cnt", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"p", "-", "1"}], ")"}], "*", "kmax"}], "+", 
                    "j0"}], "]"}], "]"}], "++"}]}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", 
                    RowBox[{"len", "-", "1"}]}], "}"}]}], "]"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "0", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
           RowBox[{"DeleteObject", "[", "hgt", "]"}], ";", 
           RowBox[{"DeleteObject", "[", "per", "]"}], ";", 
           RowBox[{"DeleteObject", "[", "stack", "]"}], ";", "cnt"}]}], 
         "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Vector", " ", "de", " ", "momentos", " ", "con", " ", "masa", " ", "de",
       " ", 
      RowBox[{"atractor", ":", " ", 
       RowBox[{"m", "~", "_k"}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"suma", " ", "de", " ", 
         RowBox[{"c", "[", 
          RowBox[{"p", ",", " ", "j0"}], "]"}], " ", "con", " ", "p"}], " ", "|",
         " ", 
        RowBox[{
         RowBox[{"k", " ", "y", " ", "p", " ", "j0"}], " ", "<=", " ", 
         "k"}]}], ")"}], "/", "N"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AttractorMassMoments", "[", 
      RowBox[{"c_List", ",", "nodes_Integer", ",", "K_Integer"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Divisible", "[", 
             RowBox[{"k", ",", "p"}], "]"}], ",", 
            RowBox[{"Total", "[", 
             RowBox[{"c", "[", 
              RowBox[{"[", 
               RowBox[{"p", ",", 
                RowBox[{"1", ";;", 
                 RowBox[{"k", "/", "p"}]}]}], "]"}], "]"}], "]"}], ",", "0"}],
            "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"p", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "K"}], "}"}]}], "]"}], "/", "nodes"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"e337fc06-b649-4d93-ab3c-\
94b9bd81d3e6"],

Cell["\<\
Versi\[OAcute]n en CPU para cualquier dominio: la regla Subscript[r, k, m] \
tiene k estados y m vecinos, con la convenci\[OAcute]n de CellularAutomaton \
(con m = 2 la vecindad es (i-1, i)). El cociente por rotaciones cuenta cada \
clase como un nodo, igual que en eigenvalues_method.nb. \
\>", "Text",ExpressionUUID->"4e0d0011-6b19-4354-b289-28e079dfbddb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Sucesores", " ", "0"}], "-", 
    RowBox[{
    "indexados", " ", "de", " ", "todas", " ", "las", " ", "configuraciones", 
     " ", "de", " ", "n", " ", "c\[EAcute]lulas"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SuccArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r_Integer", ",", "k_Integer", ",", "m_Integer"}], "}"}], ",",
        "n_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"k", "^", "n"}]}], ",", "cols", ",", "offs", ",", "tab", ",",
          "newIdx"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"cols", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"nn", "-", "1"}]}], "]"}], ",", "k", ",", "n"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"offs", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"m", "==", "2"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
           RowBox[{"OddQ", "[", "m", "]"}], ",", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"m", "-", "1"}], ")"}]}], "/", "2"}], ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"m", "-", "1"}], ")"}], "/", "2"}]}], "]"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"tab", "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"r", ",", "k", ",", 
            RowBox[{"k", "^", "m"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"newIdx", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"k", "^", 
             RowBox[{"(", 
              RowBox[{"n", "-", "i"}], ")"}]}], " ", 
            RowBox[{"tab", "[", 
             RowBox[{"[", 
              RowBox[{"1", "+", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"k", "^", 
                   RowBox[{"(", 
                    RowBox[{"m", "-", "j"}], ")"}]}], " ", 
                  RowBox[{"cols", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"i", "-", "1", "+", 
                    RowBox[{"offs", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ",", "n"}], "]"}], "+", 
                    "1"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "m"}], "}"}]}], "]"}]}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"NumericArray", "[", 
         RowBox[{"newIdx", ",", "\"\<Integer32\>\""}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Cociente", " ", "por", " ", 
      RowBox[{"rotaciones", ":", " ", 
       RowBox[{"cada", " ", "clase", " ", "es", " ", "un", " ", "nodo"}]}]}], 
     ",", " ", 
     RowBox[{
     "representada", " ", "por", " ", "su", " ", "rotaci\[OAcute]n", " ", 
      "de", " ", "valor", " ", "m\[IAcute]nimo"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RotQuotient", "[", 
      RowBox[{"succ_NumericArray", ",", "k_Integer", ",", "n_Integer"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"k", "^", "n"}]}], ",", "idx", ",", "rep", ",", "reps", ",",
          "cid", ",", "sc"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"idx", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{"nn", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"rep", "=", "idx"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"rep", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{"Min", ",", 
             RowBox[{"{", 
              RowBox[{"rep", ",", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"idx", " ", 
                   RowBox[{"k", "^", "sh"}]}], ",", "nn"}], "]"}], "+", 
                RowBox[{"Quotient", "[", 
                 RowBox[{"idx", ",", 
                  RowBox[{"k", "^", 
                   RowBox[{"(", 
                    RowBox[{"n", "-", "sh"}], ")"}]}]}], "]"}]}]}], "}"}]}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"sh", ",", "1", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"reps", "=", 
         RowBox[{"Union", "[", "rep", "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"cid", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", "nn"}], "]"}]}], ";", " ", 
        RowBox[{
         RowBox[{"cid", "[", 
          RowBox[{"[", 
           RowBox[{"reps", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Length", "[", "reps", "]"}], "-", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"sc", "=", 
         RowBox[{"Normal", "[", "succ", "]"}]}], ";", "\[IndentingNewLine]", 
        "  ", 
        RowBox[{"NumericArray", "[", 
         RowBox[{
          RowBox[{"cid", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"rep", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"sc", "[", 
                 RowBox[{"[", 
                  RowBox[{"reps", "+", "1"}], "]"}], "]"}], "+", "1"}], "]"}],
               "]"}], "+", "1"}], "]"}], "]"}], ",", "\"\<Integer32\>\""}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Vector", " ", "de", " ", "masa", " ", "de", " ", "atractor", " ", "de", " ",
      "un", " ", "arreglo", " ", "de", " ", "sucesores"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AMVector", "[", 
      RowBox[{"succ_NumericArray", ",", 
       RowBox[{"K_Integer", " ", ":", " ", "60"}]}], "]"}], ":=", 
     RowBox[{"AttractorMassMoments", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"attractorMassC", "[", 
          RowBox[{"succ", ",", "K"}], "]"}], ",", "K"}], "]"}], ",", 
       RowBox[{"Length", "[", "succ", "]"}], ",", "K"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Distancia", " ", "coseno", " ", "y", " ", "matriz", " ", "de", " ", 
     "distancias", " ", "coseno", " ", "entre", " ", "dos", " ", "listas", " ",
      "de", " ", "vectores"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cd", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{"CosineDistance", "[", 
       RowBox[{"u", ",", "v"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"cosMat", "[", 
      RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Normalize", " ", "/@", " ", "A"}], ")"}], " ", ".", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Normalize", " ", "/@", " ", "B"}], "]"}]}]}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"9d28fac8-55aa-4c12-a011-\
9286d3e85fb7"],


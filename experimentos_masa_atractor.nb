         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Divisible", "[", 
             RowBox[{"k", ",", "p"}], "]"}], ",", 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"p", ",", "1"}], "]"}], "]"}], ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"p", ",", "1", ",", "k"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "K"}], "}"}]}], "]"}], "/", 
      RowBox[{"Length", "[", "succ", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "[", 

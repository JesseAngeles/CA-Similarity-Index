 RowBox[{
  RowBox[{"near", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{
     RowBox[{"Range", "[", "88", "]"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 

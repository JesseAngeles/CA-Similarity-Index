Cell["Distancia entre las reglas 0 y 8", "Section",ExpressionUUID->"891bd96b-c194-4f18-8867-ebb1c0697b31"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"i0", "=", 
   RowBox[{"First", "[", 
    RowBox[{"FirstPosition", "[", 
     RowBox[{"ecaReps", ",", "0"}], "]"}], "]"}]}], ";", " ", 
  RowBox[{"i8", "=", 
   RowBox[{"First", "[", 
    RowBox[{"FirstPosition", "[", 
     RowBox[{"ecaReps", ",", "8"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"d08", "[", 
    RowBox[{"v_", ",", "n_", ",", "K_"}], "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"CosineDistance", "[", 
     RowBox[{
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "[", "n", "]"}], "[", 
         RowBox[{"[", "i0", "]"}], "]"}], ",", "K"}], "]"}], ",", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"v", "[", "n", "]"}], "[", 
         RowBox[{"[", "i8", "]"}], "]"}], ",", "K"}], "]"}]}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rankOf8", "[", 
    RowBox[{"v_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"M", "=", 
       RowBox[{
        RowBox[{"cosMat", "[", 
         RowBox[{
          RowBox[{"v", "[", "n", "]"}], ",", 
          RowBox[{"v", "[", "n", "]"}]}], "]"}], "[", 
        RowBox[{"[", "i0", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"1", "+", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"Delete", "[", 
         RowBox[{"M", ",", "i0"}], "]"}], ",", 
        RowBox[{"x_", " ", "/;", " ", 
         RowBox[{"x", "<", 
          RowBox[{
           RowBox[{"M", "[", 
            RowBox[{"[", "i8", "]"}], "]"}], "-", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}]}]}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", "n"}], ",", 
      RowBox[{"\"\<Completo K = 60\>\"", "->", 
       RowBox[{"d08", "[", 
        RowBox[{"vF", ",", "n", ",", "60"}], "]"}]}], ",", 
      RowBox[{"\"\<Cociente K = 60\>\"", "->", 
       RowBox[{"d08", "[", 
        RowBox[{"vR", ",", "n", ",", "60"}], "]"}]}], ",", 
      RowBox[{"\"\<Completo K = 10\>\"", "->", 
       RowBox[{"d08", "[", 
        RowBox[{"vF", ",", "n", ",", "10"}], "]"}]}], ",", 
      RowBox[{"\"\<Lugar de la 8 (completo)\>\"", "->", 

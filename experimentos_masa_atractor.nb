Cell["Agrupamiento de las ECA", "Section",ExpressionUUID->"d621a552-3f54-4f23-a81d-5a999d7a49ae"],

Cell["\<\
Vectores de las 88 ECA con n = 12 y K = 60, normalizados (la distancia \
euclidiana entre vectores normalizados es mon\[OAcute]tona en la distancia \
coseno). Se comparan k-medoides y agrupamiento jer\[AAcute]rquico con 4 y 5 \
grupos por la silueta. \
\>", "Text",ExpressionUUID->"0d889733-66bb-47cb-a418-9bd825762f6c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lab", "=", "ecaReps"}], ";", " ", 
  RowBox[{"posR", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"lab", ",", 
     RowBox[{"Range", "[", "88", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X12", "=", 
   RowBox[{"Normalize", " ", "/@", " ", 
    RowBox[{"vF", "[", "12", "]"}]}]}], ";", " ", 
  RowBox[{"D12", "=", 
   RowBox[{"cosMat", "[", 
    RowBox[{
     RowBox[{"vF", "[", "12", "]"}], ",", 
     RowBox[{"vF", "[", "12", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clusterSets", "[", 
    RowBox[{"method_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"FindClusters", "[", 
      RowBox[{
       RowBox[{"X12", "->", "lab"}], ",", "k", ",", 
       RowBox[{"DistanceFunction", "->", "CosineDistance"}], ",", 
       RowBox[{"Method", "->", "method"}], ",", 
       RowBox[{"RandomSeeding", "->", "1234"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Length", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"silh", "[", "cl_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"idx", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"cl", "[", 
              RowBox[{"[", "c", "]"}], "]"}], "->", "c"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", 
             RowBox[{"Length", "[", "cl", "]"}]}], "}"}]}], "]"}], "]"}], 
        "]"}]}], "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Mean", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ci", "=", 
             RowBox[{"idx", "[", "r", "]"}]}], ",", "own", ",", "a", ",", 
            "b"}], "}"}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"own", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"cl", "[", 
               RowBox[{"[", "ci", "]"}], "]"}], ",", "r"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"a", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"own", "===", 
               RowBox[{"{", "}"}]}], ",", "0", ",", 
              RowBox[{"Mean", "[", 
               RowBox[{"D12", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"posR", "[", "r", "]"}], ",", 
                  RowBox[{"posR", " ", "/@", " ", "own"}]}], "]"}], "]"}], 
               "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "      ", 
           RowBox[{"b", "=", 
            RowBox[{"Min", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Mean", "[", 
                RowBox[{"D12", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"posR", "[", "r", "]"}], ",", 
                   RowBox[{"posR", " ", "/@", " ", 
                    RowBox[{"cl", "[", 
                    RowBox[{"[", "c", "]"}], "]"}]}]}], "]"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"c", ",", 
                 RowBox[{"Complement", "[", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "cl", "]"}], "]"}], ",", 
                   RowBox[{"{", "ci", "}"}]}], "]"}]}], "}"}]}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"own", "===", 
              RowBox[{"{", "}"}]}], ",", "0", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"b", "-", "a"}], ")"}], "/", 
              RowBox[{"Max", "[", 
               RowBox[{"a", ",", "b"}], "]"}]}]}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "lab"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meths", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<KMedoids\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Agglomerate\>\"", ",", 
       RowBox[{"\"\<Linkage\>\"", "->", "\"\<Average\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Agglomerate\>\"", ",", 
       RowBox[{"\"\<Linkage\>\"", "->", "\"\<Complete\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Agglomerate\>\"", ",", 
       RowBox[{"\"\<Linkage\>\"", "->", "\"\<Ward\>\""}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<M\[EAcute]todo\>\"", "->", "m"}], ",", 
        RowBox[{"\"\<k\>\"", "->", "k"}], ",", 
        RowBox[{"\"\<Tama\[NTilde]os\>\"", "->", 
         RowBox[{"Length", " ", "/@", " ", 
          RowBox[{"clusterSets", "[", 
           RowBox[{"m", ",", "k"}], "]"}]}]}], ",", 
        RowBox[{"\"\<Silueta\>\"", "->", 
         RowBox[{"silh", "[", 
          RowBox[{"clusterSets", "[", 
           RowBox[{"m", ",", "k"}], "]"}], "]"}]}]}], "|>"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "meths"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5"}], "}"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
  "]"}]}], "Input",ExpressionUUID->"f60ceb14-fb7e-4c5a-9f8d-6d215b05d339"],

Cell["\<\
Grupos de k-medoides con k = 4 y periodo dominante de cada regla (el periodo \
que re\[UAcute]ne m\[AAcute]s configuraciones dentro de la ventana). \
\>", "Text",ExpressionUUID->"4bc9dd82-9123-4144-b456-a03d55a739a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"clK4", "=", 
   RowBox[{"clusterSets", "[", 
    RowBox[{"\"\<KMedoids\>\"", ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"perStats", "[", 
    RowBox[{"r_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"attractorMassC", "[", 
           RowBox[{
            RowBox[{"SuccArray", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"r", ",", "2", ",", "3"}], "}"}], ",", "n"}], "]"}], ",",
             "60"}], "]"}], ",", "60"}], "]"}]}], ",", "byP"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"byP", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"c", "[", 
           RowBox[{"[", "p", "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "60"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<domP\>\"", "->", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"byP", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<domFrac\>\"", "->", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Max", "[", "byP", "]"}], "/", 
           RowBox[{"2", "^", "n"}]}], "]"}]}], ",", 
        RowBox[{"\"\<visible\>\"", "->", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Total", "[", "byP", "]"}], "/", 
           RowBox[{"2", "^", "n"}]}], "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ps", "=", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"perStats", "[", 
       RowBox[{"#", ",", "12"}], "]"}], " ", "&"}], ",", "lab"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Tama\[NTilde]o\>\"", "->", 
       RowBox[{"Length", "[", "c", "]"}]}], ",", 
      RowBox[{"\"\<Periodo dominante\>\"", "->", 
       RowBox[{"Counts", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ps", "[", "#", "]"}], "[", "\"\<domP\>\"", "]"}], " ", 
          "&"}], " ", "/@", " ", "c"}], "]"}]}], ",", 
      RowBox[{"\"\<Reglas\>\"", "->", "c"}]}], "|>"}], ",", 
    RowBox[{"{", 
     RowBox[{"c", ",", "clK4"}], "}"}]}], "]"}], "]"}]}], "Input",ExpressionUU\
ID->"2d3ba5ea-088f-44bf-b7f4-29bcf0d09edb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Regla", " ", "30", " ", "con", " ", "n"}], " ", "=", " ", 
    RowBox[{"12", ":", " ", 
     RowBox[{
     "periodo", " ", "de", " ", "cada", " ", "configuraci\[OAcute]n", " ", 
      RowBox[{"(", 
       RowBox[{
       "93.5", "%", " ", "llega", " ", "a", " ", "un", " ", "ciclo", " ", 
        "de", " ", "periodo", " ", "102"}], ")"}], " ", "y", " ", "reglas", " ",
       "22", " ", "y", " ", "106"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sc", "=", 
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"SuccArray", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"30", ",", "2", ",", "3"}], "}"}], ",", "12"}], "]"}], 
           "]"}], "+", "1"}]}], ",", "final"}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"final", "=", 
        RowBox[{"Nest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sc", "[", 
            RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", 
          RowBox[{"Range", "[", "4096", "]"}], ",", "4096"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"Counts", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"NestWhileList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sc", "[", 
                RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], ",", "x", ",", 
              RowBox[{
               RowBox[{"#", "!=", "x"}], " ", "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}], "-", "1"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "final"}], "}"}]}], "]"}], "]"}]}]}], "]"}], ",", 
    RowBox[{"ps", "[", "22", "]"}], ",", 
    RowBox[{"ps", "[", "106", "]"}]}], "}"}]}]], "Input",ExpressionUUID->\
"5095d3c1-fbff-4b3d-b03f-49c03caf4454"],

Cell["\<\
Estabilidad de la partici\[OAcute]n: \[IAcute]ndice de Rand ajustado entre la \
partici\[OAcute]n con n = 12 y la de cada tama\[NTilde]o de 10 a 24. \
\>", "Text",ExpressionUUID->"2dcc60f3-3c31-411f-8ff6-8f22e4547972"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"assign", "[", "cl_", "]"}], ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"cl", "[", 
          RowBox[{"[", "c", "]"}], "]"}], "->", "c"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"Length", "[", "cl", "]"}]}], "}"}]}], "]"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clAt", "[", 
    RowBox[{"n_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"FindClusters", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Normalize", " ", "/@", " ", 
          RowBox[{"vF", "[", "n", "]"}]}], ")"}], "->", "lab"}], ",", "k", ",", 
       RowBox[{"DistanceFunction", "->", "CosineDistance"}], ",", 
       RowBox[{"Method", "->", "\"\<KMedoids\>\""}], ",", 
       RowBox[{"RandomSeeding", "->", "1234"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Length", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ari", "[", 
    RowBox[{"c1_", ",", "c2_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a1", "=", 
        RowBox[{"assign", "[", "c1", "]"}]}], ",", 
       RowBox[{"a2", "=", 
        RowBox[{"assign", "[", "c2", "]"}]}], ",", "nij", ",", "ai", ",", 
       "bj", ",", "comb2", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"comb2", "[", "x_", "]"}], ":=", 
       RowBox[{"x", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", "1"}], ")"}], "/", "2"}]}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"nij", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"comb2", " ", "/@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"Counts", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a1", "[", "r", "]"}], ",", 
               RowBox[{"a2", "[", "r", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "lab"}], "}"}]}], "]"}], "]"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "   ", 
      RowBox[{"ai", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"comb2", " ", "/@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"Counts", "[", 
           RowBox[{"Values", "[", "a1", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
      " ", 
      RowBox[{"bj", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"comb2", " ", "/@", " ", 
         RowBox[{"Values", "[", 
          RowBox[{"Counts", "[", 
           RowBox[{"Values", "[", "a2", "]"}], "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"t", "=", 
       RowBox[{"ai", " ", 
        RowBox[{"bj", "/", 
         RowBox[{"comb2", "[", 
          RowBox[{"Length", "[", "lab", "]"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"nij", "-", "t"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"ai", "+", "bj"}], ")"}], "/", "2"}], "-", "t"}], ")"}]}],
        "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", 
     RowBox[{"ari", "[", 
      RowBox[{"clK4", ",", 
       RowBox[{"clAt", "[", 
        RowBox[{"n", ",", "4"}], "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"10", ",", "24"}], "]"}], ",", 
       RowBox[{"{", "12", "}"}]}], "]"}]}], "}"}]}], "]"}]}], "Input",Expressi\
onUUID->"f5c3487b-360b-4d21-9641-f6908b8b9c10"],


9a0c-b093c8fe686e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Las", " ", "cinco", " ", "reglas", " ", "m\[AAcute]s", " ", "cercanas", " ",
      "a", " ", "la", " ", "0", " ", "con", " ", "n"}], " ", "=", " ", "12"}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"M", "=", 
      RowBox[{

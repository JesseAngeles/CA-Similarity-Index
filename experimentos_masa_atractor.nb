     RowBox[{"Range", "[", "29", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"idRate", "[", 
    RowBox[{"v_", ",", "n_", ",", "n2_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
